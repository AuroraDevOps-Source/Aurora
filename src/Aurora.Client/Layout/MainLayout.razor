@inherits LayoutComponentBase
@inject HttpClient Api
@inject NavigationManager Navigation

<MudThemeProvider Theme="AuroraTheme.Hub" IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <AuthorizeView>
        <Authorized>
            <MudAppBar Elevation="0" Fixed="true" Class="aurora-appbar">
                <MudText Typo="Typo.h6" Class="aurora-brand"><span class="aurora-mark" aria-hidden="true"></span>Aurora</MudText>

                <MudText Typo="Typo.body2" Class="aurora-user ml-auto">@context.User.Identity?.Name</MudText>
                @if(_isAdmin || _canViewLog)
                {
                <MudMenu Icon="@Icons.Material.Filled.Settings" aria-label="Admin" Color="Color.Inherit" Size="Size.Small" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    @if (_isAdmin)
                    {
                    <MudMenuItem Icon="@Icons.Material.Outlined.People" OnClick="@(() => Navigation.NavigateTo("/aurora/users"))">Users</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Outlined.Storage" OnClick="@(() => Navigation.NavigateTo("/aurora/databases"))">Databases</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Outlined.LocalShipping" OnClick="@(() => Navigation.NavigateTo("/aurora/ship-status"))">Ship Status</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Outlined.RestartAlt" OnClick="@(() => Navigation.NavigateTo("/aurora/reset"))">Reset</MudMenuItem>
                    }
                    @if (_canViewLog) { <MudMenuItem Icon="@Icons.Material.Outlined.History" OnClick="@(() => Navigation.NavigateTo("/aurora/applog"))">Application Log</MudMenuItem> }
                </MudMenu>
                }
            </MudAppBar>
        </Authorized>
    </AuthorizeView>

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _isAdmin, _canViewLog;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            _isAdmin = _canViewLog = false;
            return;
        }

        // Use the authenticated identity while checking current access. A transport
        // failure must not hide navigation; successful responses still reflect demotions.
        // Every destination/API continues to enforce its own authorization.
        _isAdmin = user.IsInRole("aurora:Admin");
        _canViewLog = _isAdmin || user.IsInRole("aurora:PowerUser");
        try { _isAdmin = await Api.GetFromJsonAsync<bool>("api/v1/me/is-administrator"); }
        catch (HttpRequestException) { }
        catch (TaskCanceledException) { }
        try { _canViewLog = await Api.GetFromJsonAsync<bool>("api/v1/me/can-view-applog"); }
        catch (HttpRequestException) { }
        catch (TaskCanceledException) { }
    }
}
