@inherits LayoutComponentBase
@inject HttpClient Api
@inject NavigationManager Navigation

<MudThemeProvider Theme="AuroraTheme.Hub" IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <AuthorizeView>
        <Authorized>
            <MudAppBar Elevation="0" Fixed="true" Class="aurora-appbar">
                <MudText Typo="Typo.h6" Class="aurora-brand"><span class="aurora-mark" aria-hidden="true"></span>Aurora</MudText>

                <MudText Typo="Typo.body2" Class="aurora-user ml-auto">@context.User.Identity?.Name</MudText>
                @if(_isAdmin)
                {
                <MudMenu Icon="@Icons.Material.Filled.Settings" aria-label="Admin" Color="Color.Inherit" Size="Size.Small" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MudMenuItem OnClick="@(() => Navigation.NavigateTo("/aurora/users"))">Users</MudMenuItem>
                    <MudMenuItem OnClick="@(() => Navigation.NavigateTo("/aurora/ship-status"))">Ship Status</MudMenuItem>
                    <MudMenuItem OnClick="@(() => Navigation.NavigateTo("/aurora/import"))">Import</MudMenuItem>
                </MudMenu>
                }
            </MudAppBar>
        </Authorized>
    </AuthorizeView>

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _isAdmin;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        // The login page shares this layout, so check access only when signed in.
        if (AuthState is null || (await AuthState).User.Identity?.IsAuthenticated != true)
        {
            _isAdmin = false;
            return;
        }

        try { _isAdmin = await Api.GetFromJsonAsync<bool>("api/v1/me/is-administrator"); }
        catch { _isAdmin = false; }
    }
}
