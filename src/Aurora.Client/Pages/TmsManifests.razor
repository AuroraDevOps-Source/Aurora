@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

@if(_error is not null){<p class="alert" role="alert">@_error</p>}

@if(_message is not null){<p role="status">@_message</p>}

@if (!IsScreen)
{
<section class="planning-card">

<div class="tms-filters"><label class="field">From date<InputDate @bind-Value="_from" /></label><label class="field">To date<InputDate @bind-Value="_to" /></label><label class="field">Status<select @bind="_status"><option value="">All statuses</option>@foreach(var s in TmsManifest.Statuses){<option>@s</option>}</select></label><label class="field">Search<input @bind="_search" placeholder="Manifest, truck, carrier, bill to" /></label><button class="outline-button" @onclick="Load" disabled="@(_busy || _editing)">Apply filters / Refresh</button><button class="text-button" @onclick="Clear" disabled="@(_busy || _editing)">Clear filters</button></div>

<div class="tms-selection"><strong>@Visible.Count() manifests</strong><button class="primary-button" @onclick="New" disabled="@(_editing || _busy)">Add manifest</button></div>

<div class="manifest-table-wrap tms-crud-grid"><table class="manifest-table"><thead><tr><th>Manifest</th><th>Date</th><th>Status</th><th>Truck</th><th>Carrier</th><th>Driver</th><th>Orders</th></tr></thead><tbody>

@foreach(var row in Visible){<tr><td><button class="text-button" @onclick="()=>Open(row)" disabled="@(_editing || _busy)">@row.Number</button></td><td>@row.ManifestDate.ToString("MMM d, yyyy")</td><td><span class="status-badge status-@(row.Status.Replace(" ", "").ToLowerInvariant())">@row.Status</span></td><td>@row.Vehicle</td><td>@row.Details.Carrier</td><td>@row.Details.Driver</td><td>@row.OrderCount</td></tr>}

</tbody></table></div>@if(!Visible.Any()){<p>No manifests match these filters.</p>}

</section>
}

@if (IsScreen) { <div class="manifest-screen-nav"><button class="text-button" disabled="@_busy" @onclick="Back">← Back to manifests</button></div> }
@if (IsScreen && _selected is null && _busy) { <p role="status">Loading manifest…</p> }
@if(_selected is {} m){<section class="planning-card manifest-screen">
<div class="tms-selection"><div class="manifest-screen-title"><h2>@(_new?"Add manifest":"Manifest · "+m.Number)</h2>@if(!_new){<span class="status-badge status-@(m.Status.Replace(" ", "").ToLowerInvariant())">@m.Status</span>}</div>@if(!_new && !_editing){<button class="outline-button" @onclick="EditDetails" disabled="@_busy">Edit manifest</button><button class="text-button" @onclick="()=>_delete=true" disabled="@(!m.Editable || _busy)">Delete manifest</button>}</div>
@if(_delete){<div class="terminal-delete" role="alert"><span>Delete this manifest and return its orders to Ready to Ship?</span><button class="primary-button" disabled="@_busy" @onclick="Delete">Confirm delete</button><button class="outline-button" @onclick="()=>_delete=false">Cancel</button></div>}

<div class="planner-tabs" role="tablist" aria-label="Manifest sections">
<button id="manifest-tab-details" role="tab" aria-selected="@(_tab==ManifestTab.Details ? "true" : "false")" aria-controls="manifest-tab-panel" class="@(_tab==ManifestTab.Details ? "active" : null)" @onclick="()=>ShowTab(ManifestTab.Details)">Details</button>
<button id="manifest-tab-orders" role="tab" aria-selected="@(_tab==ManifestTab.Orders ? "true" : "false")" aria-controls="manifest-tab-panel" class="@(_tab==ManifestTab.Orders ? "active" : null)" disabled="@_new" title="@(_new ? "Save the manifest before adding orders." : null)" @onclick="()=>ShowTab(ManifestTab.Orders)">Orders <span class="count-pill">@_orders.Count</span></button>
</div>
<div id="manifest-tab-panel" role="tabpanel" aria-labelledby="@(_tab==ManifestTab.Details ? "manifest-tab-details" : "manifest-tab-orders")">
@if(_tab==ManifestTab.Details){
@if(_editing && _edit is {} e){<div class="manifest-screen-editor"><fieldset disabled="@_busy" class="tms-edit-fields"><div class="manifest-edit-grid">

<label class="field">Manifest number<input @bind="e.Number" maxlength="100" /></label><label class="field">Manifest date<InputDate @bind-Value="e.ManifestDate" /></label><label class="field">Status<select @bind="e.Status" disabled="@_new">@foreach(var s in TmsManifest.Statuses){<option>@s</option>}</select></label>

<label class="field">Truck<select @bind="e.Vehicle"><option value="">Unassigned</option>@if(!string.IsNullOrWhiteSpace(e.Vehicle) && !_trucks.Contains(e.Vehicle)){<option value="@e.Vehicle">@e.Vehicle (current)</option>}@foreach(var v in _trucks){<option value="@v">@v</option>}</select></label>

<label class="field">Trailer<input @bind="e.Details.Trailer" maxlength="200" /></label><label class="field">Driver<input @bind="e.Details.Driver" maxlength="200" /></label><label class="field">Carrier<input @bind="e.Details.Carrier" maxlength="200" /></label><label class="field">Bill-to code<input @bind="e.Details.BillToCode" maxlength="200" /></label><label class="field">Bill-to name<input @bind="e.Details.BillToName" maxlength="200" /></label><label class="field">Origin terminal<input @bind="e.Details.OriginTerminal" maxlength="200" /></label><label class="field">Destination terminal<input @bind="e.Details.DestinationTerminal" maxlength="200" /></label><label class="field">Direction<select @bind="e.Details.Direction"><option>Outbound</option><option>Inbound</option></select></label><label class="field manifest-notes">Notes<textarea @bind="e.Details.Notes" maxlength="4000" rows="2"></textarea></label>

</div><div class="manifest-edit-actions"><button class="primary-button" @onclick="Save">Save manifest</button><button class="outline-button" @onclick="Cancel">Cancel</button></div></fieldset></div>}
else {<dl class="manifest-facts">
<div><dt>Date</dt><dd>@m.ManifestDate.ToString("MMM d, yyyy")</dd></div><div><dt>Truck</dt><dd>@Show(m.Vehicle)</dd></div><div><dt>Trailer</dt><dd>@Show(m.Details.Trailer)</dd></div><div><dt>Driver</dt><dd>@Show(m.Details.Driver)</dd></div>
<div><dt>Carrier</dt><dd>@Show(m.Details.Carrier)</dd></div><div><dt>Bill to</dt><dd>@Show($"{m.Details.BillToCode} {m.Details.BillToName}")</dd></div><div><dt>Direction</dt><dd>@Show(m.Details.Direction)</dd></div><div><dt>Terminals</dt><dd>@Show(m.Details.OriginTerminal) → @Show(m.Details.DestinationTerminal)</dd></div>
@if(!string.IsNullOrWhiteSpace(m.Details.Notes)){<div class="manifest-facts-notes"><dt>Notes</dt><dd>@m.Details.Notes</dd></div>}
</dl>}
}
else {<div class="manifest-orders @(_route is not null ? "with-map" : null)"><div class="manifest-orders-list">
<div class="tms-selection"><strong>@_orders.Count orders · @_orders.Sum(o=>o.Pieces).ToString("N0") pieces · @_orders.Sum(o=>o.Weight).ToString("N0") lb</strong><button class="outline-button" @onclick="OpenPicker" disabled="@(!m.Editable || _busy)">Add orders</button></div>
@if(!m.Editable){<p class="preview-footnote">Order assignments are locked after dispatch.</p>}
@if(_route is not null && !RouteMatchesOrders){<p class="planning-warning">Orders changed after route optimization. The map shows the optimized route.</p>}
<div class="manifest-table-wrap tms-crud-grid"><table class="manifest-table"><thead><tr>@if(_route is not null){<th>Stop</th>}<th>PRO</th><th>Customer / destination</th><th>Pieces</th><th>Weight (lb)</th><th>Status</th><th></th></tr></thead><tbody>
@foreach(var o in OrdersInStopOrder){<tr>@if(_route is not null){<td>@if(StopNumber(o.Id) is {} stop){<span class="table-stop" style="border-color:@RouteColor">@stop</span>}else{<span>—</span>}</td>}<td>@o.Id</td><td><strong>@o.Customer</strong><small>@Destination(o)</small></td><td>@o.Pieces</td><td>@o.Weight</td><td><span class="status-badge status-@(o.Status.ToLowerInvariant())">@WorkspaceOrderStatus.Label(o.Status)</span></td><td><button class="text-button" @onclick="()=>Remove(o)" disabled="@(!m.Editable || _busy)">Remove</button></td></tr>}
@if(_orders.Count==0){<tr><td colspan="@(_route is null ? 6 : 7)">No orders on this manifest yet.</td></tr>}
</tbody></table></div>
@if(_picker){<div class="tms-picker"><h3>Add Ready to Ship orders</h3><label class="field">Search orders<input @bind="_orderSearch" @bind:event="oninput" placeholder="PRO, customer, city" /></label><div class="manifest-table-wrap tms-crud-grid" style="max-height:300px;overflow:auto"><table class="manifest-table"><thead><tr><th>Select</th><th>PRO</th><th>Customer</th><th>Scheduled</th><th>City</th></tr></thead><tbody>@foreach(var o in Candidates){var key=new TmsOrderKey(o.SourceId,o.Id);<tr><td><input type="checkbox" aria-label="@("Select "+o.Id)" checked="@_picked.Contains(key)" @onchange="args=>Pick(key,args.Value is true)" /></td><td>@o.Id</td><td>@o.Customer</td><td>@o.ScheduledAt.ToLocalTime().ToString("MMM d, yyyy")</td><td>@o.City</td></tr>}</tbody></table></div><button class="primary-button" disabled="@(_busy || _picked.Count==0)" @onclick="Add">Add selected (@_picked.Count)</button><button class="outline-button" @onclick="()=>_picker=false">Cancel</button></div>}
</div>
@if(_route is {} saved){<div class="planning-card manifest-map-panel"><div id="manifest-map" class="manifest-map" aria-label="Optimized route for @saved.Route.Vehicle"></div><div class="planning-map-caption"><span>Optimized route · @saved.Route.ManifestStops stops · @saved.Route.Kilometers.ToString("N0") km (@((saved.Route.Kilometers*0.621371).ToString("N0")) mi) · @Duration(saved.Route.EstimatedSeconds)</span><span>Optimized @saved.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</span></div></div>}
</div>}
</div>
</section>}

@code {
 [Parameter] public Guid? ManifestId {get;set;}
 [Parameter] public bool NewManifest {get;set;}
 bool IsScreen=>NewManifest || ManifestId is not null;
 string? _loadedScreen;
 void Back()=>Navigation.NavigateTo("/aurora/manifests");

 enum ManifestTab { Details, Orders }
 ManifestTab _tab;
 // Present only for manifests created by route optimization; it holds the optimized stop sequence.
 SavedManifestDto? _route;
 bool _renderMap,_mapShown;
 const string RouteColor="#2363eb";
 bool RouteMatchesOrders=>_route is not null && _route.Route.Pros.Select(p=>p.ProNumber).ToHashSet().SetEquals(_orders.Select(o=>o.Id));
 IEnumerable<TmsOrder> OrdersInStopOrder=>_route is null ? _orders : _orders.OrderBy(o=>StopNumber(o.Id) ?? int.MaxValue);
 int? StopNumber(string id)=>_route?.Route.Pros.FirstOrDefault(p=>p.ProNumber==id)?.StopNumber;
 static string Destination(TmsOrder o)=>string.Join(", ",new[]{o.Address,$"{o.City} {o.State} {o.PostalCode}".Trim()}.Where(s=>!string.IsNullOrWhiteSpace(s)));
 static string Show(string? value)=>string.IsNullOrWhiteSpace(value) ? "—" : value.Trim();
 static string Duration(int seconds)=>$"{seconds/3600}h {seconds%3600/60:00}m";
 static string StopTime(DateTimeOffset? value)=>value?.ToString("MMM d h:mm tt") ?? "Not provided";
 async Task ShowTab(ManifestTab tab){if(_tab==tab)return;await DisposeMap();_tab=tab;_renderMap=tab==ManifestTab.Orders && _route is not null;}
 async Task EditDetails(){await ShowTab(ManifestTab.Details);BeginEdit();}
 async Task LoadRoute(){using var r=await Http.GetAsync($"api/v1/aurora/manifests/{_selected!.Id}");if(r.StatusCode==System.Net.HttpStatusCode.NotFound){_route=null;return;}await Check(r);_route=await r.Content.ReadFromJsonAsync<SavedManifestDto>();}
 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if(!_renderMap || _route is null || _tab!=ManifestTab.Orders)return;
  _renderMap=false;_mapShown=true;
  await JS.InvokeVoidAsync("routeMap.render","manifest-map",new{routes=new[]{new{vehicle=_route.Route.Vehicle,color=RouteColor,stops=_route.Route.RouteStops.Select(s=>new{lat=s.Latitude,lon=s.Longitude,s.LocationId,s.IsDepot,s.OrderIds,arrival=StopTime(s.Arrival),departure=StopTime(s.Departure)})}},dropped=Array.Empty<object>()});
 }
 async Task DisposeMap(){if(!_mapShown)return;_mapShown=false;try{await JS.InvokeVoidAsync("routeMap.dispose");}catch(JSDisconnectedException){}}
 public async ValueTask DisposeAsync()=>await DisposeMap();
 void Open(TmsManifest manifest)=>Navigation.NavigateTo($"/aurora/manifests/{manifest.Id}");


 List<TmsManifest> _manifests=[];List<TmsOrder> _orders=[],_available=[];List<string> _trucks=[];

 TmsManifest? _selected,_edit;bool _busy,_editing,_new,_delete,_picker;string? _error,_message;string _status="",_search="",_orderSearch="";HashSet<TmsOrderKey> _picked=[];

 DateOnly? _from=new DateOnly(DateTime.Today.Year,DateTime.Today.Month,1),_to=DateOnly.FromDateTime(DateTime.Today);

 IEnumerable<TmsManifest> Visible=>_manifests.Where(m=>(_from is null || m.ManifestDate>=_from) && (_to is null || m.ManifestDate<=_to) && (_status=="" || m.Status==_status) && string.Join(" ",m.Number,m.Vehicle,m.Details.Carrier,m.Details.BillToName,m.Details.BillToCode).Contains(_search,StringComparison.OrdinalIgnoreCase));

 IEnumerable<TmsOrder> Candidates=>_available.Where(o=>string.Join(" ",o.Id,o.Customer,o.City).Contains(_orderSearch,StringComparison.OrdinalIgnoreCase));

 protected override async Task OnParametersSetAsync()
 {
  var key=NewManifest ? "new" : ManifestId?.ToString() ?? "list";
  if(_loadedScreen==key)return;
  _loadedScreen=key;await DisposeMap();_selected=_edit=null;_new=_editing=_delete=_picker=false;_message=null;_orders=[];_route=null;_tab=ManifestTab.Details;
  await Load();
  if(!IsScreen)return;
  await Run(async()=>{_trucks=(await Http.GetFromJsonAsync<EquipmentCatalogDto>("api/v1/routing/equipment"))?.Units.Select(u=>u.Id).ToList()??[];});
  if(NewManifest){_selected=new(){Number="MAN-"+Guid.NewGuid().ToString("N")[..10].ToUpperInvariant()};_new=true;BeginEdit();}
  else if(_manifests.FirstOrDefault(m=>m.Id==ManifestId) is {} manifest){await Select(manifest);await Run(LoadRoute);BeginEdit();}
  else {_error ??= "Manifest not found. Return to the manifest list and refresh.";}
 }


 async Task Run(Func<Task> action){if(_busy)return;_busy=true;_error=null;try{await action();}catch(Exception ex){_error=ex.Message;}finally{_busy=false;}}

 async Task Check(HttpResponseMessage r){if(!r.IsSuccessStatusCode)throw new FormatException((await r.Content.ReadFromJsonAsync<ApiErrorDto>())?.Error??"Request failed.");}

 async Task Load()=>await Run(async()=>{_manifests=await Http.GetFromJsonAsync<List<TmsManifest>>("api/v1/tms/manifests")??[];if(_selected is {} old){_selected=_manifests.FirstOrDefault(m=>m.Id==old.Id);if(_selected is not null)await LoadOrders();}});

 async Task Clear(){_from=null;_to=null;_status="";_search="";await Load();}

 async Task Select(TmsManifest m){_selected=m;_new=false;_delete=false;_picker=false;_message=null;await Run(LoadOrders);}

 async Task LoadOrders(){_orders=await Http.GetFromJsonAsync<List<TmsOrder>>($"api/v1/tms/orders?manifest={_selected!.Id}")??[];}

 void New()=>Navigation.NavigateTo("/aurora/manifests/new");

 void BeginEdit(){_edit=System.Text.Json.JsonSerializer.Deserialize<TmsManifest>(System.Text.Json.JsonSerializer.Serialize(_selected));_editing=true;_picker=false;_delete=false;_message=null;}

 void Cancel(){if(_new){Back();return;}_editing=false;_edit=null;_error=null;}

 async Task Save(){var wasNew=_new;Guid? id=null;await Run(async()=>{_edit!.Validate();using var r=_new?await Http.PostAsJsonAsync("api/v1/tms/manifests",_edit):await Http.PutAsJsonAsync("api/v1/tms/manifests",_edit);await Check(r);id=_new?(await r.Content.ReadFromJsonAsync<TmsManifest>())!.Id:_edit.Id;_editing=false;_new=false;_message="Manifest saved.";});if(id is {} saved){await Load();var m=_manifests.First(x=>x.Id==saved);await Select(m);_message="Manifest saved.";if(wasNew){_loadedScreen=saved.ToString();Navigation.NavigateTo($"/aurora/manifests/{saved}");}}}

 async Task Delete(){await Run(async()=>{using var r=await Http.DeleteAsync($"api/v1/tms/manifests/{_selected!.Id}?revision={_selected.Revision}");await Check(r);_selected=null;_delete=false;_message="Manifest deleted. Its orders are Ready to Ship.";});if(_selected is null){if(IsScreen)Back();else await Load();}}

 async Task OpenPicker()=>await Run(async()=>{_available=(await Http.GetFromJsonAsync<List<TmsOrder>>("api/v1/tms/orders?status=ReadyToRoute")??[]).Where(o=>o.ManifestId is null).ToList();_picked.Clear();_orderSearch="";_picker=true;});

 void Pick(TmsOrderKey key,bool value){if(value)_picked.Add(key);else _picked.Remove(key);}

 async Task Add()=>await Membership(_picked.ToArray(),false);

 async Task Remove(TmsOrder o)=>await Membership([new(o.SourceId,o.Id)],true);

 async Task Membership(TmsOrderKey[] keys,bool remove){var ok=false;await Run(async()=>{using var r=await Http.PostAsJsonAsync($"api/v1/tms/manifests/{_selected!.Id}/"+(remove?"remove-orders":"orders"),new TmsAssignmentChange(keys,_selected.Revision));await Check(r);_picker=false;_message=remove?"Order removed and returned to Ready to Ship.":"Orders added and marked Routed.";ok=true;});if(ok){await Load();if(_edit is not null && _selected is not null)_edit.Revision=_selected.Revision;}}

}