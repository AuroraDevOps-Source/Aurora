@page "/routing"
@attribute [Authorize]
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IDisposable
@using System.Globalization
@using System.Text

<PageTitle>Route Optimization - Aurora</PageTitle>

<section class="planner-page @(_step <= 3 ? "compact-setup" : "")">
    <header class="planner-header">
        <div><span class="eyebrow">DAILY DELIVERY PLANNING</span><h1>Plan your deliveries</h1><p>Confirm the day's work, review exceptions, and find a plan that fits.</p></div>
        <div class="planner-header-actions"><button class="text-button" @onclick="() => _equipmentOpen = true" disabled="@IsWorking">Equipment catalog</button>
        @if (_result is not null && WorkspaceDraftId is null) { <button class="outline-button" @onclick="StartOver" disabled="@IsWorking">New plan</button> }</div>
    </header>
    @if (_workspaceFinished) { <div class="finish-notice" role="status"><strong>Manifests saved.</strong> The scheduled orders are now Routed. Orders unassigned remain Ready to Ship. <a href="/aurora/manifests" target="_blank">View manifests</a>. You can close this wizard.</div> }
    <nav class="planner-steps" aria-label="Planning steps">
        @foreach (var item in new[] { (1, "Trucks"), (2, "Appointments"), (3, "Optimize"), (4, "Review") })
        {
            <button class="@(_step == item.Item1 ? "active" : "")" aria-current="@(_step == item.Item1 ? "step" : null)"
                disabled="@(IsWorking || item.Item1 == 4 && _completedSessionId is null || item.Item1 > 1 && _sourceJson is null)"
                @onclick="() => GoToStep(item.Item1)"><span>@item.Item1</span>@item.Item2</button>
        }
    </nav>
    @if (!string.IsNullOrWhiteSpace(_error)) { <div class="alert planner-alert" role="alert">@_error</div> }
@if (_step != 4 || _result is null)
{
    @if (_step == 1)
    {
        <div class="wizard-columns @(WorkspaceDraftId is not null ? "fleet-only" : "")">
            @if (WorkspaceDraftId is null)
            {
            <section class="planning-card">
                <span class="eyebrow">THE DAY'S WORK</span><h2>Delivery orders</h2>
                @if (WorkspaceDraftId is not null) { <p class="planning-description">These are the orders selected in Aurora. Close this window and return to Orders to change the selection.</p> }
                else
                {
                <p class="planning-description">Import your delivery file. Existing appointments, service times, and truck settings come with it.</p>
                <div class="planner-file">
                    <InputFile id="manifest-file" OnChange="SelectFile" accept=".json,application/json" disabled="@IsWorking" aria-label="Import delivery orders" />
                    <div class="planner-file-content" aria-hidden="true"><strong>@(_loadingFile ? "Reading file..." : _sourceJson is null ? "Import orders" : "Replace order file")</strong><span>Drop a JSON file here or browse</span></div>
                </div>
                <p class="file-format">JSON delivery request · Up to 25 MB</p>
                }
                @if (_draft is not null) { <div class="loaded-source"><span class="loaded-check">✓</span><div><strong>@_sourceName</strong><small>@_draft.Terminal · @_draft.Orders orders · @_draft.Windows time windows</small></div></div> }
                @if (WorkspaceDraftId is null) {
                <details class="wizard-advanced"><summary>Sample data & downloads</summary><button class="text-button" @onclick="LoadAppointmentSample" disabled="@IsWorking">Load demo orders</button><button class="text-button" @onclick="DownloadRequest" disabled="@(_sourceJson is null)">Download plan inputs</button></details>
                }
            </section>
            }
            <section class="planning-card setup-card">
                <h2>Trucks <small>@_draft?.Orders orders selected</small></h2>
                <p class="planning-description">Select available trucks. Click a row to edit today’s hours.</p>
                @if (_sourceJson is not null)
                {
                    <PlanFleetAvailability SourceJson="@_sourceJson" OnApply="ApplyFleet" />
                    @if (WorkspaceDraftId is null) { <details class="wizard-advanced"><summary>Equipment & scenario settings</summary><p>For unusual changes to capacity, equipment types, or operating costs.</p><button class="outline-button" @onclick="OpenInitialSettings">Open detailed settings</button></details> }

                }
                else { <div class="empty-state compact">Import orders to review the available trucks.</div> }
            </section>
        </div>
        <div class="wizard-footer"><span>Confirm truck availability and working hours.</span><button class="primary-button" disabled="@(!CanOptimize)" @onclick="() => GoToStep(2)">Continue to appointments →</button></div>
    }
    else if (_step == 2)
    {
        <section class="planning-card wizard-main setup-card">
            <h2>Appointments <small>@_draft?.Orders orders</small></h2>
            <p>Click an order to edit its appointment or service time.</p>

            <PlanAppointments IsOpen="true" Inline="true" SourceJson="@_sourceJson" OnApply="ApplyAppointments" />
            <details class="wizard-advanced"><summary>Import appointments from CSV</summary><button class="outline-button" @onclick="DownloadAppointmentTemplate">Download template</button><label class="outline-button planner-csv">Import appointment CSV<InputFile OnChange="ImportAppointments" accept=".csv,text/csv" disabled="@IsWorking" /></label></details>
        </section>
        <div class="wizard-footer"><button class="outline-button" @onclick="() => GoToStep(1)">← Trucks</button><button class="primary-button" disabled="@(!CanOptimize)" @onclick="() => Optimize()">Continue to optimization →</button></div>
    }
    else
    {
        <section class="planning-card wizard-main optimization-monitor">
            <span class="eyebrow">FIND THE BEST PLAN</span><h2>@(_sessionId is not null ? "Monitoring your plan" : _session?.Status == "SUCCEEDED" ? "Your routes are ready" : "Ready to optimize")</h2>
            <p>@_draft?.Orders orders · @_draft?.Trucks available trucks · @_draft?.Windows scheduling windows</p>
            @if (_sessionId is null && _session?.Status == "SUCCEEDED" && _result is not null)
            {
                <div class="monitor-status" role="status"><strong>Optimization complete</strong><span>@Math.Floor(_session.ElapsedSeconds) seconds elapsed</span></div>
                <p>@_result.Summary?.Scheduled orders scheduled across @_result.Routes.Count routes. @(_result.Summary?.Unscheduled ?? 0) orders remain Ready to Ship.</p>
                <button class="primary-button" @onclick="() => GoToStep(4)">Review routes →</button>
            }
            else if (_sessionId is null)
            {
                <p>Watch coverage and cost as PTV works. Stop and review when the plan is good enough, or let the 60-second search finish. Preparing travel times may take additional time.</p>
                @if (CanQuickUpdate)
                {
                    <label class="switch-row reuse-notice"><input type="checkbox" @bind="_reusePrevious" /><span></span>Use previous routes as a starting point</label>
                    <label class="switch-row"><input type="checkbox" @bind="_keepAssignments" disabled="@(!_reusePrevious)" /><span></span>Keep existing orders on their assigned trucks</label>
                    <p class="preview-footnote">For staged or loading freight. Stop order may change; new orders may be added. Protected orders may remain unscheduled if their truck cannot serve them.</p>
                }
                <p>Return to Appointments and choose Continue to optimization to start a new run.</p>
            }
            else
            {
                <div class="monitor-status" role="status"><span class="spinner" aria-hidden="true"></span><strong>@_busyLabel</strong><span>@Math.Floor(_session?.ElapsedSeconds ?? 0) seconds elapsed</span></div>
                @if (_session?.Samples.Count > 0)
                {
                    <div class="manifest-table-wrap"><table class="manifest-table"><caption>Recent progress · Best plan found so far</caption><thead><tr><th>Sample</th><th>Scheduled</th><th>Unassigned</th><th>Trucks</th><th>Estimated cost</th></tr></thead><tbody>
                    @foreach (var sample in _session.Samples.TakeLast(6)) { <tr><td>@sample.Time.ToLocalTime().ToString("h:mm:ss tt")</td><td>@sample.Scheduled</td><td>@sample.Unscheduled</td><td>@sample.Routes</td><td>@(sample.Cost?.ToString("C0") ?? "—")</td></tr> }
                    </tbody></table></div>
                    <p class="preview-footnote">Progress is provisional. Compare scheduled orders as well as estimated cost.</p>
                }
                else { <div class="empty-state compact">Waiting for the first solution. PTV may still be preparing travel times.</div> }
                @if (_session?.Warning is not null) { <p class="alert" role="status">@_session.Warning</p> }
                <div class="monitor-actions"><button class="primary-button" @onclick="StopPlanning" disabled="@(_stopping || _session?.Status is "STOPPING" or "SUBMITTING")">@(_stopping || _session?.Status == "STOPPING" ? "Stopping · retrieving best plan..." : "Stop and review best plan")</button>
                @if (!_busy) { <button class="outline-button" @onclick="ResumePlanning">Reconnect to this plan</button> }</div>
                <p class="preview-footnote">Updates approximately every five seconds. Refresh this tab to reconnect. Input changes require a new run.</p>
            }
        </section>
        @if (_sessionId is null) { <div class="wizard-footer"><button class="outline-button" @onclick="() => GoToStep(2)">← Appointments</button><span>Maps and manifests appear after the run completes or stops.</span></div> }
    }
}

else
{
    <section class="results-page">
        <div class="results-heading">
            <div>
                <h2>Review routes</h2>
                <p>@_result.Routes.Count truck routes · @_result.OptimizedAt.ToLocalTime().ToString("MMM d, h:mm tt")</p>
            </div>
            <div class="result-actions">
                @if (WorkspaceDraftId is not null && !_workspaceFinished) { <button class="primary-button" @onclick="FinishWorkspace" disabled="@(IsWorking || _savingManifest || _completedSessionId is null || _result.Summary?.Scheduled is not > 0)">@(_savingManifest ? "Saving manifests…" : "Finish · Create manifests")</button> }
            </div>
        </div>

        @if (_result.DroppedOrders.Count > 0)
        {
            <details class="unassigned-orders"><summary>@_result.DroppedOrders.Count orders remain Ready to Ship · Review unassigned orders</summary>
                <table class="manifest-table"><thead><tr><th>PRO</th><th>Destination</th><th>Reason</th></tr></thead><tbody>
                @foreach (var order in _result.DroppedOrders) { <tr><td>@order.OrderId</td><td>@order.ShipToName</td><td>@order.Reason</td></tr> }
                </tbody></table>
            </details>
        }
        <div class="route-picker" aria-label="Truck routes">
        @foreach (var route in _result.Routes)
        {
            <button class="@(_selectedVehicle == route.Vehicle ? "active" : "")" aria-pressed="@(_selectedVehicle == route.Vehicle)" @onclick="() => SelectManifest(route.Vehicle)"><strong>@route.Vehicle</strong><span>@route.ManifestStops stops · @Duration(route.EstimatedSeconds) · @((route.Kilometers * 0.621371).ToString("N0")) mi</span></button>
        }
        </div>
        @if (!string.IsNullOrWhiteSpace(_result.SummaryError))
        {
            <div class="alert">PTV returned a result, but its summary could not be read: @_result.SummaryError</div>
        }
        @if (_result.Summary is { Violations: > 0 })
        {
            <div class="alert" role="alert">PTV reported constraint violations. Review the route and appointment constraints before using this schedule.</div>
        }

        <div class="workspace-grid route-review">
            <article class="content-panel">
                    <div class="panel-body">
                        <div class="section-title"><div><span>@_selectedVehicle</span><h2>View route</h2></div></div>
                        @if (_result.Routes.Count == 0)
                        {
                            <div class="empty-state compact">No routes were returned.</div>
                        }
                        @foreach (var route in _result.Routes.Where(r => r.Vehicle == _selectedVehicle))
                        {
                            var color = RouteColor(_result.Routes.ToList().IndexOf(route));
                            var costPerStop = route.ManifestStops > 0 ? (route.Cost / route.ManifestStops).ToString("C2") : "N/A";
                            <details class="route-card @(_selectedVehicle == route.Vehicle ? "map-selected" : "")" open="true" @key="route.Vehicle">
                                <summary>
                                    <span class="route-swatch" style="background:@color"></span>
                                    <span class="truck-icon">▰</span>
                                    <strong>@route.Vehicle</strong>
                                    <span>@route.Pros.Count PROs</span><span>@route.ManifestStops stops</span><span>@((route.Kilometers * 0.621371).ToString("N0")) mi</span>
                                    <b>@Duration(route.EstimatedSeconds)</b>
                                    <b class="manifest-cost" title="Estimated route cost from configured rates">@route.Cost.ToString("C2")</b>
                                    <b class="manifest-cost" title="Estimated route cost divided by manifest stops">@costPerStop / stop</b>
                                </summary>
                                <div class="manifest-detail">
                                    <div class="manifest-header-grid">
                                        <div><span>Date optimized</span><strong>@_result.OptimizedAt.ToLocalTime().ToString("M/d/yyyy h:mm tt")</strong></div>
                                        <div><span>Terminal</span><strong>@route.Terminal</strong></div>
                                        <div><span>Hours budgeted</span><strong>@Duration(route.BudgetedSeconds)</strong></div>
                                        <div><span>Estimated manifest</span><strong>@Duration(route.EstimatedSeconds)</strong></div>
                                        <div><span>Departure</span><strong>@ScheduleTime(route.Departure)</strong></div>
                                        <div><span>Return</span><strong>@ScheduleTime(route.Return)</strong></div>
                                        <div><span>Distance</span><strong>@((route.Kilometers * 0.621371).ToString("N1")) miles</strong></div>
                                        <div><span>Estimated cost</span><strong>@route.Cost.ToString("C2")</strong></div>
                                    </div>
                                    @if (PreviousRoute(route.Vehicle) is { } previous)
                                    {
                                        <p class="manifest-comparison">Same truck, previous run: @MoneyDelta(route.Cost - previous.Cost) cost · @DistanceDelta(route.Kilometers - previous.Kilometers). Orders may have moved between trucks.</p>
                                    }
                                    <div class="manifest-totals">
                                        <div><span>Stops</span><strong>@route.ManifestStops.ToString("N0")</strong></div>
                                        <div><span>Cost per stop</span><strong>@costPerStop</strong></div>
                                        <div><span>PROs</span><strong>@route.Pros.Count.ToString("N0")</strong></div>
                                        <div><span>Units</span><strong>@Metric(route.Units)</strong></div>
                                        <div><span>Weight</span><strong>@Metric(route.Weight)</strong></div>
                                        <div><span>Cubes</span><strong>@Metric(route.Cubes)</strong></div>
                                    </div>
                                    @if (route.Pros.Count == 0)
                                    {
                                        <div class="empty-state compact">No assigned PRO detail was returned.</div>
                                    }
                                    else
                                    {
                                        <div class="manifest-table-wrap">
                                            <table class="manifest-table">
                                                <thead><tr><th>Stop</th><th>PRO</th><th>Ship to</th><th>Appointment</th><th>Arrival</th><th>Departure</th><th>Units</th><th>Wt.</th><th>Cubes</th><th>Bill type</th><th>Service time</th></tr></thead>
                                                <tbody>
                                                @foreach (var pro in route.Pros.OrderBy(pro => pro.StopNumber).ThenBy(pro => pro.ProNumber))
                                                {
                                                    <tr>
                                                        <td><span class="table-stop" style="border-color:@color">@pro.StopNumber</span></td>
                                                        <td><strong class="pro-number">@pro.ProNumber</strong></td>
                                                        <td><strong>@pro.ShipToName</strong><small>@Address(pro.Address1, pro.City, pro.State, pro.PostalCode)</small></td>
                                                        <td class="appointment-cell"><AppointmentDisplay Appointment="pro.Appointment" /></td>
                                                        <td class="schedule-cell">@ScheduleTime(pro.Arrival)</td>
                                                        <td class="schedule-cell">@ScheduleTime(pro.Departure)</td>
                                                        <td>@Metric(pro.Units)</td>
                                                        <td>@Metric(pro.Weight)</td>
                                                        <td>@Metric(pro.Cubes)</td>
                                                        <td>@pro.BillType</td>
                                                        <td>@StopTime(pro.AllottedStopSeconds)</td>
                                                    </tr>
                                                }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            </details>
                        }
                    </div>
            </article>

            <aside class="map-panel">
                <div class="map-heading"><div><span>MANIFEST MAP</span><h2>Route sequence</h2></div><button title="Fit selected routes" aria-label="Fit selected routes" @onclick="FitMap">⌗</button></div>
                <div class="map-filter">
                    <div class="map-view-toggle" role="group" aria-label="Route view">
                        <button class="@(!_roadMode ? "active" : "")" aria-pressed="@(!_roadMode)" @onclick="() => ChangeMapMode(false)">Bird’s-eye</button>
                        <button class="@(_roadMode ? "active" : "")" aria-pressed="@_roadMode" @onclick="() => ChangeMapMode(true)">Turn-by-turn</button>
                    </div>
                    <p role="status">@(_loadingRoads ? "Loading road routes…" : _roadMode ? "Road-following view · Stop order is unchanged." : "Straight lines show the stop sequence.")</p>
                    @if (_roadError is not null)
                    {
                        <p class="map-data-warning" role="alert">@_roadError</p>
                        <button class="road-retry" @onclick="() => ChangeMapMode(true)">Retry road routes</button>
                    }
                </div>
                <div id="route-map"></div>
                @if (_roadMode)
                {
                    <div class="map-directions">
                        @foreach (var route in _result.Routes.Where(r => _selectedVehicle is null || r.Vehicle == _selectedVehicle))
                        {
                            @if (_roadDirections.TryGetValue(route.Vehicle, out var directions))
                            {
                                <details>
                                    <summary>@route.Vehicle · @directions.Count directions</summary>
                                    @if (directions.Count == 0) { <p>No maneuver instructions were returned for this route.</p> }
                                    <ol>
                                        @foreach (var direction in directions)
                                        {
                                            <li><button @onclick="() => FocusDirection(direction)">@direction.Description</button></li>
                                        }
                                    </ol>
                                </details>
                            }
                        }
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_result.RouteDetailWarning))
                {
                    <div class="map-warning">@_result.RouteDetailWarning</div>
                }
                <div class="map-legend">
                    @for (var i = 0; i < _result.Routes.Count; i++)
                    {
                        var legendRoute = _result.Routes[i];
                        <button class="legend-route @(_selectedVehicle is not null && _selectedVehicle != legendRoute.Vehicle ? "dimmed" : "")" @onclick="() => SelectManifest(legendRoute.Vehicle)"><i style="background:@RouteColor(i)"></i>@legendRoute.Vehicle</button>
                    }
                    @if (_result.DroppedOrders.Any(order => order.Latitude is not null))
                    {
                        <span><i class="dropped-dot"></i>Unassigned</span>
                    }
                </div>
            </aside>
        </div>
    </section>
}
    <p class="planner-scope">Planning workspace · Results are not sent to dispatch automatically.</p>
</section>

<VariationModal IsOpen="_variationOpen" IsRunning="_busy" SourceJson="@_sourceJson"
                CanQuickUpdate="@CanQuickUpdate"
                RunError="@_error"
                IsInitialRun="@(_result is null)" SourceFileName="@_sourceName"
                OnClose="CloseVariation" OnRun="RunVariation" />
<EquipmentCatalog IsOpen="_equipmentOpen" OnClose="() => _equipmentOpen = false" />
<PlanAppointments IsOpen="_appointmentsOpen" SourceJson="@_sourceJson" OnClose="() => _appointmentsOpen = false" OnApply="ApplyAppointments" />

@code {
    private const long MaxFileSize = 25 * 1024 * 1024;
    private readonly string[] _colors = ["#2363eb", "#f59e0b", "#16a078", "#8259d6", "#0e9fbd", "#b8652f", "#64748b", "#a855a1"];
    private IBrowserFile? _file;
    private string? _sourceJson;
    private string _sourceName = "manifest.json";
    private RoutingDraft? _draft;
    private string? _setupMessage;
    private string? _selectedVehicle;
    private OptimizationResultDto? _result;
    private OptimizationResultDto? _previousResult;
    private bool CanQuickUpdate => _previousResult is { Status: "SUCCEEDED", Routes.Count: > 0 };
    private ComparisonSnapshot? _comparison;
    private CancellationTokenSource? _cts;
    private bool _busy;
    private bool _loadingFile;
    private bool _renderMap;
    private bool _roadMode;
    private bool _loadingRoads;
    private string? _roadError;
    private CancellationTokenSource? _roadCts;
    private readonly HashSet<string> _loadedRoads = [];
    private readonly Dictionary<string, List<RoadDirectionDto>> _roadDirections = [];
    private bool _variationOpen;
    private bool _equipmentOpen;
    private bool _appointmentsOpen;

    private void ApplyAppointments(string json) { SetInput(json, _sourceName); _setupMessage = "Appointments updated. Optimize routes to calculate the schedule."; }
    private async Task EditPlan()
    {
        if (IsWorking || _sourceJson is null) return;
        await JS.InvokeVoidAsync("routeMap.dispose");
        _result = null; _comparison = null; _renderMap = false; _step = 1;
        SetInput(_sourceJson, _sourceName);
        _setupMessage = "Edit the schedule, trucks or appointments, then optimize again.";
    }
    private string _busyLabel = "Preparing route calculation…";
    private string? _error;
    private ResultTab _tab = ResultTab.Manifest;

    private enum ResultTab { Manifest, Summary, LeftOff }
    private bool IsWorking => _busy || _loadingFile || _sessionId is not null;
    private bool CanOptimize => !_workspaceFinished && !IsWorking && _draft is { Orders: > 0, Trucks: > 0 };

    private async Task SelectFile(InputFileChangeEventArgs args)
    {
        if (IsWorking) return;
        _error = null;
        _file = args.File;
        if (!string.Equals(Path.GetExtension(_file.Name), ".json", StringComparison.OrdinalIgnoreCase))
        {
            _error = "Please choose a .json manifest file.";
            _file = null;
        }
        else if (_file.Size > MaxFileSize)
        {
            _error = "The manifest must be 25 MB or smaller.";
            _file = null;
        }
        if (_file is null) return;
        _loadingFile = true;
        try
        {
            await using var stream = _file.OpenReadStream(MaxFileSize);
            using var reader = new StreamReader(stream, Encoding.UTF8);
            SetInput(await reader.ReadToEndAsync(), _file.Name);
            _previousResult = null; _result = null; _keepAssignments = false;
            await JS.InvokeVoidAsync("sessionStorage.removeItem", PlanningStorageKey);
            _setupMessage = "Orders imported. Review your fleet, then optimize the plan.";
        }
        catch (Exception ex) { _error = $"Could not read this file: {ex.Message}" + (_sourceJson is null ? "" : " Your previous plan inputs have been kept."); }
        finally { _loadingFile = false; }
    }

    private void SetInput(string json, string fileName)
    {
        var draft = RoutingDraft.Read(json); // Validate everything before replacing the current draft.
        if (_sessionId is null) { _completedSessionId = null; _session = null; }
        _sourceJson = json;
        _sourceName = fileName;
        _draft = draft;
        _result = null;
    }

    private async Task LoadAppointmentSample()
    {
        if (IsWorking) return;
        _error = null;
        _loadingFile = true;
        try
        {
            SetInput(await Http.GetStringAsync("samples/appointment-test.json"), "synthetic-appointment-test.json");
            _previousResult = null; _result = null; _keepAssignments = false;
            await JS.InvokeVoidAsync("sessionStorage.removeItem", PlanningStorageKey);
            _setupMessage = "Synthetic data only: two simultaneous 9 AM appointments require separate trucks; a 6 AM appointment is outside the vehicle shift. This is not customer freight.";
        }
        catch (Exception ex) { _error = $"Could not load the sample: {ex.Message}"; }
        finally { _loadingFile = false; }
    }

    private async Task ImportAppointments(InputFileChangeEventArgs args)
    {
        if (IsWorking || _sourceJson is null) return;
        _error = null;
        _loadingFile = true;
        try
        {
            if (!args.File.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase)) throw new FormatException("Choose a CSV file.");
            await using var stream = args.File.OpenReadStream(5 * 1024 * 1024);
            using var reader = new StreamReader(stream, Encoding.UTF8);
            var imported = RoutingInput.ImportCsv(_sourceJson, await reader.ReadToEndAsync());
            SetInput(imported.Json, _sourceName);
            _setupMessage = $"Imported {imported.Imported} appointment rows. Download plan inputs to keep this updated scenario; the original files are unchanged.";
        }
        catch (Exception ex) { _error = $"Appointment import failed: {ex.Message}"; }
        finally { _loadingFile = false; }
    }

    private Task DownloadAppointmentTemplate() => _sourceJson is null ? Task.CompletedTask :
        JS.InvokeVoidAsync("routeMap.downloadText", "routing-appointments.csv", RoutingInput.AppointmentTemplate(_sourceJson), "text/csv;charset=utf-8").AsTask();

    private Task DownloadRequest() => _sourceJson is null ? Task.CompletedTask :
        JS.InvokeVoidAsync("routeMap.downloadJson", _sourceName, _step == 4 ? _resultInputJson ?? _sourceJson : _sourceJson).AsTask();

    private void OpenInitialSettings() { if (IsWorking || _sourceJson is null) return; _error = null; _variationOpen = true; }

    private async Task Optimize(bool quick = false)
    {
        if (!CanOptimize || _sourceJson is null) return;
        var previous = _previousResult;
        if (await RunOptimization(_sourceJson, _sourceName, quick))
            _comparison = previous?.Summary is { } baseline ? new ComparisonSnapshot(previous.FileName, baseline, previous.Routes) : null;
    }

    private Task<bool> RunOptimization(string json, string fileName, bool quick = false) => StartPlanning(json, fileName, quick);

    private void OpenVariation()
    {
        if (IsWorking || _sourceJson is null) return;
        _error = null;
        _variationOpen = true;
    }

    private void CloseVariation() => _variationOpen = false;

    private async Task RunVariation(VariationModal.VariationRequest request)
    {
        if (_result is null)
        {
            SetInput(request.Json, request.FileName);
            _setupMessage = "Fleet settings updated. Choose Optimize routes when ready.";
            _variationOpen = false;
            return;
        }
        if (_result?.Summary is not { } baseline) return;
        var comparison = new ComparisonSnapshot(_result.FileName, baseline, _result.Routes);
        if (await RunOptimization(request.Json, request.FileName, request.Quick))
        {
            _sourceJson = request.Json;
            _sourceName = request.FileName;
            _comparison = comparison;
            _variationOpen = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (WorkspaceDraftId is { } draftId)
            {
                try
                {
                    var selection = await Http.GetFromJsonAsync<OrderDraftDto>($"api/v1/aurora/drafts/{draftId}");
                    if (selection is null) throw new FormatException("Selection not found.");
                    _workspaceFinished = selection.Finished;
                    if (_workspaceFinished) { StateHasChanged(); return; }
                    SetInput(selection.RequestJson, selection.FileName);
                }
                catch (Exception ex) { _error = "Could not load selected orders. " + ex.Message; StateHasChanged(); return; }
                StateHasChanged();
            }
            var saved = await JS.InvokeAsync<string?>("sessionStorage.getItem", PlanningStorageKey);
            if (Guid.TryParse(saved, out var id)) { _sessionId = id; await ResumePlanning(); StateHasChanged(); }
        }
        if (_renderMap && _result is not null && _step == 4)
        {
            _renderMap = false;
            _roadCts?.Cancel();
            _roadMode = false;
            _loadingRoads = false;
            _roadError = null;
            _loadedRoads.Clear();
            _roadDirections.Clear();
            var payload = new
            {
                routes = _result.Routes.Select((route, index) => new
                {
                    route.Vehicle,
                    color = RouteColor(index),
                    stops = route.RouteStops.Select(stop => new
                    {
                        lat = stop.Latitude,
                        lon = stop.Longitude,
                        stop.LocationId,
                        stop.IsDepot,
                        stop.OrderIds,
                        arrival = ScheduleTime(stop.Arrival),
                        departure = ScheduleTime(stop.Departure)
                    })
                }),
                dropped = _result.DroppedOrders.Where(order => order.Latitude is not null && order.Longitude is not null)
            };
            await JS.InvokeVoidAsync("routeMap.render", "route-map", payload);
            await JS.InvokeVoidAsync("routeMap.filter", _selectedVehicle);
            StateHasChanged();
        }
    }

    private async Task StartOver()
    {
        if (IsWorking) return;
        await JS.InvokeVoidAsync("routeMap.dispose");
        _result = null;
        _previousResult = null;
        _step = 1; _keepAssignments = false; _session = null;
        await JS.InvokeVoidAsync("sessionStorage.removeItem", PlanningStorageKey);
        _file = null;
        _sourceJson = null;
        _draft = null;
        _setupMessage = null;
        _selectedVehicle = null;
        _comparison = null;
        _variationOpen = false;
        _error = null;
        _renderMap = false;
    }

    private async Task DownloadResponse()
    {
        if (_result is null) return;
        await JS.InvokeVoidAsync("routeMap.downloadJson", $"ptv-response-{DateTime.Now:yyyyMMdd-HHmmss}.json", _result.RawResponse);
    }

    private async Task DownloadStopData()
    {
        if (_result is null) return;

        var csv = new StringBuilder();
        csv.AppendLine("Status,Date Optimized,Terminal,Vehicle,Hours Budgeted,Estimated Hours,Stop Number,PRO,Ship To Name,Address,City,State,Zip,Units,Weight,Cubes,Bill Type,Allotted Stop Minutes,Latitude,Longitude,Reason,Appointment Windows,Appointment Confirmed,Window Enforced,Arrival,Departure");
        foreach (var route in _result.Routes)
        {
            foreach (var pro in route.Pros.OrderBy(pro => pro.StopNumber).ThenBy(pro => pro.ProNumber))
            {
                AppendCsvRow(csv, "Optimized", _result.OptimizedAt.ToString("O"), route.Terminal, route.Vehicle,
                    Hours(route.BudgetedSeconds), Hours(route.EstimatedSeconds), pro.StopNumber?.ToString(), pro.ProNumber,
                    pro.ShipToName, pro.Address1, pro.City, pro.State, pro.PostalCode, CsvNumber(pro.Units),
                    CsvNumber(pro.Weight), CsvNumber(pro.Cubes), pro.BillType, Minutes(pro.AllottedStopSeconds),
                    CsvNumber(pro.Latitude), CsvNumber(pro.Longitude), string.Empty,
                    AppointmentCsv(pro.Appointment), pro.Appointment?.Confirmed?.ToString(), pro.Appointment?.Enforced.ToString(), pro.Arrival?.ToString("O"), pro.Departure?.ToString("O"));
            }
        }
        foreach (var order in _result.DroppedOrders.OrderBy(order => order.OrderId))
        {
            AppendCsvRow(csv, "Unassigned", _result.OptimizedAt.ToString("O"), _result.Terminal, string.Empty,
                string.Empty, string.Empty, string.Empty, order.OrderId, order.ShipToName, order.Address1,
                order.City, order.State, order.PostalCode, CsvNumber(order.Units), CsvNumber(order.Weight),
                CsvNumber(order.Cubes), order.BillType, Minutes(order.AllottedStopSeconds),
                CsvNumber(order.Latitude), CsvNumber(order.Longitude), order.Reason,
                AppointmentCsv(order.Appointment), order.Appointment?.Confirmed?.ToString(), order.Appointment?.Enforced.ToString(), "", "");
        }

        await JS.InvokeVoidAsync("routeMap.downloadText", $"route-stops-{DateTime.Now:yyyyMMdd-HHmmss}.csv", csv.ToString(), "text/csv;charset=utf-8");
    }

    private static void AppendCsvRow(StringBuilder csv, params string?[] values) =>
        csv.AppendLine(string.Join(",", values.Select(Csv)));

    private static string Csv(string? value)
    {
        return RoutingInput.Csv(value);
    }

    private async Task DownloadManifestData()
    {
        if (_result is null) return;
        var csv = new StringBuilder("Vehicle,Terminal,PROs,Stops,Miles,Kilometers,Estimated Hours,Driving Hours,Estimated Cost,Departure,Return\r\n");
        foreach (var route in _result.Routes)
            AppendCsvRow(csv, route.Vehicle, route.Terminal, route.Pros.Count.ToString(), route.ManifestStops.ToString(),
                CsvNumber(route.Kilometers * 0.621371), CsvNumber(route.Kilometers), Hours(route.EstimatedSeconds), Hours(route.DriveSeconds),
                CsvNumber(route.Cost), route.Departure?.ToString("O"), route.Return?.ToString("O"));
        await JS.InvokeVoidAsync("routeMap.downloadText", "manifest-totals.csv", csv.ToString(), "text/csv;charset=utf-8");
    }

    private Task ManifestChanged(ChangeEventArgs args) => SelectManifest(args.Value?.ToString());
    private async Task SelectManifest(string? vehicle)
    {
        _selectedVehicle = string.IsNullOrEmpty(vehicle) ? null : vehicle;
        await JS.InvokeVoidAsync("routeMap.filter", _selectedVehicle);
        if (_roadMode) await ChangeMapMode(true);
    }

    private async Task ChangeMapMode(bool roadMode)
    {
        _roadCts?.Cancel();
        _roadMode = roadMode;
        _roadError = null;
        _loadingRoads = false;
        await JS.InvokeVoidAsync("routeMap.setMode", roadMode);
        if (!roadMode || _result is null) return;
        var result = _result;
        using var cts = new CancellationTokenSource();
        _roadCts = cts;
        _loadingRoads = true;
        try
        {
            var source = System.Text.Json.Nodes.JsonNode.Parse(_resultInputJson ?? _sourceJson ?? "{}");
            foreach (var route in result.Routes.Where(r => _selectedVehicle is null || r.Vehicle == _selectedVehicle))
            {
                if (_loadedRoads.Contains(route.Vehicle) || route.RouteStops.Count < 2) continue;
                var vehicle = source?["vehicles"]?.AsArray().FirstOrDefault(v => v?["id"]?.GetValue<string>() == route.Vehicle);
                var profile = vehicle?["routing"]?["profile"]?.GetValue<string>();
                if (string.IsNullOrWhiteSpace(profile)) throw new InvalidOperationException("This manifest has no vehicle routing profile.");
                using var response = await Http.PostAsJsonAsync("api/v1/routing/road-route",
                    new RoadRouteRequestDto(route.RouteStops.Select(s => new RoadPointDto(s.Latitude, s.Longitude)).ToList(), profile), cts.Token);
                if (!response.IsSuccessStatusCode)
                {
                    var error = await response.Content.ReadFromJsonAsync<ApiErrorDto>(cancellationToken: cts.Token);
                    throw new InvalidOperationException($"Truck {route.Vehicle}: {error?.Error ?? "Road routes could not be loaded."} " + string.Join(" ", error?.Details ?? []));
                }
                var road = await response.Content.ReadFromJsonAsync<RoadRouteDto>(cancellationToken: cts.Token);
                cts.Token.ThrowIfCancellationRequested();
                if (!ReferenceEquals(result, _result)) return;
                if (road is null || road.Points.Count < 2) throw new InvalidOperationException("No road route was returned.");
                await JS.InvokeVoidAsync("routeMap.setRoadRoute", route.Vehicle, road.Points);
                _loadedRoads.Add(route.Vehicle);
                _roadDirections[route.Vehicle] = road.Directions;
                await JS.InvokeVoidAsync("routeMap.setMode", true);
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or System.Text.Json.JsonException)
        {
            if (ReferenceEquals(result, _result) && !cts.IsCancellationRequested)
                _roadError = ex is InvalidOperationException ? ex.Message : "Road routes are unavailable. Retry or switch to Bird’s-eye.";
        }
        finally
        {
            if (ReferenceEquals(_roadCts, cts)) { _roadCts = null; _loadingRoads = false; }
        }
    }
    private Task FocusDirection(RoadDirectionDto direction) => JS.InvokeVoidAsync("routeMap.focus", direction.Latitude, direction.Longitude).AsTask();
    private RouteSummaryDto? PreviousRoute(string vehicle) => _comparison?.Routes.FirstOrDefault(r => r.Vehicle == vehicle);
    private static string ScheduleTime(DateTimeOffset? value) => value?.ToString("MM/dd h:mm tt zzz", CultureInfo.InvariantCulture) ?? "Not provided";
    private static string AppointmentCsv(AppointmentInfoDto? value) => value is null ? "" : string.Join(" | ", value.Windows.Select(w => $"{w.EarliestStart:O} / {w.LatestStart:O}" + (w.LatestEnd is null ? "" : $"; finish by {w.LatestEnd:O}")));

    private static string CsvNumber(double? value) => value?.ToString("0.###", CultureInfo.InvariantCulture) ?? string.Empty;
    private static string Hours(int? seconds) => seconds is > 0 ? (seconds.Value / 3600d).ToString("0.##", CultureInfo.InvariantCulture) : string.Empty;
    private static string Minutes(int? seconds) => seconds is null ? string.Empty : (seconds.Value / 60d).ToString("0.##", CultureInfo.InvariantCulture);

    private Task FitMap() => JS.InvokeVoidAsync("routeMap.fit").AsTask();

    private void SelectTab(ResultTab tab) => _tab = tab;
    private string TabClass(ResultTab tab) => _tab == tab ? "active" : "";
    private string RouteColor(int index) => _colors[index % _colors.Length];
    private static string Signed(double value) => value == 0 ? "No change" : $"{(value > 0 ? "+" : "")}{value:N0}";
    private static string MoneyDelta(double value) => value == 0 ? "No change" : $"{(value > 0 ? "+" : "−")}{Math.Abs(value):C0}";
    private static string DistanceDelta(double value) => value == 0 ? "No change" : $"{(value > 0 ? "+" : "−")}{Math.Abs(value):N0} km";
    private static string DeltaClass(double value, bool lowerIsBetter) => value == 0 ? "neutral" : (value < 0) == lowerIsBetter ? "better" : "worse";
    private static string Duration(int seconds) => seconds <= 0 ? "—" : $"{seconds / 3600}h {seconds % 3600 / 60:D2}m";
    private static string Duration(int? seconds) => seconds is > 0 ? Duration(seconds.Value) : "Not provided";
    private static string StopTime(int? seconds) => seconds is null ? "Not provided" : $"{seconds.Value / 60d:0.##} min";
    private static string Metric(double? value) => value?.ToString("N0") ?? "Not provided";
    private static string Address(string address1, string city, string state, string postalCode)
    {
        var locality = string.Join(", ", new[] { city, state }.Where(value => !string.IsNullOrWhiteSpace(value)));
        var parts = new[] { address1, locality, postalCode }
            .Where(value => !string.IsNullOrWhiteSpace(value) && !string.Equals(value, "Not provided", StringComparison.OrdinalIgnoreCase));
        var address = string.Join(" ", parts);
        return string.IsNullOrWhiteSpace(address) ? "Address not provided" : address;
    }
    private static string FormatBytes(long bytes) => bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:N1} MB" : $"{bytes / 1024d:N0} KB";
    private static string Coordinate(DroppedOrderDto order) => order.Latitude is { } lat && order.Longitude is { } lon ? $"{lat:F4}, {lon:F4}" : "No coordinates";
    public void Dispose() { _disposed = true; _cts?.Cancel(); _cts?.Dispose(); _roadCts?.Cancel(); }

    private sealed record ComparisonSnapshot(string FileName, RunSummaryDto Summary, IReadOnlyList<RouteSummaryDto> Routes);
