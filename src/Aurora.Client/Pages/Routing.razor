@page "/routing"
@attribute [Authorize]
@inject HttpClient Http
@inject IJSRuntime JS
@implements IDisposable
@using System.Globalization
@using System.Text

<PageTitle>Route Optimization - Aurora</PageTitle>

<section class="planner-page">
    <header class="planner-header">
        <div>
            <h1>Route Optimization</h1>
            <p>Plan deliveries, balance your fleet, and review every route.</p>
        </div>
        <div class="planner-header-actions">
            <button class="outline-button" @onclick="() => _equipmentOpen = true" disabled="@IsWorking">Equipment catalog</button>
            <span class="plan-status @(_result is null ? "draft" : "complete")">@(_busy ? "Calculating" : _result is null ? "Draft plan" : "Plan results")</span>
            @if (_result is null)
            {
                <button class="primary-button planner-optimize" @onclick="Optimize" disabled="@(!CanOptimize)">
                    @if (_busy) { <span class="spinner" aria-hidden="true"></span><span>Optimizing…</span> }
                    else { <span>Optimize routes</span><span aria-hidden="true">→</span> }
                </button>
            }
            else
            {
                <button class="outline-button" @onclick="StartOver" disabled="@IsWorking">New plan</button>
                <button class="variation-button" @onclick="OpenVariation" disabled="@IsWorking">Compare scenario</button>
            }
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_error)) { <div class="alert planner-alert" role="alert">@_error</div> }
    @if (_busy)
    {
        <div class="planner-progress" role="status"><span>@_busyLabel</span><button class="text-button" @onclick="Cancel">Cancel optimization</button></div>
    }

@if (_result is null)
{
    <div class="planner-grid">
        <aside class="planning-inputs" aria-label="Plan inputs">
            <section class="planning-card">
                <div class="planning-card-heading"><span class="planning-step" aria-hidden="true">1</span><h2>Delivery orders</h2></div>
                <p class="planning-description">Start with a routing export from your shipment data.</p>
                <div class="planner-file @(_dragging ? "dragging" : "")">
                    <InputFile id="manifest-file" OnChange="SelectFile" accept=".json,application/json" disabled="@IsWorking" aria-label="Import delivery orders"
                               @ondragenter="DragEnter" @ondragleave="DragLeave" @ondrop="DragLeave" />
                    <div class="planner-file-content" aria-hidden="true">
                        <span class="upload-icon"><svg viewBox="0 0 32 32"><path d="M16 22V7m0 0-5 5m5-5 5 5M7 20v5h18v-5" /></svg></span>
                        <strong>@(_loadingFile ? "Reading file…" : _sourceJson is null ? "Import orders" : "Replace order file")</strong>
                        <span>Drop a file here or browse</span>
                    </div>
                </div>
                <p class="file-format">Routing export (.json) · Up to 25 MB</p>
                @if (_sourceJson is not null)
                {
                    <div class="loaded-source"><span class="loaded-check" aria-hidden="true">✓</span><div><strong>@_sourceName</strong><small>@FormatBytes(Encoding.UTF8.GetByteCount(_sourceJson)) · @_draft!.Terminal</small></div></div>
                }
            </section>

            <section class="planning-card">
                <div class="planning-card-heading"><span class="planning-step" aria-hidden="true">2</span><h2>Fleet &amp; planning</h2></div>
                <p class="planning-description">Set available trucks, shifts, capacity, and operating costs.</p>
                <div class="planning-metrics">
                    <div><strong>@(_draft?.Orders.ToString("N0") ?? "—")</strong><span>Orders</span></div>
                    <div><strong>@(_draft?.Trucks.ToString("N0") ?? "—")</strong><span>Trucks</span></div>
                    <div><strong>@(_draft?.Windows.ToString("N0") ?? "—")</strong><span>Time windows</span></div>
                </div>
                <button class="outline-button planning-settings" @onclick="OpenInitialSettings" disabled="@(_sourceJson is null || IsWorking)">Edit schedule &amp; trucks</button>
                @if (_draft is { Trucks: 0 }) { <p class="planning-warning">Add an available truck before optimizing.</p> }
                @if (_draft is { Orders: 0 }) { <p class="planning-warning">This file contains no delivery orders.</p> }
            </section>

            <details class="planning-card planning-disclosure">
                <summary>Appointments &amp; service time <span>Optional</span></summary>
                <div class="planning-disclosure-body">
                    <p class="planning-description">Add appointment windows by PRO. Confirmed appointments constrain the schedule; unconfirmed appointments are informational.</p>
                    @if (_draft is not null) { <p class="file-format">@_draft.Windows scheduling windows · @_draft.InformationalAppointments informational appointments</p> }
                    <div class="planning-tools">
                        <button class="primary-button" @onclick="() => _appointmentsOpen = true" disabled="@(_sourceJson is null || IsWorking)">Edit appointments</button>
                        <button class="outline-button" @onclick="DownloadAppointmentTemplate" disabled="@(_sourceJson is null || IsWorking)">Download template</button>
                        <label class="outline-button planner-csv @(_sourceJson is null || IsWorking ? "disabled" : "")">Import appointment CSV<InputFile OnChange="ImportAppointments" accept=".csv,text/csv" disabled="@(_sourceJson is null || IsWorking)" aria-label="Import appointment CSV" /></label>
                    </div>
                    <p class="file-format">Import orders first. Use dated appointment times with timezone offsets.</p>
                </div>
            </details>
            <details class="planning-card planning-disclosure secondary-tools">
                <summary>More options</summary>
                <div class="planning-disclosure-body">
                    <button class="text-button" @onclick="DownloadRequest" disabled="@(_sourceJson is null || IsWorking)">Download plan inputs</button>
                    <p class="file-format">Keep the current fleet settings and appointment data in a reusable JSON file. Files are not stored by this workspace.</p>
                    <div class="demo-option"><strong>Explore with sample data</strong><p>Three fictional deliveries for a product walkthrough. Replaces the current draft inputs.</p><button class="outline-button" @onclick="LoadAppointmentSample" disabled="@IsWorking">Load demo orders</button></div>
                </div>
            </details>
            @if (_setupMessage is not null) { <p class="setup-message" role="status">@_setupMessage</p> }
        </aside>

        <section class="planning-overview" aria-label="Route overview">
            <div class="planning-overview-heading"><div><h2>Route overview</h2><p>@(_draft is null ? "Delivery locations and planned routes, together in one workspace." : "Delivery locations from your imported orders. Optimize to assign trucks and sequence stops.")</p></div><span class="preview-badge">Input preview</span></div>
            <div class="planning-map-wrap @(_draft is null ? "empty-preview" : "")">
                <div id="route-map" class="planning-preview-map" aria-label="Imported delivery locations"></div>
                @if (_draft is null)
                {
                    <div class="planning-empty"><span class="planning-empty-icon" aria-hidden="true">↗</span><h3>Build your next route plan</h3><p>Import delivery orders, review your fleet, then choose <strong>Optimize routes</strong>.</p><small>Your locations will appear here before you run the plan.</small></div>
                }
            </div>
            <div class="planning-map-caption"><span><i class="preview-dot"></i>Delivery location <i class="preview-dot depot"></i>Depot</span><span>Preview only · No routes calculated</span></div>
            @if (_draft is not null)
            {
                <div class="order-preview-heading"><h3>Imported orders</h3><span>@_draft.Orders.ToString("N0") orders</span></div>
                @if (_draft.Deliveries.Any(d => !d.HasCoordinates)) { <p class="planning-warning overview-warning">@_draft.Deliveries.Count(d => !d.HasCoordinates) orders cannot be shown on the map because their coordinates are missing or invalid.</p> }
                <div class="manifest-table-wrap draft-orders"><table class="manifest-table"><thead><tr><th>PRO</th><th>Destination</th><th>Appointment</th></tr></thead><tbody>
                    @foreach (var order in _draft.Deliveries.Take(5)) { <tr><td><strong>@order.Id</strong></td><td>@order.Name</td><td><AppointmentDisplay Appointment="order.Appointment" /></td></tr> }
                </tbody></table></div>
                @if (_draft.Orders > 5) { <p class="preview-footnote">Showing the first 5 of @_draft.Orders.ToString("N0") imported orders. All orders are included in optimization.</p> }
            }
            else
            {
                <div class="planning-outcomes"><div><strong>Route assignments</strong><span>Truck-by-truck manifests</span></div><div><strong>Time &amp; cost</strong><span>Compare operating scenarios</span></div><div><strong>Unscheduled orders</strong><span>See what needs attention</span></div></div>
            }
        </section>
    </div>
}
else
{
    <section class="results-page">
        <div class="results-heading">
            <div>
                <h2>Plan results</h2>
                <p>@_result.FileName · @_result.OptimizedAt.ToLocalTime().ToString("MMM d, h:mm tt")</p>
            </div>
            <div class="result-actions">
                <button class="outline-button" @onclick="EditPlan" disabled="@IsWorking">Edit plan inputs</button>
                <button class="outline-button" @onclick="DownloadStopData">Export stops</button>
                <button class="outline-button" @onclick="DownloadManifestData">Export manifests</button>
                <details class="result-more"><summary class="outline-button">More downloads</summary><div><button class="text-button" @onclick="DownloadRequest">Plan inputs (JSON)</button><button class="text-button" @onclick="DownloadResponse">Optimizer response (JSON)</button><small>Calculation reference: @(_result.OptimizationId ?? "—") · @_result.ElapsedSeconds.ToString("N1") seconds</small></div></details>
            </div>
        </div>

        @if (_result.Summary is { } summary)
        {
            <div class="stat-grid">
                <div class="stat primary"><span>Status</span><strong>@summary.Status</strong><small>@_result.HttpStatus</small></div>
                <div class="stat"><span>Routes</span><strong>@summary.RoutesUsed <small>/ @summary.VehiclesOffered</small></strong><small>vehicles used</small></div>
                <div class="stat"><span>Scheduled</span><strong>@summary.Scheduled.ToString("N0")</strong><small>of @summary.Orders.ToString("N0") orders</small></div>
                <div class="stat @(summary.Unscheduled > 0 ? "danger" : "success")"><span>Left off</span><strong>@summary.Unscheduled.ToString("N0")</strong><small>unscheduled orders</small></div>
                <div class="stat"><span>Distance</span><strong>@summary.Kilometers.ToString("N0") <small>km</small></strong><small>@((summary.Kilometers * 0.621371).ToString("N0")) miles</small></div>
                <div class="stat"><span>Total cost</span><strong>@summary.Cost.ToString("C0")</strong><small>@summary.CostPerOrder.ToString("C2") / order</small></div>
            </div>
        }

        @if (_comparison is { } comparison && _result.Summary is { } current)
        {
            <section class="comparison-strip" aria-label="Variation comparison">
                <div class="comparison-title"><span>Compared with</span><strong>@comparison.FileName</strong></div>
                <div><span>Total cost</span><strong class="@DeltaClass(current.Cost - comparison.Summary.Cost, lowerIsBetter: true)">@MoneyDelta(current.Cost - comparison.Summary.Cost)</strong></div>
                <div><span>Routes</span><strong>@Signed(current.RoutesUsed - comparison.Summary.RoutesUsed)</strong></div>
                <div><span>Scheduled</span><strong class="@DeltaClass(current.Scheduled - comparison.Summary.Scheduled, lowerIsBetter: false)">@Signed(current.Scheduled - comparison.Summary.Scheduled)</strong></div>
                <div><span>Left off</span><strong class="@DeltaClass(current.Unscheduled - comparison.Summary.Unscheduled, lowerIsBetter: true)">@Signed(current.Unscheduled - comparison.Summary.Unscheduled)</strong></div>
                <div><span>Distance</span><strong class="@DeltaClass(current.Kilometers - comparison.Summary.Kilometers, lowerIsBetter: true)">@DistanceDelta(current.Kilometers - comparison.Summary.Kilometers)</strong></div>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(_result.SummaryError))
        {
            <div class="alert">PTV returned a result, but its summary could not be read: @_result.SummaryError</div>
        }
        @if (_result.Summary is { Violations: > 0 })
        {
            <div class="alert" role="alert">PTV reported constraint violations. Review the Summary before treating this schedule as feasible.</div>
        }

        <div class="workspace-grid @(_tab is ResultTab.Manifest or ResultTab.LeftOff ? "report-view" : string.Empty)">
            <article class="content-panel">
                <nav class="view-tabs" aria-label="Result views">
                    <button class="@TabClass(ResultTab.Manifest)" @onclick="() => SelectTab(ResultTab.Manifest)">Manifest</button>
                    <button class="@TabClass(ResultTab.Summary)" @onclick="() => SelectTab(ResultTab.Summary)">Summary</button>
                    <button class="@TabClass(ResultTab.LeftOff)" @onclick="() => SelectTab(ResultTab.LeftOff)">
                        Left off <span class="count-pill">@_result.DroppedOrders.Count</span>
                    </button>
                </nav>

                @if (_tab == ResultTab.Manifest)
                {
                    <div class="panel-body">
                        <div class="section-title"><div><span>ROUTE MANIFEST</span><h2>Truck assignments</h2></div><small>@_result.Routes.Count routes</small></div>
                        @if (_result.Routes.Count == 0)
                        {
                            <div class="empty-state compact">No routes were returned.</div>
                        }
                        @foreach (var route in _result.Routes)
                        {
                            var color = RouteColor(_result.Routes.ToList().IndexOf(route));
                            var costPerStop = route.ManifestStops > 0 ? (route.Cost / route.ManifestStops).ToString("C2") : "N/A";
                            <details class="route-card @(_selectedVehicle == route.Vehicle ? "map-selected" : "")" open="@(_result.Routes.Count <= 4)" @key="route.Vehicle">
                                <summary>
                                    <span class="route-swatch" style="background:@color"></span>
                                    <span class="truck-icon">▰</span>
                                    <strong>@route.Vehicle</strong>
                                    <span>@route.Pros.Count PROs</span><span>@route.ManifestStops stops</span><span>@((route.Kilometers * 0.621371).ToString("N0")) mi</span>
                                    <b>@Duration(route.EstimatedSeconds)</b>
                                    <b class="manifest-cost" title="Estimated route cost from configured rates">@route.Cost.ToString("C2")</b>
                                    <b class="manifest-cost" title="Estimated route cost divided by manifest stops">@costPerStop / stop</b>
                                    <button class="route-focus" @onclick="() => SelectManifest(route.Vehicle)" @onclick:stopPropagation @onclick:preventDefault aria-pressed="@(_selectedVehicle == route.Vehicle)">Show on map</button>
                                </summary>
                                <div class="manifest-detail">
                                    <div class="manifest-header-grid">
                                        <div><span>Date optimized</span><strong>@_result.OptimizedAt.ToLocalTime().ToString("M/d/yyyy h:mm tt")</strong></div>
                                        <div><span>Terminal</span><strong>@route.Terminal</strong></div>
                                        <div><span>Hours budgeted</span><strong>@Duration(route.BudgetedSeconds)</strong></div>
                                        <div><span>Estimated manifest</span><strong>@Duration(route.EstimatedSeconds)</strong></div>
                                        <div><span>Departure</span><strong>@ScheduleTime(route.Departure)</strong></div>
                                        <div><span>Return</span><strong>@ScheduleTime(route.Return)</strong></div>
                                        <div><span>Distance</span><strong>@((route.Kilometers * 0.621371).ToString("N1")) miles</strong></div>
                                        <div><span>Estimated cost</span><strong>@route.Cost.ToString("C2")</strong></div>
                                    </div>
                                    @if (PreviousRoute(route.Vehicle) is { } previous)
                                    {
                                        <p class="manifest-comparison">Same truck, previous run: @MoneyDelta(route.Cost - previous.Cost) cost · @DistanceDelta(route.Kilometers - previous.Kilometers). Orders may have moved between trucks.</p>
                                    }
                                    <div class="manifest-totals">
                                        <div><span>Stops</span><strong>@route.ManifestStops.ToString("N0")</strong></div>
                                        <div><span>Cost per stop</span><strong>@costPerStop</strong></div>
                                        <div><span>PROs</span><strong>@route.Pros.Count.ToString("N0")</strong></div>
                                        <div><span>Units</span><strong>@Metric(route.Units)</strong></div>
                                        <div><span>Weight</span><strong>@Metric(route.Weight)</strong></div>
                                        <div><span>Cubes</span><strong>@Metric(route.Cubes)</strong></div>
                                    </div>
                                    @if (route.Pros.Count == 0)
                                    {
                                        <div class="empty-state compact">No assigned PRO detail was returned.</div>
                                    }
                                    else
                                    {
                                        <div class="manifest-table-wrap">
                                            <table class="manifest-table">
                                                <thead><tr><th>Stop</th><th>PRO</th><th>Ship to</th><th>Appointment</th><th>Arrival</th><th>Departure</th><th>Units</th><th>Wt.</th><th>Cubes</th><th>Bill type</th><th>Service time</th></tr></thead>
                                                <tbody>
                                                @foreach (var pro in route.Pros.OrderBy(pro => pro.StopNumber).ThenBy(pro => pro.ProNumber))
                                                {
                                                    <tr>
                                                        <td><span class="table-stop" style="border-color:@color">@pro.StopNumber</span></td>
                                                        <td><strong class="pro-number">@pro.ProNumber</strong></td>
                                                        <td><strong>@pro.ShipToName</strong><small>@Address(pro.Address1, pro.City, pro.State, pro.PostalCode)</small></td>
                                                        <td class="appointment-cell"><AppointmentDisplay Appointment="pro.Appointment" /></td>
                                                        <td class="schedule-cell">@ScheduleTime(pro.Arrival)</td>
                                                        <td class="schedule-cell">@ScheduleTime(pro.Departure)</td>
                                                        <td>@Metric(pro.Units)</td>
                                                        <td>@Metric(pro.Weight)</td>
                                                        <td>@Metric(pro.Cubes)</td>
                                                        <td>@pro.BillType</td>
                                                        <td>@StopTime(pro.AllottedStopSeconds)</td>
                                                    </tr>
                                                }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            </details>
                        }
                    </div>
                }
                else if (_tab == ResultTab.Summary)
                {
                    <div class="panel-body">
                        <div class="section-title"><div><span>RUN SUMMARY</span><h2>What PTV planned</h2></div></div>
                        @if (_result.Summary is { } s)
                        {
                            <div class="summary-table">
                                <div><span>Drive time</span><strong>@Duration(s.DriveSeconds)</strong></div>
                                <div><span>Orders per route</span><strong>@s.OrdersPerRoute.ToString("N1")</strong></div>
                                <div><span>Distance per order</span><strong>@s.KilometersPerOrder.ToString("N1") km</strong></div>
                                <div><span>Truck capacity</span><strong>@s.CapacityLabel</strong></div>
                                <div><span>Constraint violations</span><strong>@s.Violations</strong></div>
                                <div><span>Locations</span><strong>@s.Locations</strong></div>
                            </div>
                        }
                        @if (_result.Notes.Count > 0)
                        {
                            <h3>Worth reading</h3>
                            <ul class="note-list">@foreach (var note in _result.Notes) { <li>@note</li> }</ul>
                        }
                        @if (_result.RequestFacts.Count > 0)
                        {
                            <h3>What was sent</h3>
                            <pre class="facts">@string.Join(Environment.NewLine, _result.RequestFacts)</pre>
                        }
                        @if (_result.StopAudit.Count > 0)
                        {
                            <h3>Stop audit</h3>
                            <pre class="facts">@string.Join(Environment.NewLine, _result.StopAudit)</pre>
                        }
                    </div>
                }
                else
                {
                    <div class="panel-body">
                        <div class="section-title"><div><span>UNSCHEDULED</span><h2>Left off the truck</h2></div><small>@_result.DroppedOrders.Count orders</small></div>
                        @if (_result.DroppedOrders.Count == 0)
                        {
                            <div class="all-loaded"><span>✓</span><div><strong>Everything made the truck.</strong><p>PTV scheduled every order in this manifest.</p></div></div>
                        }
                        else
                        {
                            <div class="manifest-table-wrap">
                                <table class="manifest-table dropped-table">
                                    <thead><tr><th>PRO</th><th>Ship to</th><th>Appointment</th><th>Units</th><th>Wt.</th><th>Cubes</th><th>Bill type</th><th>Service time</th><th>PTV reason</th></tr></thead>
                                    <tbody>
                                    @foreach (var order in _result.DroppedOrders.OrderBy(order => order.OrderId))
                                    {
                                        <tr>
                                            <td><strong class="pro-number">@order.OrderId</strong></td>
                                            <td><strong>@order.ShipToName</strong><small>@Address(order.Address1, order.City, order.State, order.PostalCode)</small></td>
                                            <td class="appointment-cell"><AppointmentDisplay Appointment="order.Appointment" /></td>
                                            <td>@Metric(order.Units)</td>
                                            <td>@Metric(order.Weight)</td>
                                            <td>@Metric(order.Cubes)</td>
                                            <td>@order.BillType</td>
                                            <td>@StopTime(order.AllottedStopSeconds)</td>
                                            <td class="reason-cell">@order.Reason</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                }
            </article>

            <aside class="map-panel">
                <div class="map-heading"><div><span>MANIFEST MAP</span><h2>Route sequence</h2></div><button title="Fit selected routes" aria-label="Fit selected routes" @onclick="FitMap">⌗</button></div>
                <div class="map-filter">
                    <div class="map-view-toggle" role="group" aria-label="Route view">
                        <button class="@(!_roadMode ? "active" : "")" aria-pressed="@(!_roadMode)" @onclick="() => ChangeMapMode(false)">Bird’s-eye</button>
                        <button class="@(_roadMode ? "active" : "")" aria-pressed="@_roadMode" @onclick="() => ChangeMapMode(true)">Turn-by-turn</button>
                    </div>
                    <p role="status">@(_loadingRoads ? "Loading road routes…" : _roadMode ? "Road-following view · Stop order is unchanged." : "Straight lines show the stop sequence.")</p>
                    @if (_roadError is not null)
                    {
                        <p class="map-data-warning" role="alert">@_roadError</p>
                        <button class="road-retry" @onclick="() => ChangeMapMode(true)">Retry road routes</button>
                    }
                    <label for="manifest-filter">Show manifest</label>
                    <select id="manifest-filter" value="@(_selectedVehicle ?? "")" @onchange="ManifestChanged">
                        <option value="">All manifests</option>
                        @foreach (var route in _result.Routes) { <option value="@route.Vehicle">@route.Vehicle</option> }
                    </select>
                    <p>Red markers always remain on the map. Numbers on red markers count orders at the same location.</p>
                    @if (_result.DroppedOrders.Any(o => o.Latitude is null || o.Longitude is null))
                    {
                        <p class="map-data-warning">@_result.DroppedOrders.Count(o => o.Latitude is null || o.Longitude is null) unscheduled orders have no coordinates; see Left off.</p>
                    }
                </div>
                <div id="route-map"></div>
                @if (_roadMode)
                {
                    <div class="map-directions">
                        @foreach (var route in _result.Routes.Where(r => _selectedVehicle is null || r.Vehicle == _selectedVehicle))
                        {
                            @if (_roadDirections.TryGetValue(route.Vehicle, out var directions))
                            {
                                <details>
                                    <summary>@route.Vehicle · @directions.Count directions</summary>
                                    @if (directions.Count == 0) { <p>No maneuver instructions were returned for this route.</p> }
                                    <ol>
                                        @foreach (var direction in directions)
                                        {
                                            <li><button @onclick="() => FocusDirection(direction)">@direction.Description</button></li>
                                        }
                                    </ol>
                                </details>
                            }
                        }
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_result.RouteDetailWarning))
                {
                    <div class="map-warning">@_result.RouteDetailWarning</div>
                }
                <div class="map-legend">
                    @for (var i = 0; i < _result.Routes.Count; i++)
                    {
                        var legendRoute = _result.Routes[i];
                        <button class="legend-route @(_selectedVehicle is not null && _selectedVehicle != legendRoute.Vehicle ? "dimmed" : "")" @onclick="() => SelectManifest(legendRoute.Vehicle)"><i style="background:@RouteColor(i)"></i>@legendRoute.Vehicle</button>
                    }
                    @if (_result.DroppedOrders.Any(order => order.Latitude is not null))
                    {
                        <span><i class="dropped-dot"></i>Left off</span>
                    }
                </div>
            </aside>
        </div>
    </section>
}
    <p class="planner-scope">Planning workspace · Results are not sent to dispatch automatically.</p>
</section>

<VariationModal IsOpen="_variationOpen" IsRunning="_busy" SourceJson="@_sourceJson"
                IsInitialRun="@(_result is null)" SourceFileName="@_sourceName"
                OnClose="CloseVariation" OnRun="RunVariation" />
<EquipmentCatalog IsOpen="_equipmentOpen" OnClose="() => _equipmentOpen = false" />
<PlanAppointments IsOpen="_appointmentsOpen" SourceJson="@_sourceJson" OnClose="() => _appointmentsOpen = false" OnApply="ApplyAppointments" />

@code {
    private const long MaxFileSize = 25 * 1024 * 1024;
    private readonly string[] _colors = ["#2363eb", "#f59e0b", "#16a078", "#8259d6", "#0e9fbd", "#b8652f", "#64748b", "#a855a1"];
    private IBrowserFile? _file;
    private string? _sourceJson;
    private string _sourceName = "manifest.json";
    private RoutingDraft? _draft;
    private string? _setupMessage;
    private string? _selectedVehicle;
    private OptimizationResultDto? _result;
