    private void OpenInitialSettings() { if (IsWorking || _sourceJson is null) return; _error = null; _variationOpen = true; }

    private async Task Optimize()
    {
        if (!CanOptimize || _sourceJson is null) return;
        _comparison = null;
        await RunOptimization(_sourceJson, _sourceName);
    }

    private async Task<bool> RunOptimization(string json, string fileName)
    {
        if (IsWorking) return false;
        _busy = true;
        _error = null;
        _busyLabel = "Preparing route calculation…";
        var cts = new CancellationTokenSource();
        _cts = cts;

        try
        {
            using var form = new MultipartFormDataContent();
            using var content = new ByteArrayContent(Encoding.UTF8.GetBytes(json));
            content.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/json");
            form.Add(content, "file", fileName);

            _busyLabel = "Optimizing routes…";
            using var response = await Http.PostAsync("api/v1/routing/optimizations", form, cts.Token);
            if (!response.IsSuccessStatusCode)
            {
                var apiError = await response.Content.ReadFromJsonAsync<ApiErrorDto>(cancellationToken: cts.Token);
                _error = apiError is null ? $"The server returned {response.StatusCode}." :
                    apiError.Details is { Count: > 0 } ? $"{apiError.Error} {string.Join(" ", apiError.Details)}" : apiError.Error;
                return false;
            }

            var result = await response.Content.ReadFromJsonAsync<OptimizationResultDto>(cancellationToken: cts.Token);
            if (result is null)
            {
                _error = "The server returned an empty result.";
                return false;
            }
            await JS.InvokeVoidAsync("routeMap.dispose");
            _result = result;
            _renderPreview = false;
            _selectedVehicle = null;
            _tab = ResultTab.Manifest;
            _renderMap = true;
            return true;
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            _error = "Optimization cancelled.";
            return false;
        }
        catch (Exception ex)
        {
            _error = $"Could not process this manifest: {ex.Message}";
            return false;
        }
        finally
        {
            _busy = false;
            cts.Dispose();
            if (ReferenceEquals(_cts, cts)) _cts = null;
        }
    }

    private void OpenVariation()
    {
        if (IsWorking || _sourceJson is null) return;
        _error = null;
        _variationOpen = true;
    }

    private void CloseVariation() => _variationOpen = false;

    private async Task RunVariation(VariationModal.VariationRequest request)
    {
        if (_result is null)
        {
            SetInput(request.Json, request.FileName);
            _setupMessage = "Fleet settings updated. Choose Optimize routes when ready.";
            _variationOpen = false;
            return;
        }
        if (_result?.Summary is not { } baseline) return;
        var comparison = new ComparisonSnapshot(_result.FileName, baseline, _result.Routes);
        if (await RunOptimization(request.Json, request.FileName))
        {
            _sourceJson = request.Json;
            _sourceName = request.FileName;
            _comparison = comparison;
            _variationOpen = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_renderPreview && _result is null)
        {
            _renderPreview = false;
            await JS.InvokeVoidAsync("routeMap.preview", "route-map", _draft?.Points ?? []);
        }
        if (_renderMap && _result is not null)
        {
            _renderMap = false;
            _roadCts?.Cancel();
            _roadMode = false;
            _loadingRoads = false;
            _roadError = null;
            _loadedRoads.Clear();
            _roadDirections.Clear();
            var payload = new
            {
                routes = _result.Routes.Select((route, index) => new
                {
                    route.Vehicle,
                    color = RouteColor(index),
                    stops = route.RouteStops.Select(stop => new
                    {
                        lat = stop.Latitude,
                        lon = stop.Longitude,
                        stop.LocationId,
                        stop.IsDepot,
                        stop.OrderIds,
                        arrival = ScheduleTime(stop.Arrival),
                        departure = ScheduleTime(stop.Departure)
                    })
                }),
                dropped = _result.DroppedOrders.Where(order => order.Latitude is not null && order.Longitude is not null)
            };
            await JS.InvokeVoidAsync("routeMap.render", "route-map", payload);
            StateHasChanged();
        }
    }

    private async Task StartOver()
    {
        if (IsWorking) return;
        await JS.InvokeVoidAsync("routeMap.dispose");
        _result = null;
        _file = null;
        _sourceJson = null;
        _draft = null;
        _setupMessage = null;
        _selectedVehicle = null;
        _comparison = null;
        _variationOpen = false;
        _error = null;
        _renderMap = false;
        _renderPreview = true;
    }

    private async Task DownloadResponse()
