@inject HttpClient Http
@using System.Text.Json

@if (IsOpen)
{
    <div class="modal-backdrop">
        <section class="variation-modal equipment-modal" role="dialog" aria-modal="true" aria-labelledby="equipment-title">
            <header class="modal-header"><div><span class="eyebrow">SAVED FLEET</span><h2 id="equipment-title">Equipment catalog</h2><p>Reusable equipment types and individual units by terminal.</p></div><button class="modal-close" aria-label="Close equipment catalog" @onclick="Close" disabled="@_busy">×</button></header>
            <div class="catalog-body">
                @if (_error is not null) { <div class="alert" role="alert">@_error</div> }
                @if (_message is not null) { <p role="status">@_message</p> }
                <div class="planning-tools"><button class="outline-button" @onclick="() => _showUnits = false">Equipment types (@_catalog.Types.Count)</button><button class="outline-button" @onclick="() => _showUnits = true">Individual units (@_catalog.Units.Count)</button><button class="text-button" @onclick="LoadSamples" disabled="@(_busy || !_loaded)">Add spreadsheet samples</button></div>
                <p class="file-format">Sample records are labeled TEST and saved only when added. Dimensions are stored in feet, weight in pounds and volume in cubic feet. Review sample values before use.</p>
                <fieldset disabled="@(_busy || !_loaded)">
                @if (!_showUnits)
                {
                    <div class="catalog-layout">
                        <div><button class="outline-button" @onclick="NewType">+ New type</button><div class="manifest-table-wrap catalog-table"><table class="manifest-table"><thead><tr><th>Type</th><th>Capacity</th><th></th></tr></thead><tbody>
                        @foreach (var type in _catalog.Types) { <tr><td><strong>@type.Code</strong><small>@type.Description</small></td><td>@(type.Weight?.ToString("N0") ?? "—") lb<br />@(type.Cubes?.ToString("N0") ?? "—") ft³</td><td><button class="text-button" @onclick="() => EditType(type)">Edit</button></td></tr> }
                        </tbody></table></div></div>
                        <div class="catalog-form"><h3>@(_existingType ? "Edit equipment type" : "New equipment type")</h3><div class="editor-grid">
                            <label class="field"><span>Type code</span><input @bind="_type.Code" disabled="@_existingType" /></label>
                            <label class="field"><span>Description</span><input @bind="_type.Description" /></label>
                            <label class="field"><span>Payload (lb)</span><InputNumber @bind-Value="_type.Weight" /></label>
                            <label class="field"><span>Volume (ft³)</span><InputNumber @bind-Value="_type.Cubes" /></label>
                            <label class="field"><span>Pallet capacity</span><InputNumber @bind-Value="_type.Pallets" /></label>
                            <label class="field"><span>Maximum stops</span><InputNumber @bind-Value="_type.MaximumStops" /></label>
                            <label class="field"><span>Accessories / liftgate</span><input @bind="_type.Accessories" /></label>
                            <label class="field"><span>Equipment categories (comma separated)</span><input @bind="_type.Categories" placeholder="LIFTGATE, HAZMAT_CERTIFIED" /></label>
                        </div>
                        <details><summary>Dimensions and equipment details</summary><div class="editor-grid">
                            <label><input type="checkbox" @bind="_type.PowerOnly" /> Power-only tractor (catalog only)</label>
                            <label class="field"><span>Interior length (ft)</span><InputNumber @bind-Value="_type.InteriorLength" /></label>
                            <label class="field"><span>Interior width (ft)</span><InputNumber @bind-Value="_type.InteriorWidth" /></label>
                            <label class="field"><span>Interior height (ft)</span><InputNumber @bind-Value="_type.InteriorHeight" /></label>
                            <label class="field"><span>Exterior length (ft)</span><InputNumber @bind-Value="_type.ExteriorLength" /></label>
                            <label class="field"><span>Exterior width (ft)</span><InputNumber @bind-Value="_type.ExteriorWidth" /></label>
                            <label class="field"><span>Exterior height (ft)</span><InputNumber @bind-Value="_type.ExteriorHeight" /></label>
                            <label class="field"><span>Total length with power (ft)</span><InputNumber @bind-Value="_type.LengthWithPower" /></label>
                            <label class="field"><span>Axles</span><InputNumber @bind-Value="_type.Axles" /></label>
                            <label class="field"><span>Truck class</span><input @bind="_type.TruckClass" /></label>
                            <label class="field"><span>CDL requirement</span><input @bind="_type.Cdl" /></label>
                            <label class="field"><span>Door type</span><input @bind="_type.DoorType" /></label>
                            <label class="field"><span>Cargo type</span><input @bind="_type.CargoType" /></label>
                            <label class="field"><span>Brand / model</span><input @bind="_type.Model" /></label>
                            <label class="field"><span>Loading position</span><input @bind="_type.LoadPosition" /></label>
                        </div><p class="file-format">Dimensions and CDL are reference data. Routing uses the selected profile. Categories must match the requirements in your orders; a category does not verify a driver's certification.</p></details>
                        <details><summary>Operating costs and routing</summary><div class="editor-grid">
                            <label class="field"><span>Fixed cost ($)</span><InputNumber @bind-Value="_type.FixedCost" /></label>
                            <label class="field"><span>Per hour ($)</span><InputNumber @bind-Value="_type.PerHour" /></label>
                            <label class="field"><span>Per kilometer ($)</span><InputNumber @bind-Value="_type.PerKilometer" /></label>
                            <label class="field"><span>Per stop ($)</span><InputNumber @bind-Value="_type.PerStop" /></label>
                            <label class="field"><span>Routing profile</span><input @bind="_type.RoutingProfile" /></label>
                        </div></details>
                        <label class="field"><span>Notes</span><textarea @bind="_type.Notes"></textarea></label><button class="primary-button" @onclick="SaveType">Save type</button></div>
                    </div>
                }
                else
                {
                    <div class="catalog-layout"><div><div class="planning-tools"><button class="outline-button" @onclick="NewUnit">+ New unit</button><label class="field"><span>Filter terminal / ID</span><input @bind="_filter" @bind:event="oninput" /></label></div><div class="manifest-table-wrap catalog-table"><table class="manifest-table"><thead><tr><th>Unit / terminal</th><th>Type</th><th>Status</th><th></th></tr></thead><tbody>
                        @foreach (var unit in _catalog.Units.Where(x => $"{x.Id} {x.Terminal}".Contains(_filter, StringComparison.OrdinalIgnoreCase))) { <tr><td><strong>@unit.Id</strong><small>@unit.Terminal</small></td><td>@unit.TypeCode</td><td>@(unit.Available ? "Available" : "Unavailable")</td><td><button class="text-button" @onclick="() => EditUnit(unit)">Edit</button></td></tr> }
                    </tbody></table></div></div><div class="catalog-form"><h3>@(_existingUnit ? "Edit unit" : "New unit")</h3><div class="editor-grid">
                        <label class="field"><span>Unit ID</span><input @bind="_unit.Id" disabled="@_existingUnit" /></label><label class="field"><span>Alias</span><input @bind="_unit.Alias" /></label>
                        <label class="field"><span>Terminal</span><input @bind="_unit.Terminal" /></label><label class="field"><span>Equipment type</span><select @bind="_unit.TypeCode"><option value="">Choose type</option>@foreach (var type in _catalog.Types) { <option value="@type.Code">@type.Code</option> }</select></label>
                        <label class="field"><span>VIN</span><input @bind="_unit.Vin" /></label><label class="field"><span>License plate</span><input @bind="_unit.Plate" /></label><label class="field"><span>Plate state</span><input @bind="_unit.PlateState" /></label>
                        <label><input type="checkbox" @bind="_unit.Available" /> Available for planning</label>
                    </div><label class="field"><span>Notes / maintenance</span><textarea @bind="_unit.Notes"></textarea></label><button class="primary-button" @onclick="SaveUnit">Save unit</button></div></div>
                }
                </fieldset>
            </div><footer class="modal-footer"><span>Catalog changes are saved for your organization. Existing plan inputs keep their current values.</span><button class="outline-button" @onclick="Close" disabled="@_busy">Done</button></footer>
        </section>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private EquipmentCatalogDto _catalog = new([], []);
    private EquipmentTypeDto _type = new();
    private EquipmentUnitDto _unit = new();
    private bool _showUnits, _existingType, _existingUnit, _busy, _wasOpen, _loaded;
    private string? _error, _message;
    private string _filter = "";
    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !_wasOpen) { _wasOpen = true; await Work(Refresh); }
        if (!IsOpen) _wasOpen = false;
    }
    private async Task Refresh() { _catalog = await Http.GetFromJsonAsync<EquipmentCatalogDto>("api/v1/routing/equipment") ?? new([], []); _loaded = true; }
    private void NewType() { _type = new(); _existingType = false; }
    private void NewUnit() { _unit = new(); _existingUnit = false; }
    private static T Copy<T>(T item) => JsonSerializer.Deserialize<T>(JsonSerializer.Serialize(item))!;
    private void EditType(EquipmentTypeDto item) { _type = Copy(item); _existingType = true; }
    private void EditUnit(EquipmentUnitDto item) { _unit = Copy(item); _existingUnit = true; }
    private async Task Put<T>(string path, T value)
    {
        using var response = await Http.PutAsJsonAsync("api/v1/routing/equipment/" + path, value);
        if (!response.IsSuccessStatusCode) throw new InvalidOperationException(response.StatusCode == System.Net.HttpStatusCode.BadRequest ? (await response.Content.ReadFromJsonAsync<ApiErrorDto>())?.Error : $"Equipment could not be saved ({(int)response.StatusCode}).");
    }
    private Task SaveType() => Work(async () => { _type.Validate(); if (!_existingType && _catalog.Types.Any(x => x.Code == _type.Code.Trim())) throw new FormatException("That type already exists. Select Edit instead."); await Put("types", _type); await Refresh(); _existingType = true; _message = "Equipment type saved."; });
    private Task SaveUnit() => Work(async () => { _unit.Validate(); if (!_existingUnit && _catalog.Units.Any(x => x.Id == _unit.Id.Trim())) throw new FormatException("That unit already exists. Select Edit instead."); await Put("units", _unit); await Refresh(); _existingUnit = true; _message = "Equipment unit saved."; });
    private Task LoadSamples() => Work(async () =>
    {
        var sample = await Http.GetFromJsonAsync<EquipmentCatalogDto>("samples/equipment-catalog.json") ?? throw new FormatException("Sample equipment is unavailable.");
        using var response = await Http.PostAsJsonAsync("api/v1/routing/equipment/import", sample);
        if (!response.IsSuccessStatusCode) throw new InvalidOperationException("Samples could not be saved. The import was not committed.");
        await Refresh(); _message = "Spreadsheet samples added. Existing records were kept.";
    });
    private async Task Work(Func<Task> action)
    {
        if (_busy) return; _busy = true; _error = _message = null;
        try { await action(); } catch (FormatException ex) { _error = ex.Message; }
        catch (Exception ex) { _error = $"{ex.Message} If the catalog is unavailable, check that the equipment database migration has been applied."; }
        finally { _busy = false; }
    }
    private Task Close() => OnClose.InvokeAsync();
}
