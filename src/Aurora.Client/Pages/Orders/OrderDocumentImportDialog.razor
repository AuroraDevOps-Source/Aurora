 async Task Convert()
 {
  if(_busy || !CanConvert)return;
  if(_pasteText && System.Text.Encoding.UTF8.GetByteCount(_text)>MaxImportBytes){_error="Pasted text must be 10 MB or less. Split the orders into smaller batches.";return;}
  ResetPdfReview();
  _busy=true;_editing=null;_error=null;_createdPros.Clear();_addressNotes.Clear();_warnings.Clear();_existing.Clear();_progress="Extracting orders... This may take a few minutes.";
  try{
   using var http=Clients.CreateClient(ApiClients.Authorized);http.Timeout=TimeSpan.FromMinutes(6);
   using var form=new MultipartFormDataContent();
   if(_pasteText)form.Add(new StringContent(_text,System.Text.Encoding.UTF8,"text/plain"),"file","pasted-orders.txt");
   else form.Add(new StreamContent(_file!.OpenReadStream(MaxImportBytes)),"file",_file.Name);
   var source=_file?.Name ?? "Pasted text";
   await ReleaseSource();
   var module=await SourceModule();
   _source=await module.InvokeAsync<IJSObjectReference>("fromUpload","import-source-file",_text);
   if (string.Equals(Path.GetExtension(source),".pdf",StringComparison.OrdinalIgnoreCase) && _file is not null)
   {
    using var accepted=await http.PostAsync(PdfJobsUrl,form,_lifetime.Token);
    await ApiResponse.Check(accepted);
    var job=await accepted.Content.ReadFromJsonAsync<PdfConversionStatus>() ?? throw new FormatException("PDF conversion could not start.");
    var pending=new PendingPdf(job.Id,source);
    await JS.InvokeVoidAsync("sessionStorage.setItem",PendingPdfKey,System.Text.Json.JsonSerializer.Serialize(pending));
    await WaitForPdf(http,pending);
   }
   else
   {
    using var response=await http.PostAsync("api/v1/tms/orders/convert-document?earlyReview=true",form);
    await ApiResponse.Check(response);
    OpenReview(await response.Content.ReadFromJsonAsync<List<OrderDocumentDraft>>()??[],source);
   }
  }catch(Exception ex){_error=ex.Message;_pdfFailed=_openedEarly;}finally{_busy=false;_receivingPdf=false;_review=_rows.Count>0 || (_openedEarly && _duplicateCount>0);}
  await FinishReviewChecks();
  await LoadHistory();
 }
