@inject IHttpClientFactory Clients
@inject IJSRuntime JS
@implements IAsyncDisposable
<section class="import-entry" aria-label="Convert documents to orders">
 @if(!_review && _error is not null){<p class="alert" role="alert">@_error</p>}
 <fieldset disabled="@(_busy || _review)" class="import-inputs">
  <div class="import-panels">
   <section class="import-panel @(_file is not null ? "is-selected" : null)">
    <header class="import-panel-heading"><span class="import-icon mdi mdi-file-upload-outline" aria-hidden="true"></span><h2>Upload document</h2>@if(_file is not null){<span class="import-ready">Ready</span>}</header>
    <div class="import-dropzone @(!string.IsNullOrWhiteSpace(_text) ? "is-disabled" : null)">
     <span class="mdi mdi-cloud-upload-outline import-drop-icon" aria-hidden="true"></span>
     <strong>Drop a file here</strong><span class="import-or">or</span><span class="import-browse">Browse files</span>
     <InputFile id="import-source-file" @key="_fileVersion" OnChange="SelectFile" disabled="@(!string.IsNullOrWhiteSpace(_text))" aria-label="Upload document: browse or drop a file" accept=".pdf,.csv,.tsv,.txt,.xlsx,.docx,.tif,.tiff,.jpeg,.jpg,.png,.webp,.gif,.bmp" />
    </div>
    @if(_file is not null){<div class="import-file"><span class="mdi mdi-file-document-outline" aria-hidden="true"></span><div><strong>@_file.Name</strong><small>@FileSize(_file.Size)</small></div><button type="button" class="text-button" @onclick="ClearFile">Remove</button></div>}
    else {<p class="import-formats">PDF, Word, Excel, CSV, text, or images &middot; Up to 10 MB</p>}
    @if(!string.IsNullOrWhiteSpace(_text)){<p class="import-source-hint">Clear the pasted text to upload a file.</p>}
   </section>
   <section class="import-panel @(!string.IsNullOrWhiteSpace(_text) ? "is-selected" : null)">
    <header class="import-panel-heading"><span class="import-icon mdi mdi-clipboard-text-outline" aria-hidden="true"></span><h2>Paste text</h2><button type="button" class="text-button import-clear" disabled="@(_text.Length==0)" @onclick="ClearText">Clear</button></header>
    <label class="import-text-label"><span class="import-visually-hidden">Order details</span><textarea class="import-text" @bind="_text" @bind:event="oninput" rows="9" disabled="@(_file is not null)"></textarea></label>
    <div class="import-text-meta"><span>@(_file is not null ? "Remove the file to paste text." : "Paste order details from an email or document.")</span><span>@_text.Length.ToString("N0") characters</span></div>
   </section>
  </div>
  <div class="import-action-bar">
   <div class="import-action-status" role="status">
    @if(_busy && !_review){<span class="import-spinner" aria-hidden="true"></span><span>@_progress</span>}
    else if(_file is not null){<span class="mdi mdi-check-circle-outline" aria-hidden="true"></span><span>Document ready to convert</span>}
    else if(!string.IsNullOrWhiteSpace(_text)){<span class="mdi mdi-check-circle-outline" aria-hidden="true"></span><span>Text ready to convert</span>}
    else {<span>Upload a document or paste text to begin.</span>}
   </div>
   <button class="primary-button import-convert" disabled="@(!CanConvert || _busy)" @onclick="Convert">@(_busy ? "Converting..." : "Convert to orders")<span class="mdi mdi-arrow-right" aria-hidden="true"></span></button>
  </div>
 </fieldset>
</section>
<section class="import-history" aria-labelledby="import-history-heading">
 <header><div><h2 id="import-history-heading">Recent imports</h2><p>Latest 20 imports for your company</p></div><button class="outline-button" disabled="@(_historyLoading || _busy)" @onclick="LoadHistory">Refresh</button></header>
 @if(_historyError is not null){<p class="alert" role="alert">@_historyError</p>}
 else if(_historyLoading){<p class="import-history-empty" role="status">Loading recent imports...</p>}
 else if(_history.Count==0){<div class="import-history-empty"><span class="mdi mdi-history" aria-hidden="true"></span><strong>No imports yet</strong><p>Your converted documents and created order counts will appear here.</p></div>}
 else {
  <div class="import-history-scroll"><table>
   <thead><tr><th>File name</th><th>Date</th><th>Records</th><th>Successful</th><th>Skipped</th><th>Failed</th><th>Status</th></tr></thead>
   <tbody>
   @foreach(var item in _history)
   {
    <tr @key="item.Id">
     <td>@(item.FileName=="pasted-orders.txt" ? "Pasted text" : item.FileName)</td>
     <td>@item.CreatedAt.ToLocalTime().ToString("MMM d, yyyy \u00b7 h:mm tt")</td>
     <td>@item.ExtractedCount.ToString("N0")</td>
     <td>@item.CreatedCount.ToString("N0")</td>
     <td>@(item.SkippedCount?.ToString("N0") ?? "\u2014")</td>
     <td>@(item.FailedCount?.ToString("N0") ?? "\u2014")</td>
     <td><span class="import-history-status @HistoryClass(item.Status)">@item.Status</span>
      @if(item.FailureReason is not null || item.HasOrderFailures || item.FailedCount>0 || item.Status is "Failed" or "Interrupted")
      {
       <ImportFailureDetails @key="item" Item="item" />
      }
     </td>
    </tr>
   }
  </tbody></table></div>
 }
</section>
@if(_review && _reviewHidden){<button type="button" class="outline-button" @onclick="ShowReview">Resume review (@_totalExtracted)</button>}
@if(_review && !_reviewHidden){
<EditPopup Title="@(_editing is null ? $"Review Orders - {_reviewSource}" : "Edit order \u00b7 " + _editPro)" Busy="@(_busy && !_receivingPdf)" OnClose="Close" Class="order-dialog">
 @if (_editing is null)
 {
  <div class="review-tabs" role="tablist" aria-label="Order review" @onkeydown="SwitchReviewTab">
   <button type="button" id="review-orders-tab" role="tab" aria-controls="review-orders-panel" aria-selected="@(!_documentTab ? "true":"false")" tabindex="@(_documentTab?-1:0)" @ref="_ordersTabButton" @onclick="()=>_documentTab=false">Review Orders</button>
   <button type="button" id="review-document-tab" role="tab" aria-controls="review-document-panel" aria-selected="@(_documentTab ? "true":"false")" tabindex="@(_documentTab?0:-1)" @ref="_documentTabButton" @onclick="()=>_documentTab=true">Document</button>
  </div>
 }
 <div id="review-orders-panel" role="@(_editing is null ? "tabpanel":null)" aria-labelledby="@(_editing is null ? "review-orders-tab":null)" hidden="@_documentTab">
 @if(_error is not null){<p class="alert" role="alert">@_error</p>}
 @if(_saved>0){
  <div class="import-success" role="status">
   <strong>@(_saved==1 ? $"Order {_createdPros[0]}" : $"{_saved} orders") created in @(NativeWorkspace?"Nova":"Aurora").</strong>
   @if(_addressNotes.Count+_warnings.Count>0){
    <details><summary>Address details (@((_addressNotes.Count+_warnings.Count).ToString("N0")) messages)</summary>
     @foreach(var group in _warnings.Concat(_addressNotes).GroupBy(n=>n.Text)){
      <details><summary>@group.Key (@group.Count().ToString("N0"))</summary><p>PROs: @string.Join(", ",group.Select(n=>n.Pro))</p></details>
     }
    </details>
   }
  </div>
 }
 @if(_receivingPdf){<p role="status">@_progress · @_totalExtracted available to review</p>}
 @if(_checking){<p role="status">Checking Nova addresses and existing PROs... You can review and edit now.</p>}
 @if(_checkFailed){<button class="outline-button" @onclick="ReviewChecks">Retry address and duplicate checks</button>}

 <fieldset disabled="@(_busy && !_receivingPdf)" class="import-review-fields">
   @{
    var flagged = _rows.Where(r => ReviewIssue(r) is not null).ToList();
    var skipped = _rows.Count(r=>r.Skipped);
    var included = _rows.Count-skipped;
    skipped += _duplicateCount;
    var ready = included-flagged.Count;
    var paged = _rows.Count > 1;
    var index = Math.Clamp(_reviewIndex, 0, Math.Max(0, _rows.Count - 1));
   }
   <div class="review-toolbar">
   @if (_editing is null && skipped > 0)
   {
    <span role="status">@skipped skipped</span>
   }
   @if (paged)
   {
    <nav class="review-pager" aria-label="Order navigation">
     <button class="outline-button" disabled="@(index==0)" @onclick="()=>SelectPage(index-1)">Previous order</button>
     <label>Order <select value="@index" @onchange="e=>SelectPage(int.Parse(e.Value!.ToString()!))">
      @for(var i=0;i<_rows.Count;i++){<option value="@i">@(i+1) &middot; @_rows[i].Order.Id &middot; @_rows[i].Order.Customer</option>}
     </select> of @_rows.Count.ToString("N0")</label>
     <button class="outline-button" disabled="@(index==_rows.Count-1)" @onclick="()=>SelectPage(index+1)">Next order</button>
    </nav>
   }
   </div>
   @foreach(var row in (paged?_rows.Skip(index).Take(1):_rows)){
    @if(row.Draft.ExtractionError is {} extractionError)
    {
     <div class="import-order" @key="row" id="@row.SummaryId">
      <strong>PDF pages @string.Join(", ",row.Draft.SourcePages) · @row.Draft.MappingSender</strong>
      <p class="alert">@extractionError</p>
      @if (row.Skipped){<button type="button" class="outline-button" @onclick="()=>Include(row)">Include in review</button>}
      else {<button type="button" class="outline-button" @onclick="()=>SkipOrder(row)">Skip order</button>}
     </div>
     continue;
    }
    <section class="import-order" @key="row" aria-labelledby="@row.SummaryId">
     <h3 id="@row.SummaryId">@if(!string.IsNullOrWhiteSpace(row.Order.Id)){<text>@row.Order.Id · </text>}else if(!NativeWorkspace){<text>Order number required · </text>}@(string.IsNullOrWhiteSpace(row.Order.Customer) ? $"Order {row.Draft.ImportRowNumber}" : row.Order.Customer)
      @if(row.Skipped){<span> &mdash; Skipped</span>}
      else if(_editing is null && ReviewIssue(row) is {} issue){<span class="review-issue">@issue</span>}
     </h3>
     @if(row.Skipped){<button class="outline-button" @onclick="()=>Include(row)">Include in import</button>}
     @if(_editing is null && !row.Skipped && row.Draft.MappingQuestions.Length==0 && ReviewIssue(row) is not null)
     {
      @if(row.CreateError is not null){<p class="alert">@row.CreateError</p><button class="outline-button" @onclick="()=>row.CreateError=null">Retry after correction</button>}
      <button class="outline-button" @onclick="()=>SkipOrder(row)">Skip order</button>
     }
     @foreach(var question in row.Draft.MappingQuestions.Where(_=>!row.Skipped)){
      <DocumentMappingReview @key="question" Draft="row.Draft" Question="question" Drafts="IncludedRows.Select(r=>r.Draft).ToList()" MoreExpected="_receivingPdf" OnBatchRule="rule=>_pdfBatchRules.Add(rule)" OnAnswered="()=>AnswerApplied(row)" OnSkipped="()=>SkipOrder(row)" />
     }
     @if(!NativeWorkspace && _editing is null && MappedPro(row)==""){<p class="import-source-hint">Enter the order's Tag or PRO to create it.</p>}
     <section class="import-group"><h3>Order &amp; references</h3><div class="manifest-edit-grid">
      <label class="field">Tag # / Nova PRO<input @bind="row.Draft.TagNumber" @bind:after="()=>TagChanged(row)" maxlength="200" readonly="@(_editing is not null)" /></label>
      <label class="field">Terminal<select @bind="row.Order.TerminalId"><option value="">Choose terminal</option>@foreach(var terminal in Terminals){<option value="@terminal.Id">@terminal.Code - @terminal.Name</option>}</select></label>
      @if(NativeWorkspace){<label class="field">Nova status<InputSelect @bind-Value="row.Draft.NativeStatusId"><option value="">Choose status</option>@if(row.Draft.NativeStatusId is {} existingStatus && !Statuses.Any(s=>s.Id==existingStatus)){<option value="@existingStatus">@existingStatus</option>}@foreach(var status in Statuses){<option value="@status.Id">@status.Name</option>}</InputSelect></label>}
      <label class="field">BOL #<input @bind="row.Draft.BillOfLading" @bind:after='()=>ResolveQuestion(row,"BOL",row.Draft.BillOfLading)' maxlength="200" required /></label>
      <label class="field">P.O. #<input @bind="row.Draft.PurchaseOrder" maxlength="80" /></label>
      <label class="field">Shipment reference<input @bind="row.Draft.ShipmentReference" maxlength="200" /></label>
      <label class="field">HAWB #<input @bind="row.Draft.HouseAirWaybill" maxlength="200" /></label>
      <label class="field">MAWB #<input @bind="row.Draft.MasterAirWaybill" maxlength="200" /></label>
     </div></section>
     <div class="import-parties">
     @foreach(var group in AddressGroups){
      <section class="import-group import-address"><h3>@group.Title</h3><div class="manifest-edit-grid">
       <label class="field">Account ID<input value="@row.Draft.AccountId(group.Part)" @onchange="e=>EditAccount(row,group.Part,e.Value?.ToString()?.Trim()??string.Empty)" maxlength="80" /></label>
       @foreach(var field in TextFields.Skip(group.Start).Take(7)){
        <label class="field">@field.Label<input value="@GetText(row.Order,field.Name)" @onchange="e=>EditAddress(row,group.Part,field.Name,e.Value?.ToString()??string.Empty)" maxlength="200" /></label>
       }
       @if(group.Part=="header"){
        <label class="field">Bill-to contact<input @bind="row.Draft.BillToContact" maxlength="40" /></label>
        <label class="field">Bill-to phone<input type="tel" @bind="row.Draft.BillToPhone" maxlength="32" /></label>
        <label class="field">Bill-to email<input @bind="row.Draft.BillToEmail" maxlength="150" /></label>
       }
      </div></section>
     }
     </div>
     <section class="import-group"><h3>Shipment details</h3><div class="manifest-edit-grid">
      <label class="field">Scheduled date/time<input type="datetime-local" @bind="row.Scheduled" /></label>
      <label class="field">Work type<select @bind="row.Order.WorkType"><option>Delivery</option><option>Pickup</option></select></label>
      <label class="field">Pieces<InputNumber @bind-Value="row.Order.Pieces" @bind-Value:after="()=>{if (_editing is null && row.Draft.FreightLines is [var line]) line.Pieces=row.Order.Pieces;}" /></label>
      <label class="field">Total weight (lb)<InputNumber @bind-Value="row.Order.Weight" @bind-Value:after="()=>{if (_editing is null && row.Draft.FreightLines is [var line]) line.WeightLb=row.Order.Weight;}" /></label>
      <label class="field">Total cube (ft&sup3;)<InputNumber @bind-Value="row.Order.Cube" @bind-Value:after="()=>{if (_editing is null && row.Draft.FreightLines is [var line]) line.CubeFt3=row.Order.Cube;}" /></label>
      <label class="field import-notes">Notes<textarea @bind="row.Order.Notes" maxlength="4000"></textarea></label>
     </div></section>
     <section class="import-group"><h3>Freight line items</h3>
      @{var lines=row.Draft.FreightLines??[]; var showDimWeight=lines.Any(l=>l.DimWeightLb.HasValue);}
      @if(lines.Length>0){
       <div class="import-line-scroll"><table class="import-lines"><thead><tr><th>Qty</th><th>Description</th><th>Weight (lb)</th>@if(showDimWeight){<th>Dim weight (lb)</th>}<th>Cube (ft&sup3;)</th></tr></thead><tbody>
        @foreach(var line in lines){
         @if(_editing is null){
          <tr @key="line">
           <td><input aria-label="Line quantity" type="number" step="any" min="0" @bind="line.Pieces" @bind:after="()=>SyncLineQuantity(row,line)" /></td>
           <td><input aria-label="Line description" @bind="line.Description" /></td>
           <td><input aria-label="Line weight (lb)" type="number" step="any" min="0" @bind="line.WeightLb" @bind:after="()=>SyncLineWeight(row,line)" /></td>
           @if(showDimWeight){<td><input aria-label="Line dimensional weight (lb)" type="number" step="any" min="0" @bind="line.DimWeightLb" /></td>}
           <td><input aria-label="Line cube (ft³)" type="number" step="any" min="0" @bind="line.CubeFt3" @bind:after="()=>SyncLineCube(row,line)" /></td>
          </tr>
         }else{
          <tr><td>@Measure(line.Pieces)</td><td>@line.Description</td><td>@Measure(line.WeightLb)</td>@if(showDimWeight){<td>@Measure(line.DimWeightLb)</td>}<td>@Measure(line.Volume)</td></tr>
         }
        }
       </tbody></table></div>
      }else if(_editing is null){<button type="button" class="text-button" @onclick="()=>InitializeLine(row)">Add freight line</button>}
      else{<p class="import-source-hint">No freight line items.</p>}
     </section>
     @if(_editing is null){<button class="text-button" @onclick="()=>RemoveOrder(row)">Remove from import</button>}
    </section>
   }
   <div class="review-footer">
   @if(_receivingPdf){<span role="status">Order creation opens when processing and checks finish.</span>}
   else if(_busy){<div class="review-progress" role="status"><strong>@_progress</strong>@if(_batchTotal>0){<progress aria-label="Order creation progress" value="@_batchPosition" max="@_batchTotal"></progress>}</div>}
   else if(_editing is not null){<button class="primary-button" disabled="@_busy" @onclick="SaveImportedOrder">Save changes</button>}
   else if(included>0){<button class="primary-button" disabled="@(_busy || _checking || _pdfFailed || _checkFailed || ready==0)" @onclick="Create">Create @ready.ToString("N0") @(flagged.Count>0?"ready ":"")@(ready==1?"order":"orders")</button>}
   else if(skipped>0 && _saved==0){<button class="primary-button" @onclick="Close">Finish without creating orders</button>}
   <button class="outline-button review-close" disabled="@(_busy && !_receivingPdf)" @onclick="Close">@(_receivingPdf?"Hide":"Close")</button>
   </div>
 </fieldset>
 </div>
 @if (_editing is null)
 {
  <div id="review-document-panel" role="tabpanel" aria-labelledby="review-document-tab" hidden="@(!_documentTab)">
   @if (_sourceError is not null){<p role="alert" class="alert">@_sourceError</p>}
   <div class="review-source" @ref="_sourceHost"></div>
   <div class="review-footer"><button type="button" class="outline-button" disabled="@(_busy && !_receivingPdf)" @onclick="Close">@(_receivingPdf?"Hide":"Close")</button></div>
  </div>
 }
</EditPopup>
}
@code {
 List<OrderImportHistory> _history=[];
 int _batchTotal, _batchPosition;
 int _reviewIndex;
 int _totalExtracted;
 Row? _selectedRow;
 bool _manuallySelected;
 string? _scrollTo;
 void ResetReviewIndex()
 {
  _manuallySelected=false;
  SelectReviewRow();
 }
 void SelectPage(int index)
 {
  _manuallySelected=true;
  _reviewIndex=index;
  _selectedRow=_rows[index];
 }
 void SelectReviewRow(Row? answered=null, bool skip=false)
 {
  var flagged=_rows.Where(row=>ReviewIssue(row) is not null).ToList();
  if (answered is null) _selectedRow=flagged.FirstOrDefault();
  else if (!skip && answered.Draft.MappingQuestions.Length>0) _selectedRow=answered;
  else
  {
   var after=_rows.Skip(_rows.IndexOf(answered)+1);
   _selectedRow=after.FirstOrDefault(flagged.Contains);
  }
  _reviewIndex=_selectedRow is null ? Math.Clamp(_reviewIndex,0,Math.Max(0,_rows.Count-1)) : _rows.IndexOf(_selectedRow);
 }
 async Task SkipOrder(Row row)
 {
  _manuallySelected=true;
  row.Skipped=true;
  SelectReviewRow(row, skip:true);
  _scrollTo=_selectedRow?.SummaryId;
  await SaveReviewCounts();
 }
 async Task Include(Row row)
 {
  row.Skipped=false;
  _manuallySelected=true;
  _selectedRow=row;
  await SaveReviewCounts();
 }
 Guid? _reviewBatch;
 string _reviewSource="";
 int _removedCount, _duplicateCount;
 async Task TagChanged(Row row)
 {
  row.Order.Id=MappedPro(row);
  await ReviewChecks();
 }
 void SkipDuplicatePros()
 {
  var seen=new HashSet<string>(_existing);
  _duplicateCount+=_rows.RemoveAll(row=>
  {
   if(row.Skipped || row.CreationFailed)return false;
   var pro=MappedPro(row);
   return pro.Length>0 && !seen.Add(pro);
  });
  if(_selectedRow is not null && _rows.Contains(_selectedRow))_reviewIndex=_rows.IndexOf(_selectedRow);
  else SelectReviewRow();
 }
 readonly SemaphoreSlim _countLock=new(1,1);
 async Task RemoveOrder(Row row)
 {
  var index = _rows.IndexOf(row);
  if (index < 0) return;
  _rows.RemoveAt(index);
  _removedCount++;
  _manuallySelected = true;
  _reviewIndex = Math.Clamp(index, 0, Math.Max(0, _rows.Count - 1));
  _selectedRow = _rows.ElementAtOrDefault(_reviewIndex);
  await SaveReviewCounts();
 }
 async Task<bool> SaveReviewCounts()
 {
  if (_receivingPdf || _pdfFailed || _reviewBatch is not {} batch) return true;
  var localFailures=_rows.Where(r=>r.ClientFailure is not null).Select(r=>r.ClientFailure!).ToArray();
  var counts=new ImportReviewCounts(_removedCount+_duplicateCount+_rows.Count(r=>r.Skipped),
      IncludedRows.Count(r=>r.CreationFailed),localFailures);
  await _countLock.WaitAsync();
  try
  {
   using var http=Clients.CreateClient(ApiClients.Authorized);
   using var response=await http.PutAsJsonAsync($"api/v1/tms/orders/import/history/{batch}/counts",counts);
   await ApiResponse.Check(response);
   return true;
  }
  catch(Exception)
  {
   if (_reviewBatch==batch) _error="Could not save the import summary.";
   return false;
  }
  finally { _countLock.Release(); }
 }
 async Task AnswerApplied(Row row)
 {
  _manuallySelected=true;
  SelectReviewRow(row);
  _scrollTo=_selectedRow?.SummaryId;
  await ReviewChecks();
 }
 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if (_review && !_reviewHidden && _documentTab && !_sourceRendered)
  {
   _sourceRendered=true;
   try
   {
    if (_source is null && _sourceJob is {} job)
    {
     using var http=Clients.CreateClient(ApiClients.Authorized);
     var bytes=await http.GetByteArrayAsync($"{PdfJobsUrl}/{job}/source",_lifetime.Token);
     var module=await SourceModule();
     _source=await module.InvokeAsync<IJSObjectReference>("fromPdf",bytes);
    }
    if (_source is null)throw new InvalidOperationException();
    await _source.InvokeVoidAsync("show",_sourceHost,_reviewSource);
   }
   catch(Exception) when(!_lifetime.IsCancellationRequested)
   {
    _sourceError="The original document could not be displayed.";
    StateHasChanged();
   }
  }
  if (_documentTab || _scrollTo is not {} id) return;
  _scrollTo=null;
  await JS.InvokeVoidAsync("auroraWorkspace.scrollOption",id);
 }
 string? ReviewIssue(Row row)
 {
  if (row.Skipped) return null;
  if (row.Draft.ExtractionError is not null) return "Could not extract shipment";
  if (row.CreateError is not null) return "Could not create order";
  if (row.Draft.MappingQuestions.Length > 0) return "Unanswered question";
  if (string.IsNullOrWhiteSpace(row.Draft.BillToAccountId) && row.Draft.AddressLookupMessages.Contains(NovaImportAddress.AmbiguousBillTo))
      return NovaImportAddress.AmbiguousBillTo;
  var pro=MappedPro(row);
  if (pro.Length==0 && (!NativeWorkspace || !string.IsNullOrWhiteSpace(row.Draft.TagNumber))) return "Missing or invalid PRO";
  if (string.IsNullOrWhiteSpace(row.Draft.BillOfLading)) return "Missing BOL";
  if (NativeWorkspace && row.Order.TerminalId is null) return "Choose a terminal";
  if (string.IsNullOrWhiteSpace(row.Order.Shipper) && string.IsNullOrWhiteSpace(row.Draft.ShipperAccountId)) return "Missing shipper";
  if (string.IsNullOrWhiteSpace(row.Order.Customer) && string.IsNullOrWhiteSpace(row.Draft.ConsigneeAccountId)) return "Missing consignee";
  return null;
 }
 bool _historyLoading;
 string? _historyError;
 [Parameter] public Guid? ImportBatch {get;set;}
 [Parameter] public string? OrderPro {get;set;}
 string? _openedLink;
 ImportedOrderEdit? _editing;
 Guid _editBatch;
 string? _editPro;
 protected override async Task OnInitializedAsync()
 {
  await LoadHistory();
  if(ImportBatch is null)await ResumePdf();
 }
 protected override async Task OnParametersSetAsync()
 {
  if(ImportBatch is {} batch && !string.IsNullOrWhiteSpace(OrderPro) && _openedLink!=$"{batch}:{OrderPro}")
  { _openedLink=$"{batch}:{OrderPro}";await OpenImportedOrder(batch,OrderPro); }
 }
 async Task OpenImportedOrder(Guid batch,string pro)
 {
  if(_busy || _review)return;
  _busy=true;_error=null;_createdPros.Clear();_addressNotes.Clear();_existing.Clear();_warnings.Clear();_rows.Clear();_editing=null;
