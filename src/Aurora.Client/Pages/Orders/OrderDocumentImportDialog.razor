@inject IHttpClientFactory Clients
@inject IJSRuntime JS
<section class="import-entry" aria-label="Convert documents to orders">
 @if(!_review && _error is not null){<p class="alert" role="alert">@_error</p>}
 <fieldset disabled="@(_busy || _review)" class="import-inputs">
  <div class="import-panels">
   <section class="import-panel @(_file is not null ? "is-selected" : null)">
    <header class="import-panel-heading"><span class="import-icon mdi mdi-file-upload-outline" aria-hidden="true"></span><h2>Upload document</h2>@if(_file is not null){<span class="import-ready">Ready</span>}</header>
    <div class="import-dropzone @(!string.IsNullOrWhiteSpace(_text) ? "is-disabled" : null)">
     <span class="mdi mdi-cloud-upload-outline import-drop-icon" aria-hidden="true"></span>
     <strong>Drop a file here</strong><span class="import-or">or</span><span class="import-browse">Browse files</span>
     <InputFile @key="_fileVersion" OnChange="SelectFile" disabled="@(!string.IsNullOrWhiteSpace(_text))" aria-label="Upload document: browse or drop a file" accept=".pdf,.csv,.tsv,.txt,.xlsx,.docx,.tif,.tiff,.jpeg,.jpg,.png,.webp,.gif,.bmp" />
    </div>
    @if(_file is not null){<div class="import-file"><span class="mdi mdi-file-document-outline" aria-hidden="true"></span><div><strong>@_file.Name</strong><small>@FileSize(_file.Size)</small></div><button type="button" class="text-button" @onclick="ClearFile">Remove</button></div>}
    else {<p class="import-formats">PDF, Word, Excel, CSV, text, or images &middot; Up to 10 MB</p>}
    @if(!string.IsNullOrWhiteSpace(_text)){<p class="import-source-hint">Clear the pasted text to upload a file.</p>}
   </section>
   <section class="import-panel @(!string.IsNullOrWhiteSpace(_text) ? "is-selected" : null)">
    <header class="import-panel-heading"><span class="import-icon mdi mdi-clipboard-text-outline" aria-hidden="true"></span><h2>Paste text</h2><button type="button" class="text-button import-clear" disabled="@(_text.Length==0)" @onclick="ClearText">Clear</button></header>
    <label class="import-text-label"><span class="import-visually-hidden">Order details</span><textarea class="import-text" @bind="_text" @bind:event="oninput" rows="9" disabled="@(_file is not null)"></textarea></label>
    <div class="import-text-meta"><span>@(_file is not null ? "Remove the file to paste text." : "Paste order details from an email or document.")</span><span>@_text.Length.ToString("N0") characters</span></div>
   </section>
  </div>
  <div class="import-action-bar">
   <div class="import-action-status" role="status">
    @if(_busy && !_review){<span class="import-spinner" aria-hidden="true"></span><span>@_progress</span>}
    else if(_file is not null){<span class="mdi mdi-check-circle-outline" aria-hidden="true"></span><span>Document ready to convert</span>}
    else if(!string.IsNullOrWhiteSpace(_text)){<span class="mdi mdi-check-circle-outline" aria-hidden="true"></span><span>Text ready to convert</span>}
    else {<span>Upload a document or paste text to begin.</span>}
   </div>
   <button class="primary-button import-convert" disabled="@(!CanConvert || _busy)" @onclick="Convert">@(_busy ? "Converting..." : "Convert to orders")<span class="mdi mdi-arrow-right" aria-hidden="true"></span></button>
  </div>
 </fieldset>
</section>
<section class="import-history" aria-labelledby="import-history-heading">
 <header><div><h2 id="import-history-heading">Recent imports</h2><p>Latest 20 imports for your company</p></div><button class="outline-button" disabled="@(_historyLoading || _busy)" @onclick="LoadHistory">Refresh</button></header>
 @if(_historyError is not null){<p class="alert" role="alert">@_historyError</p>}
 else if(_historyLoading){<p class="import-history-empty" role="status">Loading recent imports...</p>}
 else if(_history.Count==0){<div class="import-history-empty"><span class="mdi mdi-history" aria-hidden="true"></span><strong>No imports yet</strong><p>Your converted documents and created order counts will appear here.</p></div>}
 else {
  <div class="import-history-scroll"><table><thead><tr><th>Source</th><th>Date</th><th>Order number</th><th>Orders created</th><th>Status</th></tr></thead><tbody>
   @foreach(var item in _history){<tr @key="item.Id"><td><span class="mdi mdi-file-document-outline" aria-hidden="true"></span>@(item.FileName=="pasted-orders.txt" ? "Pasted text" : item.FileName)</td><td>@item.CreatedAt.ToLocalTime().ToString("MMM d, yyyy \u00b7 h:mm tt")</td><td class="import-order-numbers">@if(item.CreatedPros.Length==0){<span>&mdash;</span>}else{@foreach(var pro in item.CreatedPros){<a href="@($"/data-entry?import={item.Id}&order={Uri.EscapeDataString(pro)}")" @onclick="()=>OpenImportedOrder(item.Id,pro)" @onclick:preventDefault="true" data-enhance-nav="false" aria-label="@($"Open order {pro}")">@pro</a>}}</td><td>@item.CreatedCount <span class="import-count-detail">/ @item.ExtractedCount extracted</span></td><td><span class="import-history-status @HistoryClass(item.Status)">@item.Status</span></td></tr>}
  </tbody></table></div>
 }
</section>
@if(_review){
<EditPopup Title="@(_editing is null ? "Review orders" : "Edit order \u00b7 " + _editPro)" Busy="_busy" OnClose="Close" Class="order-dialog">
 @if(_error is not null){<p class="alert" role="alert">@_error</p>}
 @if(_saved>0){
  <div class="import-success" role="status">
   <strong>@(_saved==1 ? $"Order {_createdPros[0]}" : $"{_saved} orders") created in @(NativeWorkspace?"Nova":"Aurora").</strong>
   @foreach(var note in _addressNotes){<p>@(_saved>1 ? $"Order {note.Pro}: " : "")@note.Text</p>}
  </div>
 }
 @if(_checking){<p role="status">Checking Nova addresses and existing PROs... You can review and edit now.</p>}
 @if(_checkFailed){<button class="outline-button" @onclick="ReviewChecks">Retry address and duplicate checks</button>}
 @foreach(var warning in _warnings){<p class="alert" role="status">@warning</p>}
 <fieldset disabled="@_busy" class="import-review-fields">
   @{
    var conflicts = ConflictingPros.ToHashSet();
    var flagged = _rows.Where(r => ReviewIssue(r, conflicts) is not null).ToList();
    var visible = _needsReviewOnly && _editing is null ? flagged : _rows;
    var skipped = _rows.Count(r=>r.Skipped);
    var included = _rows.Count-skipped;
    var ready = included-flagged.Count;
    var index = Math.Clamp(_reviewIndex, 0, Math.Max(0, visible.Count - 1));
   }
   @if (_editing is null)
   {
    <div class="import-review-filter">
     <label><input type="checkbox" @bind="_needsReviewOnly" @bind:after="ResetReviewIndex" /> Only show orders needing review</label>
     <span role="status">@($"{flagged.Count:N0} out of {_totalExtracted:N0} needing review")@if(skipped>0){<span> &middot; @skipped skipped</span>}</span>
    </div>
   }
   @if (visible.Count > 10)
   {
    <div class="import-action-bar">
     <button class="outline-button" disabled="@(index==0)" @onclick="()=>SelectPage(visible, index-1)">Previous order</button>
     <label>Order <select value="@index" @onchange="e=>SelectPage(visible, int.Parse(e.Value!.ToString()!))">
      @for(var i=0;i<visible.Count;i++){<option value="@i">@(i+1) &middot; @visible[i].Order.Id &middot; @visible[i].Order.Customer</option>}
     </select> of @visible.Count</label>
     <button class="outline-button" disabled="@(index==visible.Count-1)" @onclick="()=>SelectPage(visible, index+1)">Next order</button>
    </div>
   }
   @if (_needsReviewOnly && visible.Count==0 && _rows.Count>0){<p role="status">@(_checking ? "Checking orders..." : _checkFailed ? "Retry the checks to finish reviewing these orders." : "No orders need review.")</p>}
   @foreach(var row in (visible.Count>10?visible.Skip(index).Take(1):visible)){
    <details class="import-order" @key="row" open="@(_editing is not null || _openRow==row)">
     <summary id="@row.SummaryId" @onclick="()=>ToggleRow(row)" @onclick:preventDefault="@(_editing is null)">@(string.IsNullOrWhiteSpace(row.Order.Id)?"Order number required":row.Order.Id) &middot; @row.Order.Customer
      @if(row.Skipped){<span> &mdash; Skipped</span>}
      else if(_editing is null && ReviewIssue(row,conflicts) is {} issue){<span> &mdash; @issue</span>}
     </summary>
     @foreach(var decision in row.Draft.MappingDecisions){<p class="import-source-hint">@decision</p>}
     @if(!string.IsNullOrWhiteSpace(row.Draft.BillingEvidence)){<p>Freight terms: @row.Draft.FreightTerms &middot; @row.Draft.BillingEvidence</p>}
     @if(row.Skipped){<button class="outline-button" @onclick="()=>Include(row)">Include in import</button>}
     @if(_editing is null && !row.Skipped && row.Draft.MappingQuestions.Length==0 && ReviewIssue(row,conflicts) is not null)
     {
      @if(row.CreateError is not null){<p class="alert">@row.CreateError</p><button class="outline-button" @onclick="()=>row.CreateError=null">Retry after correction</button>}
      <button class="outline-button" @onclick="()=>SkipOrder(row)">Skip order</button>
     }
     @foreach(var question in row.Draft.MappingQuestions.Where(_=>!row.Skipped)){
      <DocumentMappingReview @key="question" Draft="row.Draft" Question="question" Drafts="IncludedRows.Select(r=>r.Draft).ToList()" OnAnswered="()=>AnswerApplied(row)" OnSkipped="()=>SkipOrder(row)" />
     }
     @foreach(var message in row.Draft.AddressLookupMessages){<p class="import-source-hint">@message</p>}
     @if(_existing.Contains(MappedPro(row))){<p class="alert import-duplicate" role="alert">PRO @MappedPro(row) already exists</p>}
     @if(_editing is null && MappedPro(row)==""){<p class="import-source-hint">Enter the order's Tag or PRO to create it.</p>}
     else if(conflicts.Contains(MappedPro(row))){<p class="alert">PRO @MappedPro(row) occurs more than once in this import. Review the original Tags.</p>}
     <section class="import-group"><h3>Order &amp; references</h3><div class="manifest-edit-grid">
      <label class="field">Tag # / numeric PRO<input @bind="row.Draft.TagNumber" maxlength="200" readonly="@(_editing is not null)" /></label>
      <label class="field">Nova PRO (from Tag)<input value="@MappedPro(row)" readonly /></label>
      <label class="field">Terminal<select @bind="row.Order.TerminalId"><option value="">Choose terminal</option>@foreach(var terminal in Terminals){<option value="@terminal.Id">@terminal.Code - @terminal.Name</option>}</select></label>
      @if(NativeWorkspace){<label class="field">Nova status<InputSelect @bind-Value="row.Draft.NativeStatusId"><option value="">Choose status</option>@if(row.Draft.NativeStatusId is {} existingStatus && !Statuses.Any(s=>s.Id==existingStatus)){<option value="@existingStatus">@existingStatus</option>}@foreach(var status in Statuses){<option value="@status.Id">@status.Name</option>}</InputSelect></label>}
      <label class="field">BOL #<input @bind="row.Draft.BillOfLading" maxlength="200" /></label>
      <label class="field">P.O. #<input @bind="row.Draft.PurchaseOrder" maxlength="80" /></label>
      <label class="field">Shipment reference<input @bind="row.Draft.ShipmentReference" maxlength="200" /></label>
      <label class="field">HAWB #<input @bind="row.Draft.HouseAirWaybill" maxlength="200" /></label>
      <label class="field">MAWB #<input @bind="row.Draft.MasterAirWaybill" maxlength="200" /></label>
     </div></section>
     <div class="import-parties">
     @foreach(var group in AddressGroups){
      <section class="import-group import-address"><h3>@group.Title</h3><div class="manifest-edit-grid">
       <label class="field">Account ID<input value="@row.Draft.AccountId(group.Part)" @onchange="e=>row.Draft.SetAccountId(group.Part,e.Value?.ToString()?.Trim()??string.Empty)" maxlength="80" /></label>
       @foreach(var field in TextFields.Skip(group.Start).Take(7)){
        <label class="field">@field.Label<input value="@GetText(row.Order,field.Name)" @onchange="e=>EditAddress(row,group.Part,field.Name,e.Value?.ToString()??string.Empty)" maxlength="200" /></label>
       }
      </div></section>
     }
     </div>
     <section class="import-group"><h3>Shipment details</h3><div class="manifest-edit-grid">
      <label class="field">Scheduled date/time<input type="datetime-local" @bind="row.Scheduled" /></label>
      <label class="field">Work type<select @bind="row.Order.WorkType"><option>Delivery</option><option>Pickup</option></select></label>
      <label class="field">Pieces<InputNumber @bind-Value="row.Order.Pieces" /></label>
      <label class="field">Total weight (lb)<InputNumber @bind-Value="row.Order.Weight" /></label>
      <label class="field">Total cube (ft&sup3;)<InputNumber @bind-Value="row.Order.Cube" /></label>
      <label class="field import-notes">Notes<textarea @bind="row.Order.Notes" maxlength="4000"></textarea></label>
     </div></section>
     <section class="import-group"><h3>Freight line items</h3>
      @{var lines=row.Draft.FreightLines??[];var pending=_editing is null;
        if(pending && lines.Length==0 && (row.Order.Pieces!=0 || row.Order.Weight!=0 || row.Order.Cube!=0))lines=[new DocumentFreightLine()];}
      @if(lines.Length>0){
       <div class="import-line-scroll"><table class="import-lines"><thead><tr><th>Qty</th><th>Description</th><th>Weight (lb)</th><th>Cube (ft&sup3;)</th></tr></thead><tbody>
        @foreach(var line in lines){
         var single=pending && lines.Length==1;
         <tr><td>@Measure(single?row.Order.Pieces:line.Pieces)</td><td>@(string.IsNullOrWhiteSpace(line.Description)?"\u2014":line.Description)</td><td>@Measure(single?row.Order.Weight:line.WeightLb)</td><td>@Measure(line.Volume??(single && row.Order.Cube>0?row.Order.Cube:null))</td></tr>
        }
       </tbody></table></div>
      }else{<p class="import-source-hint">No freight line items.</p>}
     </section>
     @if(_editing is null){<button class="text-button" @onclick="()=>_rows.Remove(row)">Remove from import</button>}
    </details>
   }
   @if(_editing is not null){<button class="primary-button" disabled="@_busy" @onclick="SaveImportedOrder">Save changes</button>}
   else if(included>0){<button class="primary-button" disabled="@(_busy || _checking || _checkFailed || ready==0)" @onclick="Create">Create @ready.ToString("N0") @(flagged.Count>0?"ready ":"")@(ready==1?"order":"orders")</button>}
   else if(skipped>0 && _saved==0){<button class="primary-button" @onclick="Close">Finish without creating orders</button>}
 </fieldset>
 @if(_busy){<p role="status">@_progress</p>}
 <div class="popup-actions"><button class="outline-button" disabled="@_busy" @onclick="Close">Close</button></div>
</EditPopup>
}
@code {
 List<OrderImportHistory> _history=[];
 int _reviewIndex;
 int _totalExtracted;
 bool _needsReviewOnly = true;
 Row? _openRow;
 bool _manuallySelected;
 string? _scrollTo;
 void ResetReviewIndex()
 {
  _manuallySelected=false;
  SelectReviewRow();
 }
 void SelectPage(List<Row> visible, int index)
 {
  _manuallySelected=true;
  _reviewIndex=index;
  _openRow=visible[index];
 }
 void ToggleRow(Row row)
 {
  if (_editing is not null) return;
  _manuallySelected=true;
  _openRow=_openRow==row ? null : row;
 }
 void SelectReviewRow(Row? answered=null, bool skip=false)
 {
  var conflicts=ConflictingPros.ToHashSet();
  var flagged=_rows.Where(row=>ReviewIssue(row,conflicts) is not null).ToList();
  if (answered is null) _openRow=flagged.FirstOrDefault();
  else if (!skip && answered.Draft.MappingQuestions.Length>0) _openRow=answered;
  else
  {
   var after=_rows.Skip(_rows.IndexOf(answered)+1);
   _openRow=after.FirstOrDefault(flagged.Contains);
  }
  var visible=_needsReviewOnly ? flagged : _rows;
  _reviewIndex=_openRow is null ? Math.Clamp(_reviewIndex,0,Math.Max(0,visible.Count-1)) : visible.IndexOf(_openRow);
 }
 void SkipOrder(Row row)
 {
  _manuallySelected=true;
  row.Skipped=true;
  SelectReviewRow(row, skip:true);
  _scrollTo=_openRow?.SummaryId;
 }
 void Include(Row row)
 {
  row.Skipped=false;
  _manuallySelected=true;
  _openRow=row;
 }
 async Task AnswerApplied(Row row)
 {
  _manuallySelected=true;
  SelectReviewRow(row);
  _scrollTo=_openRow?.SummaryId;
  await ReviewChecks();
 }
 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if (_scrollTo is not {} id) return;
  _scrollTo=null;
  await JS.InvokeVoidAsync("auroraWorkspace.scrollOption",id);
 }
 string? ReviewIssue(Row row, HashSet<string> conflicts)
 {
  if (row.Skipped) return null;
  if (row.CreateError is not null) return "Could not create order";
  if (row.Draft.MappingQuestions.Length > 0) return "Unanswered question";
  var pro=MappedPro(row);
  if (pro.Length==0) return "Missing or invalid PRO";
  if (_existing.Contains(pro) || conflicts.Contains(pro)) return "Duplicate PRO";
  if (string.IsNullOrWhiteSpace(row.Order.Shipper) && string.IsNullOrWhiteSpace(row.Draft.ShipperAccountId)) return "Missing shipper";
  if (string.IsNullOrWhiteSpace(row.Order.Customer) && string.IsNullOrWhiteSpace(row.Draft.ConsigneeAccountId)) return "Missing consignee";
  return null;
 }
 bool _historyLoading;
 string? _historyError;
 [Parameter] public Guid? ImportBatch {get;set;}
 [Parameter] public string? OrderPro {get;set;}
 string? _openedLink;
 ImportedOrderEdit? _editing;
 Guid _editBatch;
 string? _editPro;
 protected override Task OnInitializedAsync()=>LoadHistory();
 protected override async Task OnParametersSetAsync()
 {
  if(ImportBatch is {} batch && !string.IsNullOrWhiteSpace(OrderPro) && _openedLink!=$"{batch}:{OrderPro}")
  { _openedLink=$"{batch}:{OrderPro}";await OpenImportedOrder(batch,OrderPro); }
 }
 async Task OpenImportedOrder(Guid batch,string pro)
 {
  if(_busy || _review)return;
  _busy=true;_error=null;_createdPros.Clear();_addressNotes.Clear();_existing.Clear();_warnings.Clear();_rows.Clear();_editing=null;
  try
  {
   using var http=Clients.CreateClient(ApiClients.Authorized);
   using var response=await http.GetAsync($"api/v1/order-imports/{batch}/orders/{Uri.EscapeDataString(pro)}");
   await ApiResponse.Check(response);
   _editing=(await response.Content.ReadFromJsonAsync<ImportedOrderEdit>())!;
   _editBatch=batch;_editPro=pro;
   var draft=_editing.Draft;
   if(_editing.NativeWorkspace)draft.Order.TerminalId=Terminals.FirstOrDefault(t=>string.Equals(t.Code,draft.Order.TerminalCode,StringComparison.OrdinalIgnoreCase))?.Id;
   _rows=[new Row(draft)];
   if(_editing.NativeWorkspace && draft.Order.AppointmentFrom is null)_rows[0].Scheduled=null;
   _review=true;
  }
  catch(Exception ex){_error=ex.Message;_review=false;}
  finally{_busy=false;}
 }
 async Task SaveImportedOrder()
 {
  if(_busy || _editing is null)return;
  _busy=true;_error=null;_progress="Saving order...";
  try
  {
   var row=_rows.Single();
   row.Order.TerminalCode=Terminals.FirstOrDefault(t=>t.Id==row.Order.TerminalId)?.Code;
   if(row.Scheduled is {} scheduled)row.Order.ScheduledAt=DateTimeOffset.Parse(await JS.InvokeAsync<string>("auroraWorkspace.utc",scheduled.ToString("yyyy-MM-ddTHH:mm:ss")));
   using var http=Clients.CreateClient(ApiClients.Authorized);
   using var response=await http.PutAsJsonAsync($"api/v1/order-imports/{_editBatch}/orders/{Uri.EscapeDataString(_editPro!)}",_editing with {ClearSchedule=row.Scheduled is null});
   await ApiResponse.Check(response);
   _review=false;_editing=null;_rows.Clear();await LoadHistory();await OnCreated.InvokeAsync();
  }
  catch(Exception ex){_error=ex.Message;}
  finally{_busy=false;}
 }
 async Task LoadHistory()
 {
  _historyLoading=true;_historyError=null;
  try{using var http=Clients.CreateClient(ApiClients.Authorized);_history=await http.GetFromJsonAsync<List<OrderImportHistory>>("api/v1/tms/orders/import/history")??[];}
  catch(Exception){_historyError="Recent imports could not be loaded. Select Refresh to retry.";}
  finally{_historyLoading=false;}
 }
 static string FileSize(long size)=>size>=1024*1024?$"{size/(1024d*1024):0.0} MB":$"{Math.Max(1,Math.Ceiling(size/1024d)):0} KB";
 static string HistoryClass(string status)=>status switch {"Orders created"=>"is-created","Failed" or "Interrupted"=>"is-failed","Converting"=>"is-converting",_=>"is-converted"};
 void ClearText(){_text="";_error=null;}
 [Parameter] public bool NativeWorkspace {get;set;}
 [Parameter] public NovaManifestStatus[] Statuses {get;set;}=[];
 [Parameter] public List<TerminalDto> Terminals {get;set;}=[];
 [Parameter] public EventCallback OnClose {get;set;}
 [Parameter] public EventCallback OnCreated {get;set;}
 IBrowserFile? _file;
 const long MaxImportBytes=10*1024*1024;
 bool _review;
 int _fileVersion;
 bool _pasteText=>_file is null;
 static readonly (string Title,int Start,string Part)[] AddressGroups=[("Shipper",7,"pickup"),("Consignee",0,"delivery"),("Bill to",14,"header")];
 string _text="";
 bool CanConvert=>_pasteText?!string.IsNullOrWhiteSpace(_text):_file is not null;
 bool _busy;
 readonly List<string> _createdPros=[];
 readonly List<(string Pro,string Text)> _addressNotes=[];
 int _saved => _createdPros.Count;
 string? _error,_progress;
 readonly HashSet<string> _existing=[];
 IEnumerable<Row> IncludedRows => _rows.Where(row=>!row.Skipped);
 IEnumerable<string> ConflictingPros => IncludedRows.Select(MappedPro).Where(pro=>pro.Length>0).GroupBy(pro=>pro).Where(g=>g.Count()>1).Select(g=>g.Key);
 bool _checking,_checkFailed;
 int _reviewVersion;
 readonly List<string> _warnings=[];
 List<Row> _rows=[];
 sealed class Row(OrderDocumentDraft draft){public string? CreateError;public bool Skipped;public string SummaryId {get;}="review-"+Guid.NewGuid().ToString("N");public OrderDocumentDraft Draft=draft;public TmsOrder Order=>Draft.Order;public DateTime? Scheduled=draft.LocalScheduledAt??draft.Order.ScheduledAt.LocalDateTime;}
 static string Measure(decimal? value)=>value?.ToString("0.####")??"\u2014";
 static string MappedPro(Row row){try{return OrderDocumentDraft.SplitTag(row.Draft.TagNumber).Pro;}catch(FormatException){return "";}}
 static readonly (string Name,string Label)[] TextFields=[
  ("Customer","Consignee"),("Address","Consignee address"),("Address2","Consignee address 2"),("City","Consignee city"),("State","Consignee state"),("PostalCode","Consignee ZIP"),("Country","Consignee country"),
  ("Shipper","Shipper"),("OriginAddress","Shipper address"),("OriginAddress2","Shipper address 2"),("OriginCity","Shipper city"),("OriginState","Shipper state"),("OriginPostalCode","Shipper ZIP"),("OriginCountry","Shipper country"),
  ("BillTo","Bill to"),("BillToAddress","Bill-to address"),("BillToAddress2","Bill-to address 2"),("BillToCity","Bill-to city"),("BillToState","Bill-to state"),("BillToPostalCode","Bill-to ZIP"),("BillToCountry","Bill-to country")];
 static string GetText(TmsOrder o,string name)=>(string?)typeof(TmsOrder).GetProperty(name)!.GetValue(o)??"";
 static void EditAddress(Row row,string part,string field,string value)
 {
  row.Draft.EditedAddressParts.Add(part);
  SetText(row.Order,field,value);
 }
 static void SetText(TmsOrder o,string name,string value)=>typeof(TmsOrder).GetProperty(name)!.SetValue(o,value);
 void ClearFile(){_file=null;_fileVersion++;_error=null;}
 void SelectFile(InputFileChangeEventArgs e){
  _file=null;_error=null;
  if(e.FileCount!=1){_error="Choose one document at a time.";_fileVersion++;return;}
  if(e.File.Size is <=0 or >MaxImportBytes){_error="Choose a nonempty file up to 10 MB.";return;}
  _file=e.File;
 }
 async Task Close(){if(_busy)return;_reviewVersion++;_checking=false;_checkFailed=false;_review=false;_editing=null;_rows.Clear();_error=null;await LoadHistory();await OnClose.InvokeAsync();}
 async Task Convert()
 {
  if(_busy || !CanConvert)return;
  if(_pasteText && System.Text.Encoding.UTF8.GetByteCount(_text)>MaxImportBytes){_error="Pasted text must be 10 MB or less. Split the orders into smaller batches.";return;}
  _busy=true;_editing=null;_error=null;_createdPros.Clear();_addressNotes.Clear();_warnings.Clear();_existing.Clear();_progress="Extracting orders... This may take a few minutes.";
  try{
   using var http=Clients.CreateClient(ApiClients.Authorized);http.Timeout=TimeSpan.FromMinutes(6);
   using var form=new MultipartFormDataContent();
   if(_pasteText)form.Add(new StringContent(_text,System.Text.Encoding.UTF8,"text/plain"),"file","pasted-orders.txt");
   else form.Add(new StreamContent(_file!.OpenReadStream(MaxImportBytes)),"file",_file.Name);
   var uploadTimer=System.Diagnostics.Stopwatch.StartNew();
   using var response=await http.PostAsync("api/v1/tms/orders/convert-document?earlyReview=true",form);
   await ApiResponse.Check(response);
   _needsReviewOnly=true;_reviewIndex=0;_rows=(await response.Content.ReadFromJsonAsync<List<OrderDocumentDraft>>()??[]).Select(o=>new Row(o)).ToList();
   _totalExtracted=_rows.Count;
   foreach(var row in _rows){
    row.Draft.NativeStatusId=NativeWorkspace && Statuses.Any(s=>s.Id==NovaDocumentImport.DefaultStatus)?NovaDocumentImport.DefaultStatus:null;
    if(string.IsNullOrWhiteSpace(row.Draft.TagNumber))row.Draft.TagNumber=row.Order.Id;
    row.Order.TerminalId=Terminals.FirstOrDefault(t=>string.Equals(t.Code,row.Order.TerminalCode,StringComparison.OrdinalIgnoreCase))?.Id;
   }

   Console.WriteLine($"Document upload to draft: {uploadTimer.ElapsedMilliseconds} ms");
   if(_rows.Count==0)_error="No orders were found. Check the file or pasted text and try again.";
  }catch(Exception ex){_error=ex.Message;}finally{_busy=false;_review=_rows.Count>0;}
  if(_review){ResetReviewIndex();await ReviewChecks();}
  await LoadHistory();
 }
 async Task ReviewChecks()
 {
  var version=++_reviewVersion;
  _checking=true;_checkFailed=false;_error=null;
  var rows=_rows.ToArray();
  StateHasChanged();
  try
  {
   using var http=Clients.CreateClient(ApiClients.Authorized);
   http.Timeout=TimeSpan.FromMinutes(5);
   var duplicates=FindExisting(http,rows.Select(MappedPro).Where(id=>id.Length>0).Distinct().ToArray());
   await Task.WhenAll(duplicates,CheckAddresses(http,rows,version));
   if(version==_reviewVersion){_existing.Clear();_existing.UnionWith(await duplicates);
    if (!_manuallySelected && (_openRow is null || ReviewIssue(_openRow,ConflictingPros.ToHashSet()) is null)) SelectReviewRow();
   }
  }
  catch(Exception ex){if(version==_reviewVersion){_checkFailed=true;_error=ex.Message;}}
  finally{if(version==_reviewVersion)_checking=false;}
 }
 static string[] PartyValues(OrderDocumentDraft draft,string part,string[] props)=>
    new[]{draft.AccountId(part)}.Concat(props.Select(p=>GetText(draft.Order,p))).ToArray();
 async Task CheckAddresses(HttpClient http, Row[] rows,int version)
 {
  foreach(var batch in rows.Chunk(100))
  {
   if(version!=_reviewVersion)return;
   var before=batch.Select(r=>NovaImportAddress.Parties.Select(p=>PartyValues(r.Draft,p.Part,p.Properties)).ToArray()).ToArray();
   using var response=await http.PostAsJsonAsync("api/v1/tms/orders/import/addresses",batch.Select(r=>r.Draft).ToArray());
   await ApiResponse.Check(response);
   var found=await response.Content.ReadFromJsonAsync<OrderDocumentDraft[]>();
   if(version!=_reviewVersion)return;
   if(found?.Length!=batch.Length)throw new FormatException("Incomplete address lookup. Retry the checks.");
   for(var i=0;i<batch.Length;i++)
   {
    var draft=batch[i].Draft;
    var messages=new List<string>();
    for(var j=0;j<NovaImportAddress.Parties.Length;j++)
    {
     var (part,label,props)=NovaImportAddress.Parties[j];
     if(draft.EditedAddressParts.Contains(part) || !before[i][j].SequenceEqual(PartyValues(draft,part,props)))continue;
     draft.SetAccountId(part,found[i].AccountId(part));
     foreach(var prop in props)SetText(draft.Order,prop,GetText(found[i].Order,prop));
     messages.AddRange(found[i].AddressLookupMessages.Where(m=>m.StartsWith(label+":",StringComparison.Ordinal)));
    }
    draft.AddressLookupMessages=[..messages,..found[i].AddressLookupMessages.Where(m=>!m.Contains(':'))];
   }
  }
 }
 static async Task<HashSet<string>> FindExisting(HttpClient http,string[] ids)
 {
  var existing=new HashSet<string>();
  foreach(var batch in ids.Chunk(100)){
   using var response=await http.PostAsJsonAsync("api/v1/tms/orders/import/check",batch);
   await ApiResponse.Check(response);
   existing.UnionWith(await response.Content.ReadFromJsonAsync<string[]>()??[]);
  }
  return existing;
 }
 void AddLocationMessages(string pro,IEnumerable<string> messages)
 {
  var parties=new List<string>();
  foreach(var message in messages.Distinct()){
   var party=NovaImportAddress.Parties.FirstOrDefault(p=>message==$"{p.Label}: no unique Nova address match; kept the imported address.");
   if(party.Label is not null){parties.Add(party.Label.ToLowerInvariant());continue;}
   if(NovaImportAddress.Parties.Any(p=>message.StartsWith($"{p.Label}: using the address from Nova account ",StringComparison.Ordinal)))
    _addressNotes.Add((pro,message));
   else _warnings.Add($"PRO {pro}: {message}");
  }
  if(parties.Count==0)return;
  var names=parties.Count==1 ? parties[0] : string.Join(", ",parties.SkipLast(1))+" and "+parties[^1];
  _addressNotes.Add((pro,$"Used the {names} {(parties.Count==1?"address":"addresses")} from the bill."));
 }
 async Task Create()
 {
  if(_busy || _checking || _checkFailed)return;
  var conflicts=ConflictingPros.ToHashSet();
  var pending=IncludedRows.Where(r=>ReviewIssue(r,conflicts) is null).ToList();
  if(pending.Count==0)return;
  _busy=true;_error=null;_progress="Checking import...";
  var creationStarted=false;
  try{
   using var http=Clients.CreateClient(ApiClients.Authorized);
   _existing.UnionWith(await FindExisting(http,pending.Select(MappedPro).ToArray()));
   _progress="Creating orders...";
   foreach(var row in pending){
    if(_existing.Contains(MappedPro(row)))continue;
    try{row.Draft.Normalize();}catch(FormatException ex){row.CreateError=ex.Message;continue;}
    var terminal=Terminals.SingleOrDefault(t=>t.Id==row.Order.TerminalId);
    row.Order.TerminalCode=terminal?.Code;
    if(row.Scheduled is {} scheduled){row.Draft.ChangeLocalSchedule(scheduled);row.Order.ScheduledAt=DateTimeOffset.Parse(await JS.InvokeAsync<string>("auroraWorkspace.utc",scheduled.ToString("yyyy-MM-ddTHH:mm:ss")));}
    creationStarted=true;
    using var response=await http.PostAsJsonAsync(NativeWorkspace?"api/v1/aurora/firebird/orders/import":"api/v1/tms/orders/import",row.Draft);
    try{await ApiResponse.Check(response);}
    catch(FormatException ex) when(response.StatusCode is System.Net.HttpStatusCode.BadRequest or System.Net.HttpStatusCode.Conflict or System.Net.HttpStatusCode.UnprocessableEntity)
    {row.CreateError=ex.Message;continue;}
    if(NativeWorkspace){
     var saved=await response.Content.ReadFromJsonAsync<NovaRecordDocument>();
     AddLocationMessages(row.Order.Id,saved?.LocationWarnings??[]);
    }
    _createdPros.Add(row.Order.Id);_existing.Add(row.Order.Id);_rows.Remove(row);
   }
   _file=null;_fileVersion++;_text="";
  }catch(Exception ex){_error=creationStarted
    ?$"{ex.Message} {_saved} orders created; {_rows.Count} remain. If a request lost its connection, check the orders list before retrying."
    :$"{ex.Message} No orders were created in this attempt. {_rows.Count} {(_rows.Count==1?"order remains":"orders remain")} for review.";}
  finally{_busy=false;await LoadHistory();if(_saved>0)await OnCreated.InvokeAsync();}
 }
