 async Task FinishReviewChecks()
 {
  if(_pdfFailed)return;
  if(_review)
  {
   if(!_openedEarly)ResetReviewIndex();
   await ReviewChecks();
  }
  if(_openedEarly && (_removedCount+_duplicateCount>0 || _rows.Any(r=>r.Skipped)))await SaveReviewCounts();
 }

 async Task WaitForPdf(HttpClient http, PendingPdf pending)
 {
  var ct=_lifetime.Token;
  var after=0;
  _sourceJob=pending.Id;
  while(true)
  {
   ct.ThrowIfCancellationRequested();
   PdfConversionStatus status;
   try
   {
    using var response=await http.GetAsync($"{PdfJobsUrl}/{pending.Id}?after={after}",ct);
    if(response.StatusCode==System.Net.HttpStatusCode.NotFound)
      await JS.InvokeVoidAsync("sessionStorage.removeItem",PendingPdfKey);
    if((int)response.StatusCode>=500)throw new HttpRequestException();
    await ApiResponse.Check(response);
    status=await response.Content.ReadFromJsonAsync<PdfConversionStatus>(ct) ?? throw new FormatException("Missing PDF job status.");
   }
   catch(HttpRequestException) when(!ct.IsCancellationRequested)
   {
    _progress="Reconnecting to PDF conversion...";
    StateHasChanged();
    await Task.Delay(3000,ct);
    continue;
   }
   _progress=status.Progress;
   if(status.Error is not null || status.Orders is not null)
   {
    await JS.InvokeVoidAsync("sessionStorage.removeItem",PendingPdfKey);
    if(status.Error is not null)throw new FormatException(status.Error);
    if (_openedEarly) AppendPdfRows(status.Orders!);
    else OpenReview(status.Orders!,pending.Source);
    return;
   }
   if(status.ReadyOrders is {Count:>0} arriving)
   {
    after+=arriving.Count;
    if(!_openedEarly)
    {
     _openedEarly=_receivingPdf=_review=true;
     OpenReview([],pending.Source);
     _error=null;
    }
    var added=AppendPdfRows(arriving);
    if(added.Count>0 && _selectedRow is null && !_manuallySelected)_selectedRow=added[0];
    StateHasChanged();
    if(added.Count>0) await CheckReviewRows(added.ToArray());
   }
   StateHasChanged();
   await Task.Delay(2000,ct);
  }
 }
 async Task ResumePdf()
 {
  var json=await JS.InvokeAsync<string?>("sessionStorage.getItem",PendingPdfKey);
  if(json is null || System.Text.Json.JsonSerializer.Deserialize<PendingPdf>(json) is not {} pending)return;
  _busy=true;
  try
  {
   using var http=Clients.CreateClient(ApiClients.Authorized);
   await WaitForPdf(http,pending);
  }
  catch(Exception ex){_error=ex.Message;_pdfFailed=_openedEarly;}
  finally{_busy=false;_receivingPdf=false;_review=_rows.Count>0 || (_openedEarly && _duplicateCount>0);}
  await FinishReviewChecks();
  await LoadHistory();
 }
 void OpenReview(List<OrderDocumentDraft> drafts,string source)
 {
   _reviewIndex=0;_rows=drafts.Select(o=>new Row(o)).ToList();
   _totalExtracted=_rows.Count;
   _reviewBatch=_rows.FirstOrDefault()?.Draft.ImportId;
   _reviewSource=source;
   _removedCount=_duplicateCount=0;
   foreach(var row in _rows)InitializeReviewRow(row);
   if(_rows.Count==0)_error="No orders were found. Check the file or pasted text and try again.";
 }
 List<Row> AppendPdfRows(List<OrderDocumentDraft> drafts)
 {
   var added=new List<Row>();
   foreach(var draft in drafts)
   {
    if(!_seenPdfRows.Add(draft.ImportRowId))continue;
    foreach(var rule in _pdfBatchRules)DocumentMappings.ApplyToMatchingOrder(draft,rule);
    var row=new Row(draft);
    InitializeReviewRow(row);
    added.Add(row);
    _reviewBatch??=draft.ImportId;
   }
   _rows.AddRange(added);
   _totalExtracted+=added.Count;
   return added;
 }
 void InitializeReviewRow(Row row)
 {
    var lines=row.Draft.FreightLines??[];
    foreach(var line in lines)line.CubeFt3??=line.CalculatedCubeFt3;
    if(lines is [var only]){
     only.Pieces=row.Order.Pieces;
     only.WeightLb=row.Order.Weight;
     only.CubeFt3??=row.Order.Cube;
    }else if(lines.Length==0 && (row.Order.Pieces!=0 || row.Order.Weight!=0 || row.Order.Cube!=0))InitializeLine(row);
    row.Draft.NativeStatusId=NativeWorkspace && Statuses.Any(s=>s.Id==NovaDocumentImport.DefaultStatus)?NovaDocumentImport.DefaultStatus:null;
    if(string.IsNullOrWhiteSpace(row.Draft.TagNumber))row.Draft.TagNumber=row.Order.Id;
    row.Order.TerminalId=Terminals.FirstOrDefault(t=>string.Equals(t.Code,row.Order.TerminalCode,StringComparison.OrdinalIgnoreCase))?.Id;
 }
 Task ReviewChecks()=>CheckReviewRows(null);
 async Task CheckReviewRows(Row[]? arriving)
 {
  var version=++_reviewVersion;
  _checking=true;_checkFailed=false;_error=null;
  var rows=(arriving ?? _rows.ToArray()).Where(r=>r.Draft.ExtractionError is null).ToArray();
  StateHasChanged();
  try
  {
   using var http=Clients.CreateClient(ApiClients.Authorized);
   http.Timeout=TimeSpan.FromMinutes(5);
   var existing=await FindExisting(http,rows.Select(MappedPro).Where(id=>id.Length>0).Distinct().ToArray());
   if(version!=_reviewVersion)return;
   if(arriving is null)_existing.Clear();
   _existing.UnionWith(existing);
   var previousCount=_duplicateCount;
   SkipDuplicatePros();
   if(_duplicateCount!=previousCount)await SaveReviewCounts();
   var remaining=_rows.ToHashSet();
   await CheckAddresses(http,rows.Where(remaining.Contains).ToArray(),version);
   if(version==_reviewVersion && !_manuallySelected)SelectReviewRow();
  }
  catch(Exception ex){if(version==_reviewVersion){_checkFailed=true;_error=ex.Message;}}
  finally{if(version==_reviewVersion)_checking=false;}
 }
 static string[] PartyValues(OrderDocumentDraft draft,string part,string[] props)=>
    new[]{draft.AccountId(part)}.Concat(props.Select(p=>GetText(draft.Order,p))).ToArray();
 async Task CheckAddresses(HttpClient http, Row[] rows,int version)
 {
  foreach(var batch in rows.Chunk(100))
  {
   if(version!=_reviewVersion)return;
   var before=batch.Select(r=>NovaImportAddress.Parties.Select(p=>PartyValues(r.Draft,p.Part,p.Properties)).ToArray()).ToArray();
   using var response=await http.PostAsJsonAsync("api/v1/tms/orders/import/addresses",batch.Select(r=>r.Draft).ToArray());
   await ApiResponse.Check(response);
   var found=await response.Content.ReadFromJsonAsync<OrderDocumentDraft[]>();
   if(version!=_reviewVersion)return;
   if(found?.Length!=batch.Length)throw new FormatException("Incomplete address lookup. Retry the checks.");
   for(var i=0;i<batch.Length;i++)
   {
    var draft=batch[i].Draft;
    var messages=new List<string>();
    for(var j=0;j<NovaImportAddress.Parties.Length;j++)
    {
     var (part,label,props)=NovaImportAddress.Parties[j];
     if(draft.EditedAddressParts.Contains(part) || !before[i][j].SequenceEqual(PartyValues(draft,part,props)))continue;
     draft.SetAccountId(part,found[i].AccountId(part));
     foreach(var prop in props)SetText(draft.Order,prop,GetText(found[i].Order,prop));
     messages.AddRange(found[i].AddressLookupMessages.Where(m=>m.StartsWith(label+":",StringComparison.Ordinal)));
    }
    draft.AddressLookupMessages=[..messages,..found[i].AddressLookupMessages.Where(m=>!m.Contains(':'))];
   }
  }
 }
 static async Task<HashSet<string>> FindExisting(HttpClient http,string[] ids)
 {
  var existing=new HashSet<string>();
  foreach(var batch in ids.Chunk(100)){
   using var response=await http.PostAsJsonAsync("api/v1/tms/orders/import/check",batch);
   await ApiResponse.Check(response);
   existing.UnionWith(await response.Content.ReadFromJsonAsync<string[]>()??[]);
  }
  return existing;
 }
 void AddLocationMessages(string pro,IEnumerable<string> messages)
 {
  var parties=new List<string>();
  foreach(var message in messages.Distinct()){
   var party=NovaImportAddress.Parties.FirstOrDefault(p=>message==$"{p.Label}: no unique Nova address match; kept the imported address.");
   if(party.Label is not null){parties.Add(party.Label.ToLowerInvariant());continue;}
   if(NovaImportAddress.Parties.Any(p=>message.StartsWith($"{p.Label}: using the address from Nova account ",StringComparison.Ordinal)))
    _addressNotes.Add((pro,message));
   else _warnings.Add((pro,message));
  }
  if(parties.Count==0)return;
  var names=parties.Count==1 ? parties[0] : string.Join(", ",parties.SkipLast(1))+" and "+parties[^1];
  _addressNotes.Add((pro,$"Used the {names} {(parties.Count==1?"address":"addresses")} from the bill."));
 }
 async Task Create()
 {
  if(_busy || _receivingPdf || _pdfFailed || _checking || _checkFailed)return;
  var pending=IncludedRows.Where(r=>ReviewIssue(r) is null).ToList();
  if(pending.Count==0)return;
  _busy=true;_error=null;_progress="Checking import...";
  Row? attempted=null;
  var creationStarted=false;
  try{
   using var http=Clients.CreateClient(ApiClients.Authorized);
   _existing.UnionWith(await FindExisting(http,pending.Select(MappedPro).Where(pro=>pro.Length>0).ToArray()));
   SkipDuplicatePros();
   pending=IncludedRows.Where(r=>ReviewIssue(r) is null).ToList();
   _progress="Creating orders...";
   int consecutiveUnavailable=0;
   _batchTotal=pending.Count;
   _batchPosition=0;
   foreach(var row in pending){
    if(_existing.Contains(MappedPro(row))){_rows.Remove(row);_duplicateCount++;continue;}
    attempted=row;
    row.Order.Id=row.Draft.TagNumber;
    try{row.Draft.Normalize(allowBlankPro:NativeWorkspace);}catch(FormatException ex){row.RecordClientFailure(ex.Message);continue;}
    var terminal=Terminals.SingleOrDefault(t=>t.Id==row.Order.TerminalId);
    row.Order.TerminalCode=terminal?.Code;
    if(row.Scheduled is {} scheduled){row.Draft.ChangeLocalSchedule(scheduled);row.Order.ScheduledAt=DateTimeOffset.Parse(await JS.InvokeAsync<string>("auroraWorkspace.utc",scheduled.ToString("yyyy-MM-ddTHH:mm:ss")));}
    creationStarted=true;
    _batchPosition++;
    if(_batchPosition==1 || _batchPosition%10==0 || _batchPosition==_batchTotal){_progress=$"Creating order {_batchPosition:N0} of {_batchTotal:N0}";StateHasChanged();}
    using var response=await http.PostAsJsonAsync(NativeWorkspace?"api/v1/aurora/firebird/orders/import":"api/v1/tms/orders/import",row.Draft);
    if(response.StatusCode is System.Net.HttpStatusCode.ServiceUnavailable or System.Net.HttpStatusCode.GatewayTimeout or System.Net.HttpStatusCode.BadGateway)
    {
     try { await ApiResponse.Check(response); }
     catch (FormatException ex) { row.RecordClientFailure(ex.Message); }
     row.CreateError=$"{row.CreateError} Check Orders before retrying.";
     await Task.Delay(500);
     var exists=await FindExisting(http,string.IsNullOrEmpty(row.Order.Id)?[]:[row.Order.Id]);
     if(exists.Count>0){_existing.UnionWith(exists);row.CreateError=$"PRO {row.Order.Id} now exists. Verify it in Orders."; }
     if(++consecutiveUnavailable>=3)throw new FormatException("Three consecutive order requests failed. Check the Nova connection, then resume the remaining orders.");
     continue;
    }
    consecutiveUnavailable=0;
    if(response.StatusCode==System.Net.HttpStatusCode.Conflict &&
       (await response.Content.ReadFromJsonAsync<DuplicateImportPro>())?.Code==DuplicateImportPro.ErrorCode)
    {
     _rows.Remove(row);
     _duplicateCount++;
     _existing.Add(MappedPro(row));
     continue;
    }
    try{await ApiResponse.Check(response);}
    catch(FormatException ex) when(response.StatusCode is System.Net.HttpStatusCode.BadRequest or System.Net.HttpStatusCode.Conflict or System.Net.HttpStatusCode.UnprocessableEntity)
    {row.CreationFailed=true;row.CreateError=ex.Message;continue;}
    if(NativeWorkspace){
     var saved=await response.Content.ReadFromJsonAsync<NovaRecordDocument>();
     row.Order.Id=saved!.OrderKey();
     AddLocationMessages(row.Order.Id,saved.LocationWarnings);
    }
    _createdPros.Add(row.Order.Id);_existing.Add(row.Order.Id);_rows.Remove(row);
   }
   _file=null;_fileVersion++;_text="";
  }catch(Exception ex){if(attempted is not null)
   {
    attempted.CreationFailed=true;
    if(attempted.CreateError is null)
     attempted.RecordClientFailure(ex is FormatException ? ex.Message : "Order request could not be confirmed. Check Orders before retrying.");
   }
   _error=creationStarted
    ?$"{ex.Message} {_saved} orders created; {_rows.Count} remain. If a request lost its connection, check the orders list before retrying."
    :$"{ex.Message} No orders were created in this attempt. {_rows.Count} {(_rows.Count==1?"order remains":"orders remain")} for review.";}
  finally{await SaveReviewCounts();_batchTotal=0;_busy=false;await LoadHistory();if(_saved>0)await OnCreated.InvokeAsync();}
 }
