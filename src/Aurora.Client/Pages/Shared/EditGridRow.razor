<tr class="editable-grid-row" tabindex="@(Disabled ? -1 : 0)" aria-disabled="@Disabled"
    title="@(Disabled ? null : "Double-click to open; press Enter when focused")"
    @ondblclick="Open" @onkeydown="KeyDown">
    @ChildContent
</tr>
@code {
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private Task Open() => Disabled ? Task.CompletedTask : OnEdit.InvokeAsync();
    private Task KeyDown(KeyboardEventArgs e) => e.Key == "Enter" ? Open() : Task.CompletedTask;
}
