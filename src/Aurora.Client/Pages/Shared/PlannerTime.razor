@using System.Globalization
<div class="planner-time planner-time-automatic">
    <label class="field"><span>@Label</span><input type="datetime-local" value="@_local" @onchange="ChangeLocal" /></label>
</div>
@code {
    [Parameter] public string Label { get; set; } = "Date and time";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool AutomaticOffset { get; set; } = true;
    [Parameter] public string DefaultOffset { get; set; } = "";
    private string _local = "", _offset = "", _loaded = "";
    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(_offset)) _offset = DefaultOffset;
        if (Value == _loaded) return; _loaded = Value;
        if (DateTimeOffset.TryParse(Value, CultureInfo.InvariantCulture, DateTimeStyles.None, out var time))
        { _local = time.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture); _offset = time.ToString("zzz", CultureInfo.InvariantCulture); }
        else { _local = ""; _offset = DefaultOffset; }
    }
    private Task ChangeLocal(ChangeEventArgs e) { _local = e.Value?.ToString() ?? ""; return Publish(); }
    private Task Publish()
    {
        if (string.IsNullOrWhiteSpace(_offset) && DateTime.TryParse(_local, out var local))
            _offset = new DateTimeOffset(local).ToString("zzz", CultureInfo.InvariantCulture);
        _loaded = string.IsNullOrWhiteSpace(_local) ? "" : _local + (_local.Length == 16 ? ":00" : "") + _offset.Trim();
        return ValueChanged.InvokeAsync(_loaded);
    }
}
