<AuthorizeView Roles="aurora:Admin,aurora:PowerUser">
    <Authorized>
        @if (!_confirm)
        {
            <button class="outline-button" disabled="@Disabled" @onclick="()=>_confirm=true">Delete @RecordType</button>
        }
        else
        {
            <div class="delete-prompt" role="alert">
                Delete @RecordType <strong>@Name</strong>?
                <button class="outline-button" disabled="@Disabled" @onclick="()=>_confirm=false">Keep @RecordType</button>
                <button class="primary-button" disabled="@Disabled" @onclick="Delete">Confirm delete</button>
            </div>
        }
    </Authorized>
</AuthorizeView>
@code {
    [Parameter] public string RecordType { get; set; } = "record";
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    private bool _confirm;
    private async Task Delete() { await OnDelete.InvokeAsync(); _confirm = false; }
}
