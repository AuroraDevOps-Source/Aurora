@using System.Globalization
@using System.Text.Json.Nodes

@if (IsOpen && Inline)
{
    <div class="inline-appointments">
        <label class="field"><span>Search PRO / destination</span><input @bind="_search" @bind:event="oninput" /></label>
        @if (_error is not null) { <div class="alert" role="alert">@_error</div> }
        @if (_message is not null) { <p role="status">@_message</p> }
        <div class="appointment-list">
        @foreach (var order in _draft?.Deliveries.Where(x => $"{x.Id} {x.Name}".Contains(_search, StringComparison.OrdinalIgnoreCase)) ?? [])
        {
            <div class="appointment-order" @key="order.Id">
                <button class="appointment-toggle setup-row-toggle" aria-expanded="@(_id == order.Id)" @onclick="()=>Toggle(order.Id)"><span>@(_id == order.Id ? "▾" : "▸")</span><strong>@order.Id</strong><span class="row-description">@order.Name</span><span class="row-appointment"><AppointmentDisplay Appointment="order.Appointment" Compact="true" /></span></button>
                @if (_id == order.Id) { <div class="inline-appointment-editor">@Editor</div> }
            </div>
        }
        </div>
    </div>
}
else if (IsOpen)
{
    <div class="modal-backdrop"><section class="variation-modal" role="dialog" aria-modal="true" aria-labelledby="appointments-title">
        <header class="modal-header"><div><span class="eyebrow">PLAN APPOINTMENTS</span><h2 id="appointments-title">Appointments &amp; service time</h2><p>Search a PRO or destination, then edit its appointment. Changes apply to this plan.</p></div><button class="modal-close" aria-label="Close appointments" @onclick="Close">×</button></header>
        <div class="catalog-body">
            @if (_error is not null) { <div class="alert" role="alert">@_error</div> }
            @if (_message is not null) { <p role="status">@_message</p> }
            <div class="catalog-layout"><div><label class="field"><span>Search PRO / destination</span><input @bind="_search" @bind:event="oninput" /></label><div class="manifest-table-wrap catalog-table"><table class="manifest-table"><thead><tr><th>PRO / destination</th><th>Appointment</th><th></th></tr></thead><tbody>
                @foreach (var order in _draft?.Deliveries.Where(x => $"{x.Id} {x.Name}".Contains(_search, StringComparison.OrdinalIgnoreCase)) ?? [])
                { <tr><td><strong>@order.Id</strong><small>@order.Name</small></td><td><AppointmentDisplay Appointment="order.Appointment" /></td><td><button class="text-button" @onclick="() => Select(order.Id)">Edit</button></td></tr> }
            </tbody></table></div></div>
            <div class="catalog-form">
                @if (_id is not null)
                {
                    @Editor
                }
                else { <p>Select an order to edit.</p> }
            </div></div>
        </div><footer class="modal-footer"><span>Appointment changes do not book a delivery or update shipment records.</span><button class="outline-button" @onclick="Close">Done</button></footer>
    </section></div>
}

@code {
    private RenderFragment Editor => @<div class="appointment-fields">
                    <h3>@_id</h3><p class="file-format">Confirmed windows constrain arrival. Existing location opening hours still apply.</p>
                    <PlannerTime Label="Appointment start" @bind-Value="_start" />
                    <PlannerTime Label="Appointment end" @bind-Value="_end" />
                    <label><input type="checkbox" @bind="_confirmed" /> Confirmed appointment</label>
                    <label><input type="checkbox" @bind="_replaceNative" /> Replace imported scheduling windows for this order</label>
                    <p class="file-format">Use this when changing a window built into the file. It removes the current location time restrictions for this order only, including opening hours, before applying the new appointment.</p>
                    <label class="field"><span>Service time (minutes)</span><InputNumber @bind-Value="_service" min="0" max="1440" /></label>
                    <div class="planning-tools"><button class="primary-button" @onclick="() => Save(false)">Apply to plan</button><button class="outline-button" @onclick="() => Save(true)">Clear appointment</button></div><p class="file-format">Clear removes the added appointment. Imported windows remain unless Replace imported scheduling windows is selected.</p>
    </div>;
    [Parameter] public bool Inline { get; set; }
    private void Toggle(string id) { if (_id == id) _id=null; else Select(id); }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string? SourceJson { get; set; }
    [Parameter] public EventCallback<string> OnApply { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private RoutingDraft? _draft;
    private string? _loaded, _id, _error, _message;
    private string _search = "", _start = "", _end = "";
    private bool _confirmed, _replaceNative;
    private double? _service;
    protected override void OnParametersSet()
    {
        if (IsOpen && SourceJson is not null && SourceJson != _loaded) { _loaded = SourceJson; _draft = RoutingDraft.Read(SourceJson); if (_id is not null && !_draft.Deliveries.Any(o=>o.Id==_id)) _id = null; }
    }
    private void Select(string id)
    {
        _id = id; _message = _error = null;
        _replaceNative = false;
        var root = RoutingInput.Parse(SourceJson!);
        var appt = RoutingInput.Appointment(RoutingInput.ReportOrder(root, id));
        _start = RoutingInput.Text(RoutingInput.Get(appt, "blockBegin") ?? RoutingInput.Get(appt, "start")) ?? "";
        _end = RoutingInput.Text(RoutingInput.Get(appt, "blockEnd") ?? RoutingInput.Get(appt, "end")) ?? "";
        _confirmed = appt is not null && RoutingInput.Confirmed(appt) == true;
        var order = RoutingInput.Items(root["orders"]?["deliveries"]).Single(x => RoutingInput.Text(x["id"]) == id);
        _service = order["delivery"]?["duration"]?.GetValue<double>() / 60;
    }
    private async Task Save(bool clear)
    {
        try { var json = PlannerEdits.Appointment(SourceJson!, _id!, _start, _end, _confirmed, _service, clear, _replaceNative); await OnApply.InvokeAsync(json); _message = "Plan updated. Optimize again to calculate the new schedule."; _error = null; }
        catch (Exception ex) { _error = ex.Message; }
    }
    private Task Close() { _id = null; return OnClose.InvokeAsync(); }
}
