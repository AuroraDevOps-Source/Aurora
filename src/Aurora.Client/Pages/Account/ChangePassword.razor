@page "/account/change-password"
@attribute [Authorize]
@inject HttpClient Api

<PageTitle>Change password - Aurora</PageTitle>
<MudContainer MaxWidth="MaxWidth.Small" Class="pa-4">
    <h1>Change your password</h1>
    @if (_saved)
    {
        <p role="status">Your password has been changed.</p>
        <MudButton Href="@ProductWorkspace.RouteFor(ProductWorkspace.Aurora)" Variant="Variant.Filled" Color="Color.Primary">Continue to Aurora</MudButton>
    }
    else
    {
        <p>Enter your current password and choose a new password for your Aurora account.</p>
        @if (_error is not null) { <p class="alert" role="alert">@_error</p> }
        <form @onsubmit="Save" @onsubmit:preventDefault>
            <fieldset disabled="@_busy" class="edit-group">
                <label class="field">Current password<input type="password" @bind="_current" autocomplete="current-password" required /></label>
                <label class="field">New password<input type="password" @bind="_new" autocomplete="new-password" required /></label>
                <label class="field">Confirm new password<input type="password" @bind="_confirm" autocomplete="new-password" required /></label>
                <button type="submit" class="primary-button">@(_busy ? "Changing password…" : "Change password")</button>
            </fieldset>
        </form>
    }
</MudContainer>

@code {
    string _current = "", _new = "", _confirm = "";
    string? _error;
    bool _busy, _saved;
    async Task Save()
    {
        if (_busy) return;
        _error = null;
        if (_new != _confirm) { _error = "The new passwords do not match."; return; }
        _busy = true;
        try
        {
            using var response = await Api.PostAsJsonAsync("api/v1/me/password", new ChangePasswordRequest(_current, _new));
            await ApiResponse.Check(response);
            _current = _new = _confirm = "";
            _saved = true;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
