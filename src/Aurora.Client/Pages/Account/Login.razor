@page "/login"
@layout SignInLayout
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Sign in - Aurora</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="aurora-login">
    <MudPaper Class="aurora-login-card" Elevation="0">
        <div class="aurora-login-brand"><span class="aurora-mark" aria-hidden="true"></span>Aurora</div>
        <div class="aurora-login-body">
        <MudText Typo="Typo.h5" Class="mb-2">Sign in to Aurora</MudText>
        @if (Expired) { <p role="status">Your session has expired. Please sign in again.</p> }
        @if (NovaLaunchFailed) { <p role="status">The Nova launch could not be verified. Click Open Aurora in Nova again, or sign in below.</p> }

        <form id="aurora-login-form" @ref="_loginForm" method="post" action="/api/auth/login"
              autocomplete="on" @onsubmit="SignInAsync" @onsubmit:preventDefault>
        <div class="aurora-login-field">
            <label for="aurora-username">Username</label>
            <input id="aurora-username" name="username" type="text" autocomplete="username"
                   autocapitalize="none" spellcheck="false" required />
        </div>
        <div class="aurora-login-field">
            <label for="aurora-password">@(_invitation is null ? "Password" : "Temporary password from your invitation")</label>
            <input id="aurora-password" name="password" type="password" autocomplete="current-password" required />
        </div>

        @if (_invitation is not null)
        {
            <div class="aurora-login-field">
                <label for="first-password">Choose your new password</label>
                <input id="first-password" type="password" autocomplete="new-password" required @bind="_newPassword" @bind:event="oninput" />
            </div>
            <div class="aurora-login-field">
                <label for="confirm-first-password">Confirm new password</label>
                <input id="confirm-first-password" type="password" autocomplete="new-password" required @bind="_confirmation" @bind:event="oninput" />
            </div>
        }
        @if (_error is not null && _tenants is null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="aurora-sign-in"
                   Disabled="_signingIn" ButtonType="ButtonType.Submit">
            @(_signingIn ? "Signing in…" : "Sign in")
        </MudButton>
        </form>
        <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-4" Color="Color.Secondary">Version @_releaseVersion</MudText>
        </div>
    </MudPaper>
</MudContainer>

@if (_tenants is not null)
{
    <EditPopup Title="Select a tenant" Class="login-tenant-dialog" OnClose="CancelSelection" Busy="_signingIn">
        @if (_error is not null) { <p role="alert">@_error</p> }
        <div class="login-tenant-options">
            @foreach (var tenant in _tenants)
            {
                <button type="button" class="outline-button" aria-pressed="@(_selected == tenant.Id ? "true" : "false")"
                        disabled="@_signingIn" @onclick="() => _selected = tenant.Id">@tenant.Name</button>
            }
        </div>
        <div class="popup-actions">
            <button type="button" class="outline-button" disabled="@_signingIn" @onclick="CancelSelection">Cancel</button>
            <button type="button" class="primary-button" disabled="@(_selected is null || _signingIn)" @onclick="SignInAsync">@(_signingIn ? "Signing in�" : "Continue")</button>
        </div>
    </EditPopup>
}

@code {
    private void CancelSelection()
    {
        _selected = null;
        _tenants = null;
        _error = null;
    }

    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public bool Expired { get; set; }
    [SupplyParameterFromQuery] public bool NovaLaunchFailed { get; set; }
    [SupplyParameterFromQuery] public bool ChangePassword { get; set; }

    private static readonly string _releaseVersion = System.Reflection.CustomAttributeExtensions
        .GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>(typeof(Login).Assembly)
        ?.InformationalVersion ?? "1.0.0";
    private ElementReference _loginForm;
    private string? _error;
    private bool _signingIn;
    private string? _invitation, _activatedPassword;
    private string _newPassword="", _confirmation="";
    protected override void OnInitialized()
    {
        var fragment=new Uri(Navigation.Uri).Fragment;
        if(fragment.StartsWith("#invite=",StringComparison.Ordinal)) _invitation=Uri.UnescapeDataString(fragment[8..]);
    }
    public sealed record TenantOption(Guid Id, string Name);
    private TenantOption[]? _tenants;
    private Guid? _selected;

    private async Task SignInAsync()
    {
        if (_signingIn) return;
        _error = null;
        _signingIn = true;
        StateHasChanged();

        try
        {
            // Read the submitted native form, including password-manager autofill that may
            // not dispatch input/change events. Credentials are never saved in web storage.
            var credentials = await JS.InvokeAsync<LoginCredentials>("auroraLogin.readCredentials", _loginForm);
            if (string.IsNullOrWhiteSpace(credentials.UserName) || string.IsNullOrEmpty(credentials.Password))
            {
                _error = "Enter your username and password.";
                return;
            }
            if (_invitation is not null && _newPassword!=_confirmation)
            {
                _error="Your new passwords do not match.";
                return;
            }
            var client = HttpClientFactory.CreateClient(ApiClients.Anonymous);
            using var request = new HttpRequestMessage(HttpMethod.Post, "/api/auth/login")
            {
                Content = JsonContent.Create(new { credentials.UserName, Password=_activatedPassword ?? credentials.Password, TenantId = _selected, InvitationToken=_invitation, NewPassword=_invitation is null ? null : _newPassword })
            };
            // Cross-origin (different port) — the Set-Cookie response is only honoured if the
            // browser fetch is told to include credentials.
            request.SetBrowserRequestCredentials(BrowserRequestCredentials.Include);

            using var response = await client.SendAsync(request);
            if (response.StatusCode == System.Net.HttpStatusCode.Accepted)
            {
                if(_invitation is not null){_activatedPassword=_newPassword;_invitation=null;_newPassword=_confirmation="";}
                _tenants = await response.Content.ReadFromJsonAsync<TenantOption[]>();
                if (_tenants?.Length == 0) _error = "No active companies are available.";
                return;
            }
            if (!response.IsSuccessStatusCode)
            {
                _selected = null; _tenants = null;
                _error = _invitation is not null && response.StatusCode==System.Net.HttpStatusCode.BadRequest
                    ? (await response.Content.ReadFromJsonAsync<ApiErrorDto>())?.Error
                    : "Check your credentials. For first sign-in, open the link in your invitation email.";
                return;
            }

            // Resume a product's original PKCE request so its state reaches its callback.
            if (AuthenticationNavigation.AuthorizationReturnPath(ReturnUrl) is { } returnTo)
            {
                Navigation.NavigateTo(returnTo, forceLoad: true);
                return;
            }

            // The Aurora.Auth cookie is now set. Hand off to the OIDC flow — it completes
            // silently (the client is registered with ConsentType.Implicit) since that cookie
            // is present, and lands back here via the authentication/login-callback route.
            Navigation.NavigateToLogin("authentication/login", new InteractiveRequestOptions
            {
                Interaction = InteractionType.SignIn,
                ReturnUrl = Navigation.ToAbsoluteUri(ChangePassword ? "/account/change-password" : ProductWorkspace.RouteFor(ProductWorkspace.Aurora)).AbsoluteUri
            });
        }
        catch (HttpRequestException)
        {
            _error = "Could not reach Aurora. Please try again.";
        }
        catch (TaskCanceledException)
        {
            _error = "Sign-in timed out. Please try again.";
        }
        catch (JSException)
        {
            _error = "The sign-in form could not be read. Refresh the page and try again.";
        }
        finally
        {
            _signingIn = false;
        }
    }

    public sealed class LoginCredentials
    {
        public string UserName { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
