@inject HttpClient Http

@if(_error is not null){<p class="alert" role="alert">@_error</p>}
@if(_message is not null){<p role="status">@_message</p>}
<section class="planning-card">
@if(!_editing)
{
    <div class="user-toolbar"><h2>Users</h2><span class="spacer"></span><button class="primary-button" disabled="@_busy" @onclick="New">Add user</button></div>
    <div class="manifest-table-wrap"><table class="manifest-table"><thead><tr><th>Username</th><th>Email</th><th>Level</th><th>Database</th><th></th></tr></thead>
    <tbody>@foreach(var user in _users){<EditGridRow Disabled="@(_busy || !user.CanEdit)" OnEdit="()=>Edit(user)"><td>@user.UserName</td><td>@user.Email</td><td>@user.Level</td><td>@user.DatabaseName</td><td @ondblclick:stopPropagation="true" @onkeydown:stopPropagation="true"><button class="text-button" disabled="@(_busy || !user.CanEdit)" @onclick="()=>SendInvitation(user)">Send invitation</button><button class="text-button" disabled="@(_busy || !user.CanEdit)" @onclick="()=>_delete=user">Delete</button></td></EditGridRow>}</tbody></table></div>
    @if(_delete is not null){<div class="delete-prompt" role="alert">Delete login <strong>@_delete.UserName</strong>? <button class="outline-button" disabled="@_busy" @onclick="()=>_delete=null">Cancel</button><button class="primary-button" disabled="@_busy" @onclick="Delete">Delete user</button></div>}
}
else
{
    <h2>@(_id is null?"Add user":"Edit user")</h2>
    @if (_id is null) { <p>An invitation email will ask this user to sign in and change their password. Provide their initial password separately.</p> }
    <fieldset disabled="@_busy">
        <fieldset class="edit-group"><legend>Account & access</legend><div class="user-fields">
            <label class="field">Username<input id="managed-user-name" name="managed-user-name" @bind="_name" autocomplete="section-managed-user username" data-1p-ignore="true" data-lpignore="true" maxlength="256" /></label>
            <label class="field">Email<input type="email" @bind="_email" maxlength="256" /></label>
            <label class="field">Level<select @bind="_level"><option>Administrator</option><option>Power User</option><option>User</option></select></label>
            <label class="field">@(_id is null?"Login password":"New login password")<input id="managed-user-password" name="managed-user-password" type="password" @bind="_loginPassword" autocomplete="section-managed-user new-password" data-1p-ignore="true" data-lpignore="true" placeholder="@(_id is null?"Required":"Leave blank to keep current")" /></label>
        </div></fieldset>
        <fieldset class="edit-group"><legend>Database</legend><div class="user-fields">
            <label class="field wide">Database<select @bind="_databaseId"><option value="">Select a database</option>@foreach(var database in _databases){<option value="@database.Id">@database.Name (@database.Host)</option>}</select></label>
            <label class="field nova-login-option"><input type="checkbox" @bind="_novaApiLogin" /><span>Allow Nova API sign-in (User level only)</span></label>
            <label class="field">Nova user ID<input @bind="_novaUserId" maxlength="128" placeholder="Leave blank to disable Nova sign-in" /></label>
        </div></fieldset>
        <div class="user-toolbar"><span class="spacer"></span><button class="outline-button" @onclick="Cancel">Cancel</button><button class="primary-button" disabled="@(_databaseId is null)" @onclick="Save">Save</button></div>
    </fieldset>
}
</section>

@code {
    const string Url="api/v1/admin/users";
    AdminUserDto[] _users=[];AdminUserDto? _delete;
    AdminDatabaseDto[] _databases=[];
    Guid? _id,_databaseId;bool _editing,_busy,_novaApiLogin;
    string _name="",_email="",_level="User",_revision="",_loginPassword="",_novaUserId="";
    string? _error,_message;
    protected override async Task OnInitializedAsync()=>await Run(Load);
    async Task Load(){using var response=await Http.GetAsync(Url);await Check(response);_users=(await response.Content.ReadFromJsonAsync<AdminUserDto[]>())??[];using var databases=await Http.GetAsync("api/v1/admin/databases");await Check(databases);_databases=(await databases.Content.ReadFromJsonAsync<AdminDatabaseDto[]>())??[];}
    void New(){_novaApiLogin=false;_id=null;_databaseId=null;_editing=true;_delete=null;_name=_email=_revision=_loginPassword=_novaUserId="";_level="User";_error=_message=null;}
    void Edit(AdminUserDto user){_novaApiLogin=user.NovaApiLogin;_id=user.Id;_name=user.UserName;_email=user.Email;_level=user.Level;_revision=user.Revision;_databaseId=user.DatabaseId;_novaUserId=user.NovaUserId??"";_loginPassword="";_editing=true;_delete=null;_error=_message=null;}
    void Cancel(){_editing=false;_loginPassword="";_error=_message=null;}
    AdminUserEdit Input()=>new(_name,_email,_level,_loginPassword,_revision,_databaseId,_novaUserId,_novaApiLogin);
    async Task Save()=>await Run(async()=>
    {
        var creating=_id is null;
        using var response=creating?await Http.PostAsJsonAsync(Url,Input()):await Http.PutAsJsonAsync($"{Url}/{_id}",Input());
        await Check(response);
        var created=creating?await response.Content.ReadFromJsonAsync<AdminUserCreated>():null;
        _editing=false;_loginPassword="";
        _message=created is null?"User saved.":created.Invitation.Sent?"User created. Invitation email submitted to Resend.":"User created, but the invitation email was not sent. "+created.Invitation.Error;
        await Load();
    });
    async Task SendInvitation(AdminUserDto user)=>await Run(async()=>
    {
        using var response=await Http.PostAsync($"{Url}/{user.Id}/invitation",null);
        await Check(response);
        var result=await response.Content.ReadFromJsonAsync<InvitationEmailResult>();
        if(result?.Sent==true)_message="Invitation email submitted to Resend.";
        else _error=result?.Error??"Invitation email could not be sent.";
    });
    async Task Delete()=>await Run(async()=>{using var response=await Http.DeleteAsync($"{Url}/{_delete!.Id}?revision={Uri.EscapeDataString(_delete.Revision)}");await Check(response);_delete=null;await Load();_message="User deleted.";});
    async Task Run(Func<Task> action){if(_busy)return;_busy=true;_error=_message=null;try{await action();}catch(Exception ex){_error=ex.Message;}finally{_busy=false;}}
    static Task Check(HttpResponseMessage response)=>Aurora.Client.ApiResponse.Check(response);
}
