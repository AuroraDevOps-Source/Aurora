@page "/aurora/document-conversion"
@attribute [Authorize(Roles = "aurora:Admin")]
@inject HttpClient Http
@using System.Text.Json

<PageTitle>Aurora · Shipper Prompts</PageTitle>
<div class="tms-workspace">
 <AuroraSidebar />
 <main class="tms-main">
  <header class="planner-header"><h1>Shipper Prompts</h1></header>
  @if (_settings is null)
  {
   @if (_error is null) { <p role="status">Loading rules…</p> }
   else { <p class="alert" role="alert">@_error</p><button class="outline-button" @onclick="Load">Retry</button> }
  }
  else
  {
   <section class="planning-card">
    <div class="rule-toolbar">
     <h2>Form rules</h2>
     <button class="primary-button" @onclick="() => Open(ActionKind.Add)">Add</button>
    </div>
    <div class="manifest-table-wrap">
     <table class="manifest-table" aria-label="Shipper prompts">
      <thead><tr><th>Issuing company</th><th>Form title</th><th>Account code</th><th aria-label="Actions"></th></tr></thead>
      <tbody>
       @foreach (var rule in _settings.DocumentFormRules ?? [])
       {
        <tr @key="rule" class="prompt-row" @onclick="() => Open(ActionKind.Edit, rule)">
         <td><button type="button" @onclick:stopPropagation="true" class="text-button" @onclick="() => Open(ActionKind.Edit, rule)">@rule.Issuer</button></td>
         <td>@rule.Form</td><td>@rule.Account</td>
         <td><button type="button" class="text-button" aria-label="@($"Delete {rule.Issuer} {rule.Form} {rule.Account}")" @onclick:stopPropagation="true" @onclick="() => Open(ActionKind.Delete, rule)">Delete</button></td>
        </tr>
       }
       @if (_settings.DocumentFormRules is not { Count: > 0 }) { <tr><td colspan="4">No form rules.</td></tr> }
      </tbody>
     </table>
    </div>
    @if (_message is not null) { <p role="status">@_message</p> }
   </section>
  }
 </main>
</div>
@if (_draft is not null)
{
 <EditPopup Title="@DialogTitle" Busy="@_saving" OnClose="Close" Class="settings-dialog">
  @if (_error is not null) { <p class="alert" role="alert">@_error</p> }
   <fieldset disabled="@_saving">
    @if (_action == ActionKind.Delete)
    {
     <p>Delete the form rule for <strong>@_selected?.Issuer</strong>@(string.IsNullOrEmpty(_selected?.Form) ? "" : $" · {_selected.Form}")@(string.IsNullOrEmpty(_selected?.Account) ? "" : $" · {_selected.Account}")?</p>
    }
    else if (_rule is not null)
    {
     <label class="field">Issuing company<input maxlength="160" @bind="_rule.Issuer" /></label>
     <label class="field">Form title (optional)<input maxlength="160" @bind="_rule.Form" /></label>
     <label class="field">Account code (optional)<input maxlength="160" @bind="_rule.Account" /></label>
     <label class="field">Instructions for this form<textarea rows="6" maxlength="4000" @bind="_rule.Instructions"></textarea></label>
     <label><input type="checkbox" @bind="_rule.UsePrintedPro" /> Use a separately labeled PRO when present</label>
    }
   </fieldset>
   <div class="popup-actions">
    <button class="outline-button" disabled="@_saving" @onclick="Close">Cancel</button>
    <button class="primary-button" disabled="@_saving" @onclick="Save">@(_action == ActionKind.Delete ? "Delete rule" : "Save")</button>
   </div>
 </EditPopup>
}

@code {
    const string SettingsUrl = "api/v1/admin/settings";
    enum ActionKind { Add, Edit, Delete }
    TenantSettingsDto? _settings, _draft;
    DocumentFormRule? _selected, _rule;
    ActionKind _action;
    bool _saving;
    string? _error, _message;

    string DialogTitle => _action switch
    {
        ActionKind.Add => "Add form rule",
        ActionKind.Edit => "Edit form rule",
        _ => "Delete form rule"
    };

    protected override Task OnInitializedAsync() => Load();

    async Task Load()
    {
        _error = null;
        try { _settings = await Http.GetFromJsonAsync<TenantSettingsDto>(SettingsUrl) ?? throw new InvalidOperationException("Could not load rules."); }
        catch (Exception ex) { _error = ex.Message; }
    }

    void Open(ActionKind action, DocumentFormRule? selected = null)
    {
        if (_settings is null) return;
        _selected = selected;
        _action = action;
        _error = _message = null;
        _draft = JsonSerializer.Deserialize<TenantSettingsDto>(JsonSerializer.Serialize(_settings))!;
        var rules = _draft.DocumentFormRules ??= [];
        var index = _selected is null ? -1 : _settings.DocumentFormRules!.IndexOf(_selected);
        _rule = index >= 0 ? rules[index] : null;
        if (action == ActionKind.Add) { _rule = new(); rules.Add(_rule); }
        if (action == ActionKind.Delete) { rules.RemoveAt(index); _rule = null; }
    }

    void Close() { _draft = null; _rule = null; _selected = null; _error = null; }

    async Task Save()
    {
        if (_draft is null || _saving) return;
        _saving = true;
        _error = null;
        try
        {
            DocumentFormRule.Validate(_draft.DocumentFormRules!);
            using var response = await Http.PutAsJsonAsync(SettingsUrl, _draft);
            await ApiResponse.Check(response);
            _draft.Revision++;
            _settings = _draft;
            _message = _action == ActionKind.Delete ? "Rule deleted." : "Rule saved.";
            Close();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }
}
