@inject HttpClient Http
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (_error is not null) { <p class="alert" role="alert">@_error</p> }
@if (_adding)
{
    <section class="planning-card">
        <div class="tms-selection"><h2>Add manifest</h2><button class="outline-button" disabled="@_busy" @onclick="()=>_adding=false">Cancel</button><button class="primary-button" disabled="@_busy" @onclick="Create">Save</button></div>
        <fieldset class="edit-group" disabled="@_busy"><legend>Route</legend><div class="tms-filters">
            <label class="field">Origin<select @bind="_origin"><option value="">Select terminal</option>@foreach(var node in _nodes){<option value="@node.Code">@node.Code · @node.Name</option>}</select></label>
            <label class="field">Destination<select @bind="_destination"><option value="">Select terminal</option>@foreach(var node in _nodes){<option value="@node.Code">@node.Code · @node.Name</option>}</select></label>
            <label class="field">Manifest date<InputDate @bind-Value="_manifestDate" /></label>
        </div></fieldset>
    </section>
}
else if (_selected is null)
{
<section class="planning-card">
    <div class="tms-filters">
        <label class="field">Manifest date from<InputDate @bind-Value="_from" /></label>
        <label class="field">Manifest date through<InputDate @bind-Value="_to" /></label>
        <label class="field">Status<select @bind="_status"><option value="">All statuses</option>@foreach(var s in _statuses){<option value="@s.Id">@s.Name</option>}</select></label>
        <label class="field">Search<input @bind="_search" @bind:event="oninput" placeholder="Manifest, terminal, truck, driver" /></label>
        <button class="outline-button" disabled="@_busy" @onclick="Refresh">Apply filters / Refresh</button>
        <button class="text-button" disabled="@_busy" @onclick="Clear">Clear filters</button>
        <button class="primary-button" disabled="@_busy" @onclick="New">Add manifest</button>
    </div>
    <div class="tms-selection"><strong>@Visible.Count() manifests</strong></div>
    @if (_busy) { <p role="status">Loading manifests…</p> }
    <div class="manifest-table-wrap tms-crud-grid"><table class="manifest-table">
        <thead><tr><th>Manifest</th><th>Type</th><th>Created</th><th>Manifest date</th><th>Status</th><th>Terminal</th><th>Truck</th><th>Driver</th><th>Orders</th></tr></thead>
        <tbody>@foreach(var m in Visible){<EditGridRow Disabled="@(_busy)" OnEdit="()=>Open(m)">
            <td><button class="text-button" disabled="@_busy" @onclick="()=>Open(m)" @ondblclick:stopPropagation="true">@m.Id</button></td>
            <td>@(m.ConsolidationCustomer is not null?$"Consolidation · {m.ConsolidationCustomer}":m.IsTransfer?"Line haul":"Delivery") @if(m.ConsolidationHeld){<span class="status-badge">Held</span>} @if(m.OptimizationLocked){<span class="status-badge">Locked</span>}</td>
            <td>@m.CreatedAt?.ToString("MMM d, yyyy h:mm tt")</td><td>@m.ManifestDate?.ToString("MMM d, yyyy")</td>
            <td><span class="status-badge">@m.Status</span></td><td>@m.Terminal</td><td>@Show(m.Truck)</td><td>@Show(m.Driver)</td><td>@m.OrderCount</td>
        </EditGridRow>}</tbody>
    </table></div>
    @if (!_busy && _error is null && !Visible.Any()) { <p>No manifests match these filters.</p> }
</section>
}
@if (_selected is {} selected)
{
    <section class="planning-card" style="margin-top:16px">
        <button class="text-button manifest-back" @onclick="Back" aria-label="Back to manifests">← Back</button>
        <div class="tms-selection"><h2>Manifest · @selected.Id</h2></div>
        <div class="planner-tabs" role="tablist" aria-label="Manifest sections">
            @foreach(var tab in Enum.GetValues<ManifestSection>())
            {
                <button type="button" id="@($"native-manifest-tab-{tab}")" role="tab" aria-selected="@(_section==tab ? "true" : "false")" aria-controls="native-manifest-panel" class="@(_section==tab ? "active" : null)" @onclick="()=>SelectSection(tab)">@tab</button>
            }
        </div>
        <div id="native-manifest-panel" class="@(_section==ManifestSection.Details ? "native-manifest-details" : null)" role="tabpanel" aria-labelledby="@($"native-manifest-tab-{_section}")">
            <div hidden="@(_section==ManifestSection.Orders)">
                <ManifestDispatch ManifestId="selected.Id" ShowHistory="@(_section==ManifestSection.History)" OnSaved="DispatchSaved" @key="selected.Id" />
            </div>
            @if(_section==ManifestSection.Details)
            {
                <div class="planning-card manifest-map-panel">
                    <div id="nova-manifest-map" class="manifest-map" aria-label="Delivery map for manifest @selected.Id"></div>
                    @if (!HasDepot(selected)) { <p class="planning-map-caption">Starting terminal @selected.StartTerminal has no map coordinates.</p> }
                    @if (_orders.Any(o=>!HasCoordinates(o))) { <p class="planning-map-caption">@(_orders.Count(o=>!HasCoordinates(o))) orders have no map coordinates.</p> }
                </div>
            }
            else if(_section==ManifestSection.Orders)
            {
                <div class="manifest-table-wrap"><table class="manifest-table">
                    <thead><tr><th>Sequence</th><th>PRO / Order</th><th>Customer</th><th>Destination</th></tr></thead>
                    <tbody>@foreach(var o in _orders){<tr><td>@o.Sequence</td><td><button class="text-button" @onclick="()=>ViewOrder(o)">@o.Pro</button></td><td>@o.Customer</td><td>@o.Address, @o.City, @o.State @o.PostalCode</td></tr>}</tbody>
                </table></div>
                @if (_orders.Length==0) { <p>No orders on this manifest.</p> }
            }
        </div>
    </section>
}

@if (_viewOrder is {} order)
{
    <dialog @ref="_orderDialog" class="nova-order-dialog" aria-labelledby="nova-order-title">
        <header class="order-heading"><div><span class="order-eyebrow">ORDER DETAILS</span><h2 id="nova-order-title">@order.Pro</h2><p>Manifest @_selected?.Id · Stop @order.Sequence</p></div><span class="status-badge">@order.Status</span><button class="modal-close" aria-label="Close order" @onclick="CloseOrder">×</button></header>
        <div class="order-body">
        <dl class="order-metrics">
            <div><dt>Reference / BOL</dt><dd>@Show(order.Reference)</dd></div>
            <div><dt>Pieces</dt><dd>@Number(order.Pieces)</dd></div><div><dt>Weight (lb)</dt><dd>@Number(order.Weight)</dd></div><div><dt>Cubes</dt><dd>@Number(order.Cube)</dd></div>
        </dl>
        @if(_orderLoading){<p role="status">Loading order details…</p>}
        @if(_orderError is not null){<p class="alert" role="alert">@_orderError</p>}
        @if(_orderDetails is {} detail)
        {
            <div class="order-parties">
            @foreach(var party in detail.Stops)
            {
                <section class="order-card"><h3>@(party.Kind=="P"?"Shipper":party.Kind=="D"?"Consignee":"Stop · "+party.Kind)</h3>
                    <strong>@Show(party.Name)</strong><p>@party.Address<br />@party.City, @party.State @party.PostalCode</p>
                    @if(!string.IsNullOrWhiteSpace(party.Contact)){<p>@party.Contact</p>}
                    @if(!string.IsNullOrWhiteSpace(party.Phone)){<p>@party.Phone</p>}
                    @if(!string.IsNullOrWhiteSpace(party.Email)){<p>@party.Email</p>}
                    @if(party.AppointmentFrom is not null || party.AppointmentTo is not null){<div class="order-appointment"><span>Appointment</span><p>@Time(party.AppointmentFrom) – @Time(party.AppointmentTo)</p></div>}
                    @if(!string.IsNullOrWhiteSpace(party.Notes)){<p class="order-notes">@party.Notes</p>}
                </section>
            }
                <section class="order-card"><h3>Bill to</h3><strong>@Show(detail.BillTo)</strong><p>@detail.BillToAddress</p></section>
                <section class="order-card"><h3>Carrier / Agent</h3>
                    @if(detail.Agents.Length==0 && string.IsNullOrWhiteSpace(detail.CarrierReferences)){<p class="order-empty">Not recorded in Nova</p>}
                    else { @foreach(var agent in detail.Agents){<p>Agent: @agent</p>} @if(!string.IsNullOrWhiteSpace(detail.CarrierReferences)){<p>@detail.CarrierReferences</p>} }
                </section>
            </div>
            <section class="order-card order-section"><h3>References</h3><dl class="order-metrics"><div><dt>Purchase order</dt><dd>@Show(detail.PurchaseOrder)</dd></div><div><dt>Customer order</dt><dd>@Show(detail.CustomerOrder)</dd></div><div><dt>Commodity</dt><dd>@Show(detail.Commodity)</dd></div></dl></section>
            <section class="order-card order-section"><h3>Items &amp; services</h3>
                @if(detail.Items.Length==0){<p class="order-empty">No line items recorded.</p>}
                else{<div class="manifest-table-wrap"><table class="manifest-table"><thead><tr><th>Description</th><th>SKU</th><th>Pieces</th><th>Weight (lb)</th><th>Cubes</th></tr></thead><tbody>@foreach(var item in detail.Items){<tr><td>@item.Description</td><td>@Show(item.Sku)</td><td>@Show(item.Pieces)</td><td>@Show(item.Weight)</td><td>@Show(item.Cube)</td></tr>}</tbody></table></div>}
            </section>
        }
        </div>
        <footer class="modal-footer"><button class="outline-button" @onclick="CloseOrder">Close</button></footer>
    </dialog>
}

@code {
    enum ManifestSection { Details, Orders, History }
    ManifestSection _section;
    async Task SelectSection(ManifestSection section)
    {
        if(_section==section)return;
        await DisposeMap();
        _section=section;
        _renderMap=section==ManifestSection.Details && _selected is not null;
    }

    bool _adding;string _origin="",_destination="";DateOnly _manifestDate=DateOnly.FromDateTime(DateTime.Today);TerminalDto[] _nodes=[];
    async Task New()
    {
        if(_busy)return;_busy=true;_error=null;
        try{using var r=await Http.GetAsync("api/v1/aurora/firebird/terminals");await Check(r);_nodes=await r.Content.ReadFromJsonAsync<TerminalDto[]>()??[];_origin=_destination="";_manifestDate=DateOnly.FromDateTime(DateTime.Today);_adding=true;}
        catch(Exception e){_error=e.Message;}finally{_busy=false;}
    }
    async Task Create()
    {
        if(_busy)return;_busy=true;_error=null;var saved=false;
        try{using var r=await Http.PostAsJsonAsync("api/v1/aurora/firebird/manifests",new NovaManifestCreate(_origin,_destination,_manifestDate));await Check(r);_adding=false;_from=_to=null;_status="1";_search="";saved=true;}
        catch(Exception e){_error=e.Message;}finally{_busy=false;}
        if(saved)await Refresh();
    }
    NovaManifestOrder? _viewOrder;
    NovaOrderDetails? _orderDetails;
    bool _orderLoading;
    string? _orderError;
    ElementReference _orderDialog;
    bool _showOrderDialog;
    IJSObjectReference? _dialogModule;
    DotNetObjectReference<NovaManifests>? _dialogReference;
    static string Number(decimal? value)=>value?.ToString("N0")??"—";
    static string Time(DateTime? value)=>value?.ToString("MMM d, yyyy h:mm tt")??"—";
    async Task ViewOrder(NovaManifestOrder order)
    {
        _viewOrder=order;_showOrderDialog=true;_orderDetails=null;_orderError=null;_orderLoading=true;
        try
        {
            using var response=await Http.GetAsync($"api/v1/aurora/firebird/manifests/{_selected!.Id}/orders/{order.Id}");
            await Check(response);
            var details=await response.Content.ReadFromJsonAsync<NovaOrderDetails>();
            if(ReferenceEquals(_viewOrder,order))_orderDetails=details;
        }
        catch(Exception ex){if(ReferenceEquals(_viewOrder,order))_orderError=ex.Message;}
        finally{if(ReferenceEquals(_viewOrder,order))_orderLoading=false;}
    }
    async Task CloseOrder(){if(_dialogModule is not null)await _dialogModule.InvokeVoidAsync("close",_orderDialog);}
    [JSInvokable] public Task OrderDialogClosed(){_viewOrder=null;return InvokeAsync(StateHasChanged);}
    void DispatchSaved(NovaDispatchDocument d)
    {
        if (_selected is not {} m) return;
        m.Status=d.Status; m.Driver=d.Drivers.FirstOrDefault(x=>x.Id==d.DriverId)?.Name??"";
        m.OptimizationLocked=d.OptimizationLocked;
        m.Truck=d.Trucks.FirstOrDefault(x=>x.Id==d.TruckId)?.Name??"";
    }
    DateOnly? _from, _to;
    string _status="", _search="";
    bool _busy;
    bool _renderMap, _mapShown;
    string? _error;
    NovaManifest[] _manifests=[];
    NovaManifestStatus[] _statuses=[new(1,"Unassigned")];
    NovaManifest? _selected;
    NovaManifestOrder[] _orders=[];
    IEnumerable<NovaManifest> Visible=>_manifests.Where(m=>string.Join(" ",m.Id,m.Terminal,m.Truck,m.Driver).Contains(_search,StringComparison.OrdinalIgnoreCase));
    static string Show(string? value)=>string.IsNullOrWhiteSpace(value)?"—":value;
    [Parameter] public string? EditId {get;set;}
    protected override async Task OnInitializedAsync()
    {
        await Load(true);
        if(!long.TryParse(EditId,out var id))return;
        try
        {
            using var response=await Http.GetAsync($"api/v1/aurora/firebird/manifests/{id}");
            await Check(response);
            var manifest=(await response.Content.ReadFromJsonAsync<NovaManifest>())!;
            await Open(manifest);
        }
        catch(Exception ex){_error=ex.Message;}
    }
    Task Refresh()=>Load(false);
    async Task Clear(){_from=_to=null;_status=_search="";await Load(false);}
    async Task Load(bool initial)
    {
        if(_busy)return;
        _busy=true;_error=null;_selected=null;_orders=[];_manifests=[];
        try
        {
            var url=$"api/v1/aurora/firebird/manifests?allDates={(!initial).ToString().ToLowerInvariant()}";
            url+="&manifestDates=true";
            if(_from is {} from)url+=$"&from={from:yyyy-MM-dd}";
            if(_to is {} to)url+=$"&to={to:yyyy-MM-dd}";
            if(_status.Length>0)url+=$"&status={Uri.EscapeDataString(_status)}";
            using var response=await Http.GetAsync(url);
            await Check(response);
            var result=(await response.Content.ReadFromJsonAsync<NovaManifestList>())!;
            _manifests=result.Manifests;_statuses=result.Statuses;
            if(initial)_from=_to=result.Today;
        }
        catch(Exception ex){_error=ex.Message;}
        finally{_busy=false;}
    }
    async Task Open(NovaManifest manifest)
    {
        await DisposeMap();
        _busy=true;_error=null;_selected=null;_orders=[];
        try
        {
            using var response=await Http.GetAsync($"api/v1/aurora/firebird/manifests/{manifest.Id}/orders");
            await Check(response);
            _orders=await response.Content.ReadFromJsonAsync<NovaManifestOrder[]>()??[];
            _selected=manifest;
            _section=ManifestSection.Details;
            _renderMap=true;
        }
        catch(Exception ex){_error=ex.Message;}
        finally{_busy=false;}
    }
    static bool HasCoordinates(NovaManifestOrder o)=>o.Latitude is >= -90 and <= 90 && o.Longitude is >= -180 and <= 180 && (o.Latitude!=0 || o.Longitude!=0);
    static bool HasDepot(NovaManifest m)=>m.DepotLatitude is >= -90 and <= 90 && m.DepotLongitude is >= -180 and <= 180 && (m.DepotLatitude!=0 || m.DepotLongitude!=0);
    object[] MapStops(NovaManifest manifest)
    {
        var stops=new List<object>();
        if(HasDepot(manifest))stops.Add(new {lat=manifest.DepotLatitude,lon=manifest.DepotLongitude,sequence=0,locationId=$"Starting terminal · {manifest.StartTerminal}",isDepot=true,orderIds=Array.Empty<string>(),arrival="—",departure="—"});
        if (manifest.IsTransfer)
        {
            if (manifest.EndLatitude is >= -90 and <= 90 && manifest.EndLongitude is >= -180 and <= 180 && (manifest.EndLatitude!=0 || manifest.EndLongitude!=0))
                stops.Add(new {lat=manifest.EndLatitude,lon=manifest.EndLongitude,sequence=1,locationId=$"Receiving terminal · {manifest.EndTerminal}",isDepot=false,orderIds=_orders.Select(o=>o.Pro).ToArray(),arrival="—",departure="—"});
        }
        else stops.AddRange(_orders.Where(HasCoordinates).Select(o=>(object)new {lat=o.Latitude,lon=o.Longitude,sequence=o.Sequence,locationId=o.Customer,isDepot=false,orderIds=new[]{o.Pro},arrival="—",departure="—"}));
        return stops.ToArray();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(_showOrderDialog)
        {
            _showOrderDialog=false;
            _dialogModule??=await JS.InvokeAsync<IJSObjectReference>("import","./js/order-dialog.js");
            _dialogReference??=DotNetObjectReference.Create(this);
            await _dialogModule.InvokeVoidAsync("open",_orderDialog,_dialogReference);
        }
        if(!_renderMap || _selected is null || _section!=ManifestSection.Details)return;
        _renderMap=false;_mapShown=true;
        try
        {
            await JS.InvokeVoidAsync("routeMap.render","nova-manifest-map",new {
                routes=new[]{new {vehicle=$"Manifest {_selected.Id}",color="#2363eb",stops=MapStops(_selected)}},dropped=Array.Empty<object>()
            });
        }
        catch(JSException){_error="The map could not load. Return to the list and reopen this manifest to retry.";StateHasChanged();}
    }
    async Task Back(){await DisposeMap();await Refresh();}
    async Task DisposeMap()
    {
        _renderMap=false;
        if(!_mapShown)return;
        _mapShown=false;
        try{await JS.InvokeVoidAsync("routeMap.dispose");}catch(JSDisconnectedException){}
    }
    public async ValueTask DisposeAsync()
    {
        await DisposeMap();
        if(_dialogModule is not null)await _dialogModule.DisposeAsync();
        _dialogReference?.Dispose();
    }
    static async Task Check(HttpResponseMessage response)
    {
        if(!response.IsSuccessStatusCode)throw new FormatException((await response.Content.ReadFromJsonAsync<ApiErrorDto>())?.Error??"Could not load Nova manifests.");
    }
}
