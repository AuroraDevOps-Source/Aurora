@page "/data-entry"
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>Data Entry · Aurora</PageTitle>
<main class="tms-main data-entry-page">
    <header class="planner-header"><h1>Data Entry</h1></header>
    <section class="data-entry-content">
        @if (_error is not null)
        {
            <p class="alert" role="alert">@_error</p>
            <button class="outline-button" @onclick="Load">Retry</button>
        }
        else if (_loading)
        {
            <p role="status">Loading workspace…</p>
        }
        else
        {
            <OrderDocumentImportDialog Terminals="_terminals" NativeWorkspace="@(!_local)" Statuses="_statuses" ImportBatch="ImportBatch" OrderPro="@OrderPro" />
        }
    </section>
</main>
@code {
    [SupplyParameterFromQuery(Name="import")] public Guid? ImportBatch {get;set;}
    [SupplyParameterFromQuery(Name="order")] public string? OrderPro {get;set;}
    bool _loading = true, _local;
    string? _error;
    List<TerminalDto> _terminals = [];
    NovaManifestStatus[] _statuses=[];

    protected override Task OnInitializedAsync() => Load();

    async Task Load()
    {
        _loading = true;
        _error = null;
        try
        {
            var mode = await Http.GetFromJsonAsync<WorkspaceMode>("api/v1/synchronization/mode")
                ?? throw new HttpRequestException("Workspace mode was unavailable.");
            _local = mode.Local;
            if (_local)
                _terminals = await Http.GetFromJsonAsync<List<TerminalDto>>("api/v1/tms/terminals") ?? [];
            else
            {
                var options = await Http.GetFromJsonAsync<NovaRecordOptions>("api/v1/aurora/firebird/record-options")
                    ?? throw new HttpRequestException("Terminal options were unavailable.");
                _statuses=options.Statuses;
                // Choice IDs are UI-only; the native endpoint validates the terminal code.
                _terminals = options.Terminals.Select(code => new TerminalDto
                {
                    Id = Guid.NewGuid(), Code = code,
                    Name = options.TerminalNames.GetValueOrDefault(code) ?? code
                }).ToList();
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            _error = "Data Entry could not be loaded. Please retry.";
        }
        finally { _loading = false; }
    }
}
