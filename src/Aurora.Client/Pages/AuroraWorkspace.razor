@page "/aurora/{WorkspaceView}"
@attribute [Authorize]
<PageTitle>Aurora · @Title</PageTitle>
<div class="tms-workspace @(WorkspaceView == "route-optimization" ? "tms-route-setup" : null)">
 <AuroraSidebar />
 <main class="tms-main"><header class="planner-header"><h1>@Title</h1></header>
 @if(WorkspaceView=="route-optimization"){<RouteOptimizationSetup />}
 else if(WorkspaceView=="fleet"){<NovaRecords Kind="fleet" @key="WorkspaceView" />}
 else if(WorkspaceView=="manifests"){<NovaManifests />}
 else if(WorkspaceView=="terminals"){<NovaMasters Kind="terminals" @key="WorkspaceView" />}
 else if(WorkspaceView=="customers"){<NovaMasters Kind="customers" @key="WorkspaceView" />}
 else if(WorkspaceView=="users"){<AuthorizeView Roles="aurora:Admin"><Authorized><UserAdministration /></Authorized><NotAuthorized><p role="alert">Administrator access is required.</p></NotAuthorized></AuthorizeView>}
 else if(WorkspaceView is "ship-status" or "configuration"){<AuthorizeView Roles="aurora:Admin"><Authorized><RoutingConfiguration /></Authorized><NotAuthorized><p role="alert">A company administrator is required to manage ship statuses.</p></NotAuthorized></AuthorizeView>}
 else if(WorkspaceView=="import"){<AuthorizeView Roles="aurora:Admin"><Authorized><WorkspaceImportPage /></Authorized><NotAuthorized><p role="alert">A company administrator is required to replace company data.</p></NotAuthorized></AuthorizeView>}
 else {<NovaRecords Kind="orders" @key="WorkspaceView" />}
 </main>
</div>
@code {
 [Parameter] public string WorkspaceView {get;set;}="orders";
 string Title=>WorkspaceView=="route-optimization"?"Optimization":WorkspaceView=="fleet"?"Fleet Management":WorkspaceView=="manifests"?"Manifest":WorkspaceView=="terminals"?"Transportation Nodes":WorkspaceView=="customers"?"Customers":WorkspaceView=="users"?"Users":WorkspaceView is "ship-status" or "configuration"?"Ship Status":WorkspaceView=="import"?"Import":"Orders";
}
