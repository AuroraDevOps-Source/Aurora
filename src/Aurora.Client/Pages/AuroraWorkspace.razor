@page "/aurora/{WorkspaceView}"
@attribute [Authorize]
<PageTitle>Aurora · @Title</PageTitle>
<div class="tms-workspace @(WorkspaceView == "route-optimization" ? "tms-route-setup" : null)">
 <AuroraSidebar />
 <main class="tms-main"><header class="planner-header"><h1>@Title</h1></header>
 @if(WorkspaceView=="route-optimization"){<RouteOptimizationSetup />}
 else if(WorkspaceView=="fleet"){<FleetManagement />}
 else if(WorkspaceView=="manifests"){<TmsManifests />}
 else if(WorkspaceView=="terminals"){<Terminals />}
 else if(WorkspaceView=="customers"){<Customers />}
 else if(WorkspaceView=="import"){<AuthorizeView Roles="aurora:Admin"><Authorized><WorkspaceImportPage /></Authorized><NotAuthorized><p role="alert">A company administrator is required to replace company data.</p></NotAuthorized></AuthorizeView>}
 else {<TmsOrders />}
 </main>
</div>
@code {
 [Parameter] public string WorkspaceView {get;set;}="orders";
 string Title=>WorkspaceView=="route-optimization"?"Route Optimization":WorkspaceView=="fleet"?"Fleet Management":WorkspaceView=="manifests"?"Manifest":WorkspaceView=="terminals"?"Transportation Nodes":WorkspaceView=="customers"?"Customers":WorkspaceView=="import"?"Import":"Orders";
}
