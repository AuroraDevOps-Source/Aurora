@page "/aurora/{WorkspaceView}"
@attribute [Authorize]
@inject HttpClient Http
<PageTitle>Aurora · @Title</PageTitle>
<div class="tms-workspace">
 <aside class="tms-sidebar"><h2>Aurora</h2><p>@(_company?.Name ?? "Your company")</p><NavLink href="aurora/orders">Orders</NavLink><NavLink href="aurora/manifests">Manifest</NavLink><NavLink href="aurora/fleet">Fleet Management</NavLink></aside>
 <main class="tms-main"><header class="planner-header"><h1>@Title</h1></header>
 @if(WorkspaceView=="fleet"){<FleetManagement />}
 else if(WorkspaceView=="manifests"){<TmsManifests />}
 else {<TmsOrders />}
 </main>
</div>
@code {
 [Parameter] public string WorkspaceView {get;set;}="orders";
 string Title=>WorkspaceView=="fleet"?"Fleet Management":WorkspaceView=="manifests"?"Manifest":"Orders";
 WorkspaceTenantDto? _company;
 protected override async Task OnInitializedAsync(){_company=await Http.GetFromJsonAsync<WorkspaceTenantDto>("api/v1/me/tenant");}
}
